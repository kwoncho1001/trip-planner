t":31.48,"lng":103.59,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"쓰촨","city":"첸웨이","local":"犍为 / Qianwei","kind":"소도시","desc":"유채꽃 만발한 언덕을 달리는 100년 역사의 협궤 증기기관차 자양 샤오훠처와 잘 보존된 고대 문묘가 유명하다.","known_for":["자양 증기기관차(샤오훠처)","첸웨이 문묘","바자오거우 옛거리","유채꽃 협궤철도"],"lat":29.21,"lng":103.95,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"윈난","city":"쿤밍","local":"昆明 / Kunming","kind":"대도시","desc":"사계절 내내 꽃이 피고 온화해 '봄의 도시(춘성)'라 불리는 윈난성의 성도. 뎬츠 호수와 취호공원, 다채로운 소수민족 문화의 관문이다.","known_for":["뎬츠 호수","취호공원","관두 고진","윈난 민속촌","과교미선"],"lat":25.04,"lng":102.71,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"윈난","city":"석림","local":"石林 / Shilin","kind":"자연지역","desc":"수억 년 전 바다가 융기해 침식되면서 형성된 장엄한 카르스트 돌기둥 숲으로 사니족의 아스마 전설이 깃든 세계자연유산.","known_for":["석림 풍경구","대석림","소석림","사니족 문화"],"lat":24.76,"lng":103.27,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"윈난","city":"다리","local":"大理 / Dali","kind":"소도시","desc":"고대 남조국과 대리국의 수도였던 바이족의 터전. 푸른 얼하이 호수와 웅장한 창산(점창산), 숭성사 삼탑으로 유명하다.","known_for":["대리고성","얼하이 호수","숭성사 삼탑","창산","솽랑"],"lat":25.68,"lng":100.3,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"윈난","city":"사시","local":"沙溪 / Shaxi","kind":"마을","desc":"차마고도에서 유일하게 원형을 온전히 간직한 고대 장터 마을(시지제). 고즈넉한 옥진교와 흙벽돌 고택이 시간 여행을 선사한다.","known_for":["사시 고진","시지제 장터","옥진교","흥교사","차마고도"],"lat":26.32,"lng":99.85,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"윈난","city":"웨이산","local":"巍山 / Weishan","kind":"소도시","desc":"남조국의 발원지이자 원·명·청대의 격자형 목조 가옥 구조가 그대로 보존된 한적하고 평화로운 이족·후이족 문화 고성.","known_for":["웨이산 고성","공진루","웨이바오산 도교사원","일근면"],"lat":25.23,"lng":100.31,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"윈난","city":"리장","local":"丽江 / Lijiang","kind":"소도시","desc":"만년설이 덮인 옥룡설산 아래 수로망이 그물처럼 얽힌 나시족의 유네스코 세계문화유산 고성(다옌진).","known_for":["리장 고성","옥룡설산","수허 고진","흑룡담공원","동파 문자"],"lat":26.88,"lng":100.22,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"윈난","city":"호도협","local":"虎跳峡 / Tiger Leaping Gorge","kind":"자연지역","desc":"옥룡설산과 합파설산 사이를 금사강이 가르고 흐르는 세계적 협곡. 세계 3대 트레킹 코스 중 하나로 꼽힌다.","known_for":["상호도","중호도","티나스 게스트하우스","협곡 트레킹"],"lat":27.24,"lng":100.13,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"윈난","city":"샹그릴라","local":"香格里拉 / Shangrila","kind":"소도시","desc":"티베트어로 '마음속의 해와 달'을 뜻하는 디칭 티베트 자치주의 중심지. 쑹짠린 사원과 두커종 고성, 나파하이 고원 호수가 있다.","known_for":["쑹짠린 사원","두커종 고성","푸다춰 국립공원","나파하이"],"lat":27.83,"lng":99.7,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"윈난","city":"더친","local":"德钦 / Deqin","kind":"소도시","desc":"티베트 불교 8대 성산 중 으뜸인 매리설산(카와거보봉, 6740m)을 마주하는 해발 3400m의 고원 산악 도시.","known_for":["매리설산","비래사 일출","란창강 대협곡","카와거보봉"],"lat":28.2,"lng":98.98,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"윈난","city":"위벙","local":"雨崩 / Yubeng","kind":"마을","desc":"매리설산 기슭 깊숙이 자리 잡아 도보나 당나귀로만 접근 가능한 세외도원 티베트 마을. 빙호와 신폭 트레킹으로 유명하다.","known_for":["상위벙","하위벙","빙호 트레킹","신폭","매리설산 기슭"],"lat":28.39,"lng":98.79,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"윈난","city":"징훙","local":"景洪 / Jinghong","kind":"중소도시","desc":"시솽반나 다이족 자치주의 주도로 동남아 분위기가 물씬 나는 열대 기후 도시. 란창강 야시장과 불교 사원, 발수절 축제가 열린다.","known_for":["가오좡 시솽징 야시장","만팅공원","총불사","발수절","다이족 바비큐"],"lat":22.01,"lng":100.79,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"윈난","city":"멍라","local":"勐腊 / Mengla","kind":"소도시","desc":"라오스 국경에 인접한 열대우림 지역으로 거대한 망천수 나무 사이를 걷는 공중 캐노피 산책로와 중국과학원 열대식물원이 있다.","known_for":["망천수 열대우림","중국과학원 시솽반나 열대식물원","라오스 국경","캐노피 워크"],"lat":21.48,"lng":101.56,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"윈난","city":"푸얼","local":"普洱 / Pu'er","kind":"중소도시","desc":"세계적으로 유명한 발효차 '보이차'의 집산지이자 발원지. 끝없이 펼쳐진 만무 차밭과 고대 차마고도 역참 유적이 남아 있다.","known_for":["보이차","만무 고차수림","태양하 삼림공원","차마고도 유적"],"lat":22.79,"lng":100.97,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"윈난","city":"젠수이","local":"建水 / Jianshui","kind":"소도시","desc":"윈난 남부의 유교 문화 중심지로 중국 제2의 문묘인 젠수이 문묘, 청나라 정원 장가화원, 쌍룡교(십칠공교)가 있다.","known_for":["젠수이 문묘","조양루","장가화원","쌍룡교","젠수이 자도"],"lat":23.62,"lng":102.83,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"윈난","city":"위안양","local":"元阳 / Yuanyang","kind":"소도시","desc":"하니족이 1300년에 걸쳐 애뢰산 비탈에 깎아 만든 수만 개의 다락논이 물안개와 함께 장관을 이루는 유네스코 세계문화유산.","known_for":["하니 다락논","다위수 일출","바다 일몰","애뢰산 운해"],"lat":23.22,"lng":102.83,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"윈난","city":"멍쯔","local":"蒙自 / Mengzi","kind":"중소도시","desc":"훙허 하니족 이족 자치주의 주도이자 윈난 대표 요리 과교미선의 발원지. 프랑스 조계지의 흔적이 남은 벽색채(비써자이) 기차역이 있다.","known_for":["과교미선(다리건너 쌀국수)","비써자이 기차역","남호 공원","석류원"],"lat":23.37,"lng":103.38,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"윈난","city":"미러","local":"弥勒 / Mile","kind":"소도시","desc":"붉은 벽돌로 빚은 초현실주의 예술 마을 둥펑윈과 유황 온천, 포도주 와이너리가 어우러진 윈난 남부의 휴양 소도시.","known_for":["둥펑윈 예술마을","미러 천연온천","금병산 미륵사","와이너리"],"lat":24.41,"lng":103.44,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"윈난","city":"허커우","local":"河口 / Hekou","kind":"소도시","desc":"홍강(남계하) 다리 하나를 사이에 두고 베트남 라오까이와 국경을 맞댄 국경 관문 도시로 동남아 국경 무역이 활발하다.","known_for":["중월 철교 국경","라오까이 대안","홍강 열대 풍경","국경 시장"],"lat":22.51,"lng":103.96,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"윈난","city":"텅충","local":"腾冲 / Tengchong","kind":"소도시","desc":"99개의 화산과 88곳의 온천이 밀집한 화산 지열 지대로 명청대 화교 고택 마을 허순 고진과 은행나무 마을이 유명하다.","known_for":["열해 온천(열해대곤)","화산지질공원","허순 고진","은행촌"],"lat":25.02,"lng":98.49,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"윈난","city":"루이리","local":"瑞丽 / Ruili","kind":"소도시","desc":"미얀마와 국경선을 공유하는 도시로 아시아 최대급 비취 옥석 시장과 한 마을이 두 나라에 걸친 은정(일채양국)이 있다.","known_for":["일채양국","비취 옥석 시장","제러 대금탑","미얀마 국경 관문"],"lat":24.01,"lng":97.86,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"윈난","city":"망시","local":"芒市 / Mangshi","kind":"중소도시","desc":"더훙 다이족 징포족 자치주의 주도로 언덕 위에 황금빛으로 빛나는 맹환대금탑과 은탑, 야자수가 늘어선 이국적인 열대 거리.","known_for":["맹환대금탑","맹환은탑","다이족 야시장","보리사"],"lat":24.44,"lng":98.59,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"윈난","city":"바오산","local":"保山 / Baoshan","kind":"중소도시","desc":"한나라 고대 애뢰국의 중심지이자 노강(누강) 협곡의 진입 관문. 중국 최고급 아라비카 원두 산지인 노강 소립커피로 유명하다.","known_for":["태보산 공원","노강 소립커피","애뢰산맥","고대 비단길"],"lat":25.12,"lng":99.16,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"윈난","city":"빙중뤄","local":"丙中洛 / Bingzhongluo","kind":"마을","desc":"노강이 굽이쳐 돌아나가는 '노강 제1만' 절벽 위에 세워진 마을. 티베트족·리스족·누족과 가톨릭·티베트불교가 공존하는 무릉도원.","known_for":["노강 제1만","중딩 가톨릭성당","추나퉁 마을","천인절벽 잔도"],"lat":28.02,"lng":98.57,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"윈난","city":"푸저헤이","local":"普者黑 / Puzhehei","kind":"자연지역","desc":"카르스트 봉우리들 사이로 수만 에이커의 연꽃 호수와 천연 동굴이 펼쳐진 곳으로 이족 전통 마을과 물싸움 뱃놀이가 명물이다.","known_for":["푸저헤이 연꽃 호수","선인동 마을","청룡산 조망","카르스트 동굴군"],"lat":24.11,"lng":104.12,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"윈난","city":"뤄핑","local":"罗平 / Luoping","kind":"소도시","desc":"이른 봄 수십만 에이커의 유채꽃이 황금빛 바다를 이루는 카르스트 평원. 뾰족한 원뿔형 봉우리 금계봉림과 구룡폭포군이 있다.","known_for":["금계봉림 유채꽃","구룡폭포","다오이하 계곡","부이족 문화"],"lat":24.88,"lng":104.31,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"윈난","city":"취징","local":"曲靖 / Qujing","kind":"중소도시","desc":"중국 남부 주강의 발원지이자 윈난 제2의 도시. 찬란한찬찬선 고원 초원과 천연 카르스트 협곡 요산 풍경구가 자리한다.","known_for":["주강 발원지","대해초원","요산 풍경구","찬찬선 문화"],"lat":25.49,"lng":103.8,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"윈난","city":"위시","local":"玉溪 / Yuxi","kind":"중소도시","desc":"중국 국가 '의용군 행진곡' 작곡가 녜얼의 고향이자 윈난성 최고의 담배 잎 산지로 푸셴호 남부와 애뢰산 원시림을 품고 있다.","known_for":["녜얼 기념관","홍탑산","애뢰산 원시림","기루호"],"lat":24.35,"lng":102.54,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"윈난","city":"청장","local":"澄江 / Chengjiang","kind":"소도시","desc":"투명도가 8m에 달하는 깊고 푸른 담수호 푸셴호 북안의 도시이자 5억 3천만 년 전 캄브리아기 화석이 발굴된 세계자연유산의 도시.","known_for":["푸셴호(복선호)","청장 화석 유적지","월량만 습지공원","은어 요리"],"lat":24.67,"lng":102.91,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"윈난","city":"추슝","local":"楚雄 / Chuxiong","kind":"중소도시","desc":"쿤밍과 다리 사이에 자리한 추슝 이족 자치주의 주도로 이족 십월태양력 문화원과 전통 누각 양식의 이인고진이 조성되어 있다.","known_for":["이인고진","이족 십월태양력 문화원","복탑공원","야생 버섯 요리"],"lat":25.03,"lng":101.54,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"윈난","city":"위안머우","local":"元谋 / Yuanmou","kind":"소도시","desc":"170만 년 전 원모원인 화석이 출토된 고인류 발상지이자 수백만 년의 풍화로 빚어진 웅장한 흙기둥 협곡 '위안머우 토림'이 있는 곳.","known_for":["위안머우 토림(물무 토림)","랑파과 토림","원모원인 박물관","금사강 계곡"],"lat":25.7,"lng":101.87,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"윈난","city":"자오퉁","local":"昭通 / Zhaotong","kind":"중소도시","desc":"윈난 북동부 고원 지대로 세계적인 희귀 조류 검은목두루미가 월동하는 대산포 습지와 아찔한 협곡 마을 두진향이 있다.","known_for":["대산포 국립자연보호구","검은목두루미","황련하 폭포군","두진향 협곡"],"lat":27.34,"lng":103.72,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"윈난","city":"린창","local":"临沧 / Lincang","kind":"중소도시","desc":"란창강 중류에 위치한 윈난 명품 홍차 디안홍의 발원지이자 3200년 된 최고령 재배형 야생 차나무가 서식하는 차의 고장.","known_for":["디안홍 홍차","향죽청 고차수","란창강 협곡","와족 문화"],"lat":23.88,"lng":100.08,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"윈난","city":"창위안","local":"沧源 / Cangyuan","kind":"소도시","desc":"중국 최대의 와족 집거지로 초가지붕과 나무말뚝으로 이뤄진 마지막 원시 부족 마을 웡딩 와채와 선사시대 암각화가 있다.","known_for":["웡딩 원시 와채","창위안 애화(암화)","사강림 자연보호구","와족 모니헤이 축제"],"lat":23.15,"lng":99.25,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"산시","city":"시안","local":"西安 / Xi'an","kind":"대도시","desc":"주·진·한·당 등 13개 왕조의 수도였던 실크로드의 시발점. 병마용갱과 완벽히 보존된 고대 성벽, 회민가 야시장으로 유명하다.","known_for":["진시황릉 병마용","시안 성벽","대안탑","회민가","종루"],"lat":34.34,"lng":108.94,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"산시","city":"셴양","local":"咸阳 / Xianyang","kind":"중소도시","desc":"진시황이 중국을 최초로 통일하고 수도로 삼았던 역사 도시로 시안 바로 북서쪽에 접해 있다. 한나라 무덤인 한양릉과 무측천의 건릉이 가깝다.","known_for":["진함양궁 유적","한양릉 박물관","건릉","양귀비 묘"],"lat":34.33,"lng":108.71,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"산시","city":"바오지","local":"宝鸡 / Baoji","kind":"중소도시","desc":"주나라와 진나라의 발원지로 고대 청동기 유물이 대거 출토되어 청동기의 고향으로 불린다. 석가모니 진신지골 사리를 모신 법문사가 위치해 있다.","known_for":["법문사","중국 청동기박물관","태백산 국가삼림공원","관산 초원"],"lat":34.36,"lng":107.14,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"산시","city":"옌안","local":"延安 / Yan'an","kind":"중소도시","desc":"중국 공산당 홍군의 대장정 종착지이자 1937년부터 10여 년간 혁명 중심지였던 황토고원의 도시. 황토 언덕 위의 보탑산과 조원 혁명구지가 있다.","known_for":["보탑산","조원 혁명구지","양가령","황토고원 풍경"],"lat":36.59,"lng":109.49,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"산시","city":"한중","local":"汉中 / Hanzhong","kind":"중소도시","desc":"진령산맥 남쪽 한강 유역에 자리한 분지 도시로 한나라 명칭의 기원이자 삼국지 촉한의 북벌 전진기지였다. 제갈량이 묻힌 무후묘와 고대 잔도가 남아 있다.","known_for":["고한대","석문잔도","면현 무후묘","유채꽃 축제"],"lat":33.07,"lng":107.03,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"산시","city":"위린 (산시)","local":"榆林 / Yulin","kind":"중소도시","desc":"산시성 최북단 무우스 사막 경계에 위치한 명나라 만리장성의 군사 요충지. 장성 3대 누각 중 하나인 진북대와 붉은 사암 절벽의 홍석협이 있다.","known_for":["진북대","홍석협","위린 고성","바이윈산"],"lat":38.29,"lng":109.73,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"산시","city":"웨이난","local":"渭南 / Weinan","kind":"중소도시","desc":"관중평원 동부의 교통 요충지이자 춘추시대 진나라의 거점. 중국 5대 악산 중 하나인 서악 화산(华山)의 관문 도시다.","known_for":["화산","서악묘","화산 잔도","웨이허 강변"],"lat":34.5,"lng":109.51,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"산시","city":"한청","local":"韩城 / Hancheng","kind":"소도시","desc":"사기를 저술한 사마천의 고향으로 황하 서안에 위치한 역사문화명성. 명·청 시대 전통 사합원 고택이 원형 그대로 보존된 당가촌이 유명하다.","known_for":["사마천 사당 및 묘","당가촌","한청 고성","황하 풍경"],"lat":35.48,"lng":110.44,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"산시","city":"퉁촨","local":"铜川 / Tongchuan","kind":"중소도시","desc":"시안 북쪽의 역사 도시로 송대 6대 도자기 가마 중 하나인 요주요의 발원지. 당대 명의 손사막을 기리는 약왕산과 침엽수림의 조아산이 있다.","known_for":["약왕산","요주요 박물관","조아산","위화궁 유적"],"lat":34.9,"lng":108.95,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"산시","city":"안캉","local":"安康 / Ankang","kind":"중소도시","desc":"진령산맥과 다바산맥 사이 한강 상류에 자리한 남부 생태 도시. 피서지로 꼽히는 난궁산과 한강 뗏목 유람으로 알려져 있다.","known_for":["난궁산","영안 잉후호","한강 래프팅","향계사"],"lat":32.69,"lng":109.03,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"산시","city":"상뤄","local":"商洛 / Shangluo","kind":"중소도시","desc":"시안 남동쪽 진령산맥 깊은 협곡에 위치한 산악 도시. 수려한 폭포와 기암절벽으로 유명한 금금협곡 국가삼림공원이 대표적이다.","known_for":["금금협곡","천봉산","단강 발원지","자방산"],"lat":33.87,"lng":109.94,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"산시","city":"황링 (산시)","local":"黄陵 / Huangling","kind":"소도시","desc":"중화민족의 인문시조로 받들어지는 헌원 황제의 능묘인 황제릉이 있는 옌안 남부의 역사 도시. 수천 년 된 고대 측백나무 숲으로 둘러싸여 있다.","known_for":["황제릉","헌원묘","황릉 고백나무 숲","교산"],"lat":35.58,"lng":109.26,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"산시","city":"화인","local":"华阴 / Huayin","kind":"소도시","desc":"웨이난 동부에 위치하며 오악 중 가장 험준한 바위산으로 꼽히는 서악 화산 자락에 형성된 산악 관광 도시.","known_for":["화산 장공잔도","서악묘","화산 서봉 케이블카","화산 일출"],"lat":34.57,"lng":110.09,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"산시","city":"몐현","local":"勉县 / Mianxian","kind":"소도시","desc":"한중 서부의 삼국지 성지로 제갈량이 북벌 도중 오장원에서 사망한 뒤 유언에 따라 안장된 무후묘와 무후사가 자리 잡고 있다.","known_for":["제갈량 무후묘","면현 무후사","정군산","마초 묘"],"lat":33.15,"lng":106.68,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"간쑤","city":"란저우","local":"兰州 / Lanzhou","kind":"대도시","desc":"황하가 도심 한복판을 동서로 관통하는 간쑤성의 성도이자 실크로드의 핵심 관문. 1909년 건설된 황하 제1교 중산교와 깊은 국물 맛의 란저우 우육면으로 유명하다.","known_for":["중산교","란저우 우육면","백탑산공원","간쑤성 박물관","황하 풍정선"],"lat":36.06,"lng":103.83,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"간쑤","city":"톈수이","local":"天水 / Tianshui","kind":"중소도시","desc":"실크로드 동쪽 관문이자 중국 4대 석굴 중 하나인 맥적산 석굴이 깎아지른 절벽에 조성된 도시. 신화 속 인물 복희의 고향으로도 전해진다.","known_for":["맥적산 석굴","복희묘","남곽사","옥천관"],"lat":34.58,"lng":105.72,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"간쑤","city":"장예","local":"张掖 / Zhangye","kind":"중소도시","desc":"고대 하서회랑의 주요 오아시스 도시로 무지개색 줄무늬가 융기한 절경의 장예 칠채단하 지형이 세계적으로 유명하다.","known_for":["장예 칠채단하","대불사","마제사 석굴","빙구단하"],"lat":38.93,"lng":100.45,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"간쑤","city":"자위관","local":"嘉峪关 / Jiayuguan","kind":"소도시","desc":"명나라 만리장성의 서쪽 끝 관문이자 천하제일웅관이라 불리는 요새 도시. 험준한 사막 협곡 위에 축조된 만리장성 관루와 현벽장성이 있다.","known_for":["자위관 관성","현벽장성","천하제일돈","치롄산 설산 풍경"],"lat":39.77,"lng":98.29,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"간쑤","city":"둔황","local":"敦煌 / Dunhuang","kind":"소도시","desc":"사막 속 오아시스 도시로 수천 기의 불교 벽화와 조각이 보존된 세계유산 막고굴의 도시. 거대한 모래 언덕 명사산과 초승달 모양의 오아시스 월아천이 장관을 이룬다.","known_for":["막고굴","명사산 월아천","옥문관","양관","야단 마귀성"],"lat":40.14,"lng":94.66,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"간쑤","city":"우웨이","local":"武威 / Wuwei","kind":"중소도시","desc":"한나라 한무제가 하서사군을 설치하며 양주라 불렀던 실크로드 요충지. 중국 국가 관광 상징인 국보 청동마답비연이 출토된 곳이다.","known_for":["뇌대한묘","천제산 석굴","문묘","하서회랑 실크로드 유적"],"lat":37.93,"lng":102.64,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"간쑤","city":"주취안","local":"酒泉 / Jiuquan","kind":"중소도시","desc":"서한 시대 곽거병 장군이 하사받은 어주를 샘물에 부어 병사들과 나누어 마셨다는 전설에서 유래한 하서회랑의 유서 깊은 군사 도시.","known_for":["주천공원","위진 벽화묘","종고루","주취안 위성발사센터"],"lat":39.74,"lng":98.51,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"간쑤","city":"린샤","local":"临夏 / Linxia","kind":"중소도시","desc":"간쑤성 남서부 후이족 자치주의 주도로 이슬람 건축 양식의 모스크와 전통 목조 조각이 어우러져 중국의 메카로 불린다. 황하 강변 병령사 석굴의 관문이다.","known_for":["병령사 석굴","팔방십삼향","동공관","후이족 전각 예술"],"lat":35.6,"lng":103.21,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"간쑤","city":"샤허","local":"夏河 / Xiahe","kind":"소도시","desc":"티베트 불교 게룩파 6대 사찰 중 하나인 라브랑사가 자리한 칭하이-티베트 고원 동북 가장자리의 종교·문화 중심지.","known_for":["라브랑사","상커 초원","코라 전경 마니차 순례길","티베트 불교 문화"],"lat":35.2,"lng":102.53,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"간쑤","city":"핑량","local":"平凉 / Pingliang","kind":"중소도시","desc":"간쑤성 동부 황토고원에 위치하며 중국 도교 4대 명산이자 황제가 광성자에게 도를 물었다는 도교 제일산 공동산이 솟아 있다.","known_for":["공동산","유룡궁","왕모궁","황토고원 풍경"],"lat":35.54,"lng":106.67,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"간쑤","city":"룽난","local":"陇南 / Longnan","kind":"중소도시","desc":"쓰촨성·산시성과 접한 간쑤성 최남단 도시로 아열대와 온대가 교차하는 산림 지대. 자이언트 판다 서식지인 백수강 자연보호구와 관아협 석회동굴이 있다.","known_for":["관아협","백수강 판다 보호구","만상동 석회암 동굴","하다푸 혁명기념관"],"lat":33.4,"lng":104.92,"sources":["Wikivoyage","Trip.com"],"note":""}]