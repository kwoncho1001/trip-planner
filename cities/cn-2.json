[{"country":"중국","region":"후난","city":"창사","local":"长沙 / Changsha","kind":"대도시","desc":"후난성의 성도이자 샹장 강변의 역사·문화 중심지. 마왕퇴 한나라 고분 유적과 쥐쯔저우 마오쩌둥 청년 조각상, 활기찬 야시장 미식으로 유명하다.","known_for":["마왕퇴","쥐쯔저우","악록서원","후난요리","황싱루 보행거리"],"lat":28.23,"lng":112.94,"sources":["Wikivoyage","Trip.com","네이버 블로그","마펑워"],"note":""},{"country":"중국","region":"후난","city":"장자제","local":"张家界 / Zhangjiajie","kind":"중소도시","desc":"영화 아바타 배경의 모티브가 된 기암괴석 봉우리의 세계적인 관광 도시. 도심 남쪽의 천문산과 거대한 카르스트 협곡으로 둘러싸여 있다.","known_for":["천문산","유리잔도","천문동","장자제 대협곡"],"lat":29.13,"lng":110.48,"sources":["Wikivoyage","Trip.com","네이버 블로그","마펑워"],"note":""},{"country":"중국","region":"후난","city":"무릉원","local":"武陵源 / Wulingyuan","kind":"소도시","desc":"장자제 국가삼림공원의 핵심 관문 소도시. 수천 개의 석영 사암 기둥이 솟은 원가계, 양가계, 금편계곡 탐방의 베이스캠프다.","known_for":["원가계","백룡 엘리베이터","금편계곡","천자산","보봉호"],"lat":29.35,"lng":110.55,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"후난","city":"츠리","local":"慈利 / Cili","kind":"소도시","desc":"장자제 동부에 위치한 현급 소도시. 장자제 대협곡의 유리다리와 계곡 트레킹, 온천 휴양지로 잘 알려져 있다.","known_for":["장자제 대협곡 유리다리","완푸 온천","루쑤이 풍경구"],"lat":29.43,"lng":111.14,"sources":["Trip.com","마펑워"],"note":""},{"country":"중국","region":"후난","city":"봉황","local":"凤凰 / Fenghuang","kind":"소도시","desc":"타강을 따라 조각루 목조 가옥이 늘어선 중국에서 가장 아름다운 옛 마을 중 하나. 묘족과 토가족 문화가 어우러진 화려한 야경으로 유명하다.","known_for":["타강 조각루","홍교","묘족 풍경구","야경","선충원 고거"],"lat":27.95,"lng":109.6,"sources":["Wikivoyage","Trip.com","네이버 블로그","마펑워"],"note":""},{"country":"중국","region":"후난","city":"푸룽진","local":"芙蓉镇 / Furongzhen","kind":"마을","desc":"거대한 2단 폭포 위에 목조 가옥들이 걸쳐 있는 2천 년 역사의 토가족 고진. 원래 이름은 왕촌이었으나 영화 부용진 촬영 후 개명되었다.","known_for":["부용진 폭포","토가족 조각루","석판가","영화 부용진"],"lat":28.7,"lng":109.95,"sources":["Wikivoyage","Trip.com","네이버 블로그","마펑워"],"note":""},{"country":"중국","region":"후난","city":"지서우","local":"吉首 / Jishou","kind":"중소도시","desc":"샹시 토가족 묘족 자치주의 주도. 깊은 협곡을 가로지르는 애채대교와 묘족 전통 마을인 더항묘채로 들어가는 교통 거점이다.","known_for":["애채대교","더항 묘족 마을","문초","샹시 민속박물관"],"lat":28.31,"lng":109.73,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"후난","city":"차둥","local":"茶峒 (边城) / Chadong (Biancheng)","kind":"마을","desc":"후난, 구이저우, 충칭 세 성이 맞닿는 국경 하천변의 조용한 마을. 작가 선충원의 대표 소설 '변성'의 무대로 줄배(라라도)가 운행된다.","known_for":["선충원 소설 변성","라라도 줄배","삼현정","변성 고가"],"lat":28.48,"lng":109.47,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"후난","city":"리예","local":"里耶 / Liye","kind":"마을","desc":"유수 강변에 위치한 고대 수운 항구 마을. 3만 7천여 점의 진나라 목간(리예 진간)이 발굴되어 진시황 시대의 생활상을 보여주는 역사 명소다.","known_for":["리예 진간 박물관","진나라 고성 유지","유수 풍광","토가족 민속"],"lat":28.8,"lng":109.34,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"후난","city":"화이화","local":"怀化 / Huaihua","kind":"중소도시","desc":"후난 서부 산간 지역의 핵심 고속철도 분기점이자 교통 허브. 둥족과 묘족 문화 지역 및 옛 상업 도시들로 이어지는 관문이다.","known_for":["고속철도 허브","중포 수림공원","단하지형","소수민족 문화"],"lat":27.56,"lng":109.99,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"후난","city":"첸양","local":"黔阳 / Qianyang","kind":"마을","desc":"봉황고성보다 오랜 역사를 지닌 후난 서부 명·청 시대 옛 성곽 마을. 원수와 무수가 만나는 수변에 자리하며 당나라 시인 왕창령의 부용루가 있다.","known_for":["부용루","명청 고건축군","원수 강변 산책","전통 골목"],"lat":27.34,"lng":109.81,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"후난","city":"훙장","local":"洪江 / Hongjiang","kind":"소도시","desc":"명·청·민국 시대 샹시와 첸둥난 일대의 물류와 금융을 독점했던 상업 고성. 수백 채의 고대 은행(전장), 객잔, 회관 건물이 미로처럼 보존되어 있다.","known_for":["훙장 고상성","전장(환전소)","명청 회관","유수 강변 선착장"],"lat":27.11,"lng":110,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"후난","city":"통다오","local":"通道 / Tongdao","kind":"소도시","desc":"후난성 최남단 광시 경계에 위치한 둥족 자치현. 정교한 목조 건축의 풍우교와 고루, 황두동채 등 원형 그대로의 둥족 민속마을들이 분포한다.","known_for":["황두동채","만포 풍우교","고루","홍군 통다오 회의 기념관"],"lat":26.16,"lng":109.78,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"후난","city":"사오산","local":"韶山 / Shaoshan","kind":"소도시","desc":"마오쩌둥의 출생지이자 유년 시절을 보낸 붉은 혁명 성지. 농촌 가옥 형태의 생가와 기념관, 동상 광장이 조성되어 있다.","known_for":["마오쩌둥 생가","적수동","마오쩌둥 기념관","동상 광장"],"lat":27.91,"lng":112.53,"sources":["Wikivoyage","Trip.com","네이버 블로그"],"note":""},{"country":"중국","region":"후난","city":"샹탄","local":"湘潭 / Xiangtan","kind":"중소도시","desc":"샹장 강 하류에 위치한 유서 깊은 상업 항구 도시. 창사-주저우-샹탄 도시권의 한 축으로 제황사와 백석공원(치바이스 고향)이 있다.","known_for":["치바이스 고거","제황사","쇼펑 풍경구","샹장 수변공원"],"lat":27.83,"lng":112.93,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"후난","city":"주저우","local":"株洲 / Zhuzhou","kind":"중소도시","desc":"중국 중남부 철도 교통의 핵심 교차점이자 철도 차량 공업 도시. 중국 전통 건국 신화의 염제(신농씨) 묘가 위치한 염제릉이 유명하다.","known_for":["철도 박물관","염제릉","선농성","방터 테마파크"],"lat":27.83,"lng":113.13,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"후난","city":"헝양","local":"衡阳 / Hengyang","kind":"중소도시","desc":"후난성 남부의 중심 도시이자 샹장 강변의 역사 고도. 오악 중 하나인 남악 형산의 기차 관문이며 석고서원이 자리한다.","known_for":["석고서원","남악 형산 관문","회안봉","샹장 야경"],"lat":26.89,"lng":112.61,"sources":["Wikivoyage","Trip.com","네이버 블로그"],"note":""},{"country":"중국","region":"후난","city":"난웨","local":"南岳 / Nanyue","kind":"자연지역","desc":"중국 오악(五岳) 중 하나인 남악 형산(衡山)의 중심지. 남악대묘를 비롯한 도교와 불교 사찰들이 울창한 삼림 속에 공존하는 영산이다.","known_for":["남악 형산","남악대묘","축융봉","장수송"],"lat":27.24,"lng":112.73,"sources":["Wikivoyage","Trip.com","네이버 블로그"],"note":""},{"country":"중국","region":"후난","city":"웨양","local":"岳阳 / Yueyang","kind":"중소도시","desc":"중국 2대 담수호인 둥팅호와 장강이 만나는 역사 도시. 중국 3대 명루 중 하나인 악양루와 호수 한가운데 은침차 산지인 군산도가 있다.","known_for":["악양루","둥팅호","군산도","군산은침차","변하가"],"lat":29.36,"lng":113.13,"sources":["Wikivoyage","Trip.com","네이버 블로그"],"note":""},{"country":"중국","region":"후난","city":"창더","local":"常德 / Changde","kind":"중소도시","desc":"위안장 강 하류에 위치한 도시로 도연명의 '도화원기' 무대인 도화원 풍경구의 관문. 시내 중심 류엽호와 시월벽 거리로 유명하다.","known_for":["도화원","류엽호","시벽 거리","창더 쌀국수"],"lat":29.03,"lng":111.7,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"후난","city":"이양","local":"益阳 / Yiyang","kind":"중소도시","desc":"둥팅호 남쪽에 자리한 죽세공과 흑차(안화흑차)의 중심 도시. 광활한 대나무 숲인 은자죽해와 고대 차마고도의 출발지가 있다.","known_for":["안화흑차","은자죽해","차마고도 풍경구","둥팅호 습지"],"lat":28.59,"lng":112.35,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"후난","city":"러우디","local":"娄底 / Loudi","kind":"중소도시","desc":"후난성 중부의 도시로 묘족의 선조 치우 전설과 메이산(매산) 문화의 발원지. 신화현의 장대한 즈췌제 계단식 논과 매산용궁 동굴이 있다.","known_for":["즈췌제 계단식 논","매산용궁","파산 풍경구","치우 고향"],"lat":27.7,"lng":112,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"후난","city":"사오양","local":"邵阳 / Shaoyang","kind":"중소도시","desc":"쯔장 강변에 자리 잡은 2,500년 역사의 옛 도시. 유네스코 세계자연유산인 랑산 단하지형과 남산 목장으로 향하는 거점이다.","known_for":["랑산 관문","남산 목장","쌍청각","보경 고성벽"],"lat":27.24,"lng":111.47,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"후난","city":"신닝","local":"新宁 / Xinning","kind":"자연지역","desc":"중국 단하 지형의 대표 명소인 유네스코 세계자연유산 랑산(崀山) 풍경구가 위치한 산간 현. 붉은 절벽과 낙타봉, 팔각채의 운해가 장관이다.","known_for":["랑산 국립지질공원","팔각채","낙타봉","부이강 래프팅"],"lat":26.43,"lng":110.85,"sources":["Wikivoyage","Trip.com","마펑워"],"note":"좌표: 신닝 현청(금석진) 중심지 기준(26.43, 110.85), OpenStreetMap·바이두지도 일치"},{"country":"중국","region":"후난","city":"천저우","local":"郴州 / Chenzhou","kind":"중소도시","desc":"후난성 남부 광둥성 접경의 생태 관광 도시. 새벽 물안개로 유명한 샤오둥장(소동강)과 거대한 붉은 암벽 지형 가오이링(고의령)이 있다.","known_for":["샤오둥장 물안개","가오이링 단하","양톈후 대초원","망산 국립삼림공원"],"lat":25.77,"lng":113.01,"sources":["Wikivoyage","Trip.com","네이버 블로그","마펑워"],"note":""},{"country":"중국","region":"후난","city":"융저우","local":"永州 / Yongzhou","kind":"중소도시","desc":"샹장 상류에 위치한 2,100년 역사의 문화 고도. 당대 문장가 유종원의 '영주팔기' 무대이자 류자묘, 회룡각 등 문화유산이 풍부하다.","known_for":["류자묘","영주팔기 유적","회룡각","구의산 순제릉"],"lat":26.43,"lng":111.61,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"후난","city":"장융","local":"江永 / Jiangyong","kind":"소도시","desc":"세계에서 유일하게 여성들 사이에서만 은밀히 전승되어 온 문자 '여서(女书)'의 고향. 명·청대 돌길과 가옥이 보존된 상명고촌이 있다.","known_for":["강영 여서(Nüshu)","상명고촌","천가정 요족 마을","포미 고촌"],"lat":25.27,"lng":111.34,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"장시","city":"난창","local":"南昌 / Nanchang","kind":"대도시","desc":"장시성의 성도이자 간강 변의 역사 대도시. 중국 당대 명루인 등왕각과 1927년 난창봉기(인민해방군 창군) 기념관이 유명하다.","known_for":["등왕각","팔일봉기기념관","간강 유람선","추수광장 분수","남창 비빔국수"],"lat":28.68,"lng":115.89,"sources":["Wikivoyage","Trip.com","네이버 블로그","마펑워"],"note":""},{"country":"중국","region":"장시","city":"징더전","local":"景德镇 / Jingdezhen","kind":"중소도시","desc":"1천 년 이상 황실 어요 도자기를 생산해 온 세계 도예의 수도. 옛 공장을 개조한 도계천 문화지구와 도양리 어요박물관, 예술가 공방이 밀집해 있다.","known_for":["어요박물관","도계천 야시장","삼보도예촌","중국도자박물관","도자기 DIY"],"lat":29.29,"lng":117.2,"sources":["Wikivoyage","Trip.com","네이버 블로그","마펑워"],"note":""},{"country":"중국","region":"장시","city":"야오리","local":"瑶里 / Yaoli","kind":"마을","desc":"징더전 도자기의 원료가 되는 백토(고령토) 채굴과 수력 물레방아가 시작된 발원지 고진. 명·청대 휘파 고건축과 맑은 계곡물이 어우러져 있다.","known_for":["도자기 발원지","명청 휘파 고가","요리 폭포","고령산 옛 가마"],"lat":29.55,"lng":117.57,"sources":["Trip.com","마펑워"],"note":""},{"country":"중국","region":"장시","city":"우위안","local":"婺源 / Wuyuan","kind":"소도시","desc":"중국에서 가장 아름다운 시골 마을군으로 불리는 전통 휘파 문화 지역. 봄철 계단식 유채꽃밭과 옛 마을들이 수려한 전원 풍경을 이룬다.","known_for":["유채꽃밭","이컹 수향마을","왕커우 고촌","사계절 전원","휘파 건축"],"lat":29.25,"lng":117.86,"sources":["Wikivoyage","Trip.com","네이버 블로그","마펑워"],"note":""},{"country":"중국","region":"장시","city":"황링 (장시)","local":"篁岭 / Huangling","kind":"마을","desc":"우위안 산비탈에 500여 년 전 형성된 절벽 마을. 흰 벽과 검은 기와집 지붕 발코니마다 고추와 옥수수를 말리는 '쇄추(晒秋)' 풍경으로 유명하다.","known_for":["황링 쇄추(晒秋)","케이블카","다락논 풍경","유리 구름다리"],"lat":29.24,"lng":117.87,"sources":["Trip.com","네이버 블로그","마펑워"],"note":""},{"country":"중국","region":"장시","city":"지우장","local":"九江 / Jiujiang","kind":"중소도시","desc":"장강과 파양호가 만나는 수륙 교통의 요충지이자 루산(庐山)의 관문 항구 도시. 백거이의 비파행 무대인 비파정과 수호지의 쉰양루가 있다.","known_for":["루산 관문","쉰양루","비파정","장강 대교","파양호"],"lat":29.7,"lng":115.99,"sources":["Wikivoyage","Trip.com","네이버 블로그"],"note":""},{"country":"중국","region":"장시","city":"루산 (구링)","local":"庐山 (牯岭) / Lushan (Guling)","kind":"소도시","desc":"유네스코 세계문화유산으로 지정된 해발 1,100m의 산상 피서 도시. 서양식 별장군(메이루)과 삼첩천 폭포, 금수곡의 장엄한 운해가 펼쳐진다.","known_for":["구링 옛 거리","메이루 별장","삼첩천 폭포","금수곡","여산 운해"],"lat":29.57,"lng":115.98,"sources":["Wikivoyage","Trip.com","네이버 블로그","마펑워"],"note":""},{"country":"중국","region":"장시","city":"상라오","local":"上饶 / Shangrao","kind":"중소도시","desc":"장시성 동북부의 고속철도 교통 허브. 산칭산과 왕셴구, 거셴촌 등 주요 산악 및 관광지로 연결되는 교통의 중심지다.","known_for":["산칭산 관문","상라오 집중영 기념관","신장 수변공원","신사 고속철 허브"],"lat":28.45,"lng":117.97,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"장시","city":"산칭산","local":"三清山 / Sanqingshan","kind":"자연지역","desc":"유네스코 세계자연유산으로 등재된 도교의 명산. 거대한 뱀과 여신 모양을 닮은 화강암 봉우리와 벼랑 끝을 잇는 고공 잔도가 유명하다.","known_for":["화강암 봉우리","동방여신 바위","거망출산 바위","고공 유리잔도","삼청궁"],"lat":28.9,"lng":118.06,"sources":["Wikivoyage","Trip.com","네이버 블로그","마펑워"],"note":""},{"country":"중국","region":"장시","city":"왕셴구","local":"望仙谷 / Wangxiangu","kind":"마을","desc":"깎아지른 기암 협곡 절벽에 공중 목조 가옥들이 매달려 있는 선협 판타지 분위기의 관광 마을. 해질녘 협곡 전체에 켜지는 야경이 압도적이다.","known_for":["협곡 절벽 가옥","공중 잔도","선협 야경","백학애","협곡 폭포"],"lat":28.68,"lng":117.81,"sources":["Trip.com","네이버 블로그","마펑워"],"note":""},{"country":"중국","region":"장시","city":"거셴춘","local":"葛仙村 / Gexiancun","kind":"마을","desc":"도교 선인 갈현의 수행지 거셴산 자락에 조성된 고풍스러운 수운 산간 마을. 안개 연출과 화려한 한푸 체험, 야간 수중 등불 쇼로 알려져 있다.","known_for":["거셴산 케이블카","종루 야경","수중 조명쇼","한푸 촬영","운해"],"lat":28.14,"lng":117.69,"sources":["Trip.com","마펑워"],"note":""},{"country":"중국","region":"장시","city":"잉탄","local":"鹰潭 / Yingtan","kind":"중소도시","desc":"중국 동남부 철도 교통의 분기점이자 안경 산업의 중심 도시. 도교의 발원지이자 단하지형 명승지인 롱후산으로 들어가는 관문이다.","known_for":["롱후산 관문","철도 요충지","중국 안경 박물관","신강 공원"],"lat":28.24,"lng":117.03,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"장시","city":"롱후산 (상칭)","local":"龙虎山 (上清) / Longhushan (Shangqing)","kind":"자연지역","desc":"유네스코 세계자연유산으로 등재된 단하 지형과 중국 도교 정일파의 발원지. 노계호 뗏목 유람과 절벽 관 장례(현관) 승강 시연, 상칭고진이 있다.","known_for":["사천사 본산","노계호 뗏목","단하 기암","현관 장례 시연","상칭고진"],"lat":28.11,"lng":117.03,"sources":["Wikivoyage","Trip.com","네이버 블로그","마펑워"],"note":""},{"country":"중국","region":"장시","city":"핑샹 (장시)","local":"萍乡 / Pingxiang","kind":"중소도시","desc":"후난성과 접한 장시 서부의 공업 도시. 중국 노동운동의 발상지인 안원 탄광 유적지와 유명 백패킹 명소 우궁산의 베이스캠프다.","known_for":["우궁산 관문","안원 탄광 기념관","추수봉기 광장","양치산 동굴"],"lat":27.62,"lng":113.85,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"장시","city":"우궁산","local":"武功山 / Wugongshan","kind":"자연지역","desc":"해발 1,900m 능선을 따라 10만 에이커 규모의 초원이 끝없이 펼쳐지는 중국 최고의 고산 백패킹 성지. 황금빛 운해와 일출 텐트 야영으로 유명하다.","known_for":["고산 초원","금정(金顶)","운해 일출","텐트 야영","장거리 트레킹"],"lat":27.46,"lng":114.18,"sources":["Wikivoyage","Trip.com","네이버 블로그","마펑워"],"note":""},{"country":"중국","region":"장시","city":"이춘","local":"宜春 / Yichun","kind":"중소도시","desc":"명월산의 자연풍광과 온천으로 유명한 서부 휴양 도시. 마조도일 선사가 선종을 크게 떨친 불교 발원지이며 셀레늄 온천 마을 원탕진이 유명하다.","known_for":["명월산","원탕진 온천","선종 조정","화성사"],"lat":27.81,"lng":114.39,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"장시","city":"원탕진","local":"温汤镇 / Wentangzhen","kind":"마을","desc":"이춘 시내 남쪽 명월산 자락의 천연 셀레늄 온천 마을. 마을 광장 노천 족욕탕과 장수 마을 온천 요양으로 중국 전역에서 휴양객이 찾는다.","known_for":["천연 셀레늄 온천","명월산 케이블카 관문","노천 족욕 광장","온천 객잔"],"lat":27.68,"lng":114.28,"sources":["Trip.com","마펑워"],"note":""},{"country":"중국","region":"장시","city":"신위","local":"新余 / Xinyu","kind":"중소도시","desc":"견우와 직녀, 칠선녀 설화가 깃든 인공호수 선녀호(仙女湖)로 알려진 호반 도시. 명대 백과사전 '천공개물'의 저자 송응성의 고향이다.","known_for":["선녀호 풍경구","천공개물 기념관","포하 고촌","앙천강 습지공원"],"lat":27.82,"lng":114.93,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"장시","city":"지안","local":"吉安 / Ji'an","kind":"중소도시","desc":"감강 중류에 위치한 고대 여릉(庐陵) 문화의 중심 도시. 문천상 등 수많은 진사를 배출한 백로주서원과 청원산 정거사가 있다.","known_for":["백로주서원","청원산 사찰","문천상 기념관","여릉 문화생태원"],"lat":27.12,"lng":114.99,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"장시","city":"징강산 (츠핑)","local":"井冈山 (茨坪) / Jinggangshan (Ciping)","kind":"소도시","desc":"마오쩌둥과 주더가 중국 최초의 농촌 혁명 근거지를 세운 산악 도시. 중심 마을인 츠핑진 주변으로 험준한 황양계 협곡과 원시림 폭포가 이어진다.","known_for":["혁명 박물관","황양계 협곡","오지봉","용담 폭포군","츠핑 구시가지"],"lat":26.57,"lng":114.17,"sources":["Wikivoyage","Trip.com","네이버 블로그"],"note":""},{"country":"중국","region":"장시","city":"간저우","local":"赣州 / Ganzhou","kind":"대도시","desc":"장시성 남부의 중심 도시이자 '객가(客家)의 요람'. 송나라 때 축조된 석조 성벽과 장강 지류를 잇는 고대 부교(배다리), 울고대가 보존되어 있다.","known_for":["송대 고성벽","간주 고부교(배다리)","울고대","팔경대","객가 토루 문화"],"lat":25.85,"lng":114.93,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"장시","city":"루이진","local":"瑞金 / Ruijin","kind":"소도시","desc":"1931년 중화소비에트공화국 임시정부가 수립되었던 '붉은 수도'. 엽평과 사주 구 유적지, 홍군 대장정의 역사적 출발지점이다.","known_for":["엽평 혁명구지","사주 홍정(홍군 우물)","중화소비에트 기념관","대장정 출발지"],"lat":25.88,"lng":116.03,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"장시","city":"푸저우 (장시)","local":"抚州 / Fuzhou","kind":"중소도시","desc":"중국의 대문호 탕현조(모란정의 작가)와 북송의 정치가 왕안석의 고향인 문화 도시. 문창교와 탕현조 기념관, 정토종 사찰 정각사가 있다.","known_for":["탕현조 기념관","문창교 옛 거리","왕안석 기념관","대각산 협곡"],"lat":27.95,"lng":116.36,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"장시","city":"포양","local":"鄱阳 / Poyang","kind":"소도시","desc":"중국 최대 담수호인 파양호 동쪽에 위치한 역사 소도시. 아시아 최대 철새 월동지인 파양호 국립습지공원의 탐방 거점이다.","known_for":["파양호 습지공원","철새 탐조","백조 군락","포양호 민물 어시장"],"lat":28.99,"lng":116.68,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"후베이","city":"우한","local":"武汉 / Wuhan","kind":"대도시","desc":"후베이성의 성도이자 장강과 한강이 합류하는 화중 최대의 메트로폴리스. 중국 3대 명루 중 하나인 황학루와 동호, 장강대교, 호부항 먹자골목이 유명하다.","known_for":["황학루","동호 풍경구","우한 장강대교","후베이성 박물관","열간면(러간몐)"],"lat":30.58,"lng":114.29,"sources":["Wikivoyage","Trip.com","네이버 블로그","마펑워"],"note":""},{"country":"중국","region":"후베이","city":"이창","local":"宜昌 / Yichang","kind":"중소도시","desc":"장강 삼협의 입구이자 세계 최대 수력발전소 삼협댐이 위치한 수력 발전의 수도. 삼협 크루즈의 출도착지이며 삼협인가 풍경구와 서릉협이 있다.","known_for":["삼협댐","삼협인가","서릉협","청강화랑","굴원 고향"],"lat":30.69,"lng":111.28,"sources":["Wikivoyage","Trip.com","네이버 블로그","마펑워"],"note":""},{"country":"중국","region":"후베이","city":"징저우","local":"荆州 / Jingzhou","kind":"중소도시","desc":"삼국지 영웅들의 쟁탈전 무대였던 초(楚)나라의 고도 형주. 둘레 10km가 넘는 명·청대 벽돌 성벽이 완벽히 보존되어 있으며 관우 사당과 형주박물관이 있다.","known_for":["형주고성벽","형주박물관 초나라 유물","관우사","장거정 고거","초왕차마진"],"lat":30.34,"lng":112.23,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"후베이","city":"샹양","local":"襄阳 / Xiangyang","kind":"대도시","desc":"한강 남안에 자리 잡은 2,800년 역사의 전략 요충지 '철타의 양양'. 삼고초려의 무대 고융중과 거대한 양양고성벽, 영화 촬영지 중국당성이 유명하다.","known_for":["양양고성벽","고융중(제갈량 은거지)","중국당성(영화세트장)","한강 풍광","양양 쇠고기면"],"lat":32.01,"lng":112.12,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"후베이","city":"스옌","local":"十堰 / Shiyan","kind":"중소도시","desc":"후베이성 서북부 한수 계곡에 위치한 자동차 산업 도시이자 도교의 성지 무당산으로 가는 관문. 남수북조 중선 수원의 핵심 단장커우 저수지와 접한다.","known_for":["무당산 관문","단장커우 저수지","동풍자동차 박물관","백마산"],"lat":32.65,"lng":110.8,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"후베이","city":"무당산","local":"武当山 / Wudangshan","kind":"자연지역","desc":"유네스코 세계문화유산으로 등재된 도교 무술 태극권의 발원지. 해발 1,612m 천주봉 정상의 동주금전(금으로 도금된 전각)과 벼랑 위 남암궁이 장관이다.","known_for":["금전(천주봉)","태극권 본산","남암궁","자소궁","도교 고건축군"],"lat":32.51,"lng":111.08,"sources":["Wikivoyage","Trip.com","네이버 블로그","마펑워"],"note":""},{"country":"중국","region":"후베이","city":"선농자 (무위진)","local":"神农架 (木鱼) / Shennongjia (Muyu)","kind":"자연지역","desc":"유네스코 세계자연유산이자 화중 최고봉(해발 3,106m) 신농정이 위치한 원시림 생태구. 거점 마을인 무위진을 중심으로 황금들창코원숭이 서식지와 야인 전설로 유명하다.","known_for":["신농정","들창코원숭이 보호구","야인동","원시림 트레킹","천생교"],"lat":31.47,"lng":110.39,"sources":["Wikivoyage","Trip.com","네이버 블로그","마펑워"],"note":""},{"country":"중국","region":"후베이","city":"핑첸","local":"坪阡 (大九湖) / Pingqian (Dajiuhu)","kind":"마을","desc":"선농자 서부 고산 분지 습지인 대구호(大九湖) 국립습지공원 기슭에 위치한 호반 마을. 아침 물안개와 고산 초원 산책로가 그림처럼 펼쳐진다.","known_for":["대구호 습지","아침 물안개","고산 사슴목장","목조 산장"],"lat":31.51,"lng":110.05,"sources":["Trip.com","마펑워"],"note":""},{"country":"중국","region":"후베이","city":"은스","local":"恩施 / Enshi","kind":"중소도시","desc":"후베이 서남부 토가족·묘족 자치주의 주도. 미국의 그랜드캐니언에 비견되는 장대한 은스 대협곡의 절벽 잔도와 기암 '일주향', 토가 딸내미성(딸성)이 유명하다.","known_for":["은스 대협곡","일주향 기암","절벽 잔도","토가 딸내미성(女兒城)","쇠고기 훠궈"],"lat":30.27,"lng":109.48,"sources":["Wikivoyage","Trip.com","네이버 블로그","마펑워"],"note":""},{"country":"중국","region":"후베이","city":"리촨","local":"利川 / Lichuan","kind":"소도시","desc":"충칭과 접경한 고원 청정 도시. 아시아 최대 규모의 복합 용암 동굴인 텅룽동(등룡동)과 명나라 때 지어진 거대한 토가족 장원 대수정고건축군이 있다.","known_for":["텅룽동(등룡동)","대수정 고장원","제운산","토가족 민요 용선조"],"lat":30.24,"lng":108.82,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"후베이","city":"허펑","local":"鹤峰 / Hefeng","kind":"소도시","desc":"수정처럼 투명한 에메랄드빛 계곡물 위로 배가 공중에 뜬 것처럼 보이는 핑산협곡(병산협곡)으로 유명한 산간 소도시. 깊은 협곡 트레킹으로 인기가 높다.","known_for":["핑산협곡(병산협곡)","공중 부유 보트","용간협곡","토가족 차문화"],"lat":29.93,"lng":110.21,"sources":["Trip.com","네이버 블로그","마펑워"],"note":""},{"country":"중국","region":"후베이","city":"셴펑","local":"咸丰 / Xianfeng","kind":"소도시","desc":"유네스코 세계문화유산으로 지정된 당시 토사성(唐崖土司城) 유적지가 위치한 도시. 400여 년 전 명·청대 토가족 자치 통치기구의 석조 패방과 성곽 유적이 남아 있다.","known_for":["당시 토사성 유적","평산 삼림공원","황금동","토가족 민속"],"lat":29.68,"lng":108.99,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"후베이","city":"바둥","local":"巴东 / Badong","kind":"소도시","desc":"장강 삼협 중 가장 수려한 무협(巫峡)의 동쪽 관문 도시. 투명한 지류 신농계(神农溪)를 거슬러 올라가는 전통 목선 뗏목 유람과 장강 협곡 조망으로 유명하다.","known_for":["무협 관문","신농계 협곡 뗏목","장강 바둥대교","파인 고령 옛길"],"lat":31.05,"lng":110.34,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"후베이","city":"츠비","local":"赤壁 / Chibi","kind":"소도시","desc":"서기 208년 유비·손권 연합군이 조조의 80만 대군을 격파한 삼국지 적벽대전의 실제 역사 현장. 장강 절벽에 붉게 새겨진 '적벽' 마애석각과 무후사당이 있다.","known_for":["삼국 적벽 고전장","적벽 마애석각","주유 석상","양루동 청전차 발원지"],"lat":29.73,"lng":113.9,"sources":["Wikivoyage","Trip.com","네이버 블로그"],"note":""},{"country":"중국","region":"후베이","city":"징먼","local":"荆门 / Jingmen","kind":"중소도시","desc":"한수 중류에 위치한 역사 도시로 초나라 묘택 고묘군과 중국 항공 레저 중심지(장하 풍경구). 봄철 광활한 사양 유채꽃 축제로 유명하다.","known_for":["장하 풍경구","사양 유채꽃 바다","묘택 초나라 고묘","용천서원"],"lat":31.04,"lng":112.2,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"후베이","city":"중샹","local":"钟祥 / Zhongxiang","kind":"소도시","desc":"유네스코 세계문화유산인 명나라 가정제의 부모 합장릉 명현릉(明显陵)이 있는 유서 깊은 고도. 호수 속 섬을 잇는 막수호와 황선동 종유석 동굴이 있다.","known_for":["명현릉(명나라 황릉)","막수호","황선동 석회동굴","명나라 성벽 유적"],"lat":31.17,"lng":112.58,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"후베이","city":"수이저우","local":"随州 / Suizhou","kind":"중소도시","desc":"기원전 5세기 전국시대 악기이자 세계적인 보물 증후을 편종이 출토된 역사 도시. 농경의 신 염제 신농씨의 탄생 성지와 천년 은행나무 군락지 대홍산이 있다.","known_for":["증후을 편종 출토지","염제 신농 고향","대홍산 풍경구","천년 은행곡"],"lat":31.72,"lng":113.37,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"후베이","city":"샤오간","local":"孝感 / Xiaogan","kind":"중소도시","desc":"한나라 동영의 효행 설화에서 유래한 효(孝) 문화의 중심 도시. 우한 북쪽에 인접하며 수려한 기암절벽의 쌍봉산 삼림공원과 쌀로 빚은 미주(감주)가 유명하다.","known_for":["쌍봉산 삼림공원","효감 미주","동영공원","관음호"],"lat":30.93,"lng":113.92,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"후베이","city":"황강","local":"黄冈 / Huanggang","kind":"중소도시","desc":"북송의 문호 소동파가 유배되어 '전적벽부'와 '후적벽부'를 집필한 동파적벽(황주적벽)의 역사 도시. 동북쪽으로 대별산 최고봉 천당채로 연결된다.","known_for":["동파적벽","소동파 유적","대별산 천당채 관문","이시진 기념관"],"lat":30.45,"lng":114.88,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"후베이","city":"황스","local":"黄石 / Huangshi","kind":"중소도시","desc":"장강 남안에 위치한 3천 년 채굴 역사의 청동기 광산 및 근대 철강 공업 도시. 아시아 최대 규모의 노천 광산 구덩이를 보존한 국가광산공원이 있다.","known_for":["황석 국가광산공원","동록산 춘추 청동광 유적","자기호 풍경구","동초산"],"lat":30.22,"lng":115.08,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"후베이","city":"어저우","local":"鄂州 / Ezhou","kind":"중소도시","desc":"삼국시대 오나라 손권이 도읍으로 삼았던 고대 무창(武昌)의 본향. 장강 한가운데 암초 위에 위태롭게 서 있는 수중 사찰 관음각과 양란호가 있다.","known_for":["장강 관음각","서산 풍경구","양란호","삼국 오나라 옛 궁지"],"lat":30.4,"lng":114.89,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"후베이","city":"셴닝","local":"咸宁 / Xianning","kind":"중소도시","desc":"중국 '온천의 도시'이자 향기로운 금목서(계화나무)의 고향. 시내 중심 온천천과 남쪽 도교의 명산 구궁산(九宫山), 잠산 삼림공원이 유명하다.","known_for":["천연 유황 온천","구궁산 도교 명산","계화꽃 축제","잠산 국가삼림공원"],"lat":29.84,"lng":114.32,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"후베이","city":"마청","local":"麻城 / Macheng","kind":"소도시","desc":"대별산 남쪽 기슭에 위치한 유서 깊은 산간 도시. 해발 1,300m 귀봉산 정상에 끝없이 펼쳐지는 10만 에이커 규모의 진달래 군락지와 명대 사상가 이지의 고향이다.","known_for":["귀봉산 진달래 바다","이지 기념관","오사 고사찰","대별산 트레킹"],"lat":31.18,"lng":115.01,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"후베이","city":"첸장 (후베이)","local":"潜江 / Qianjiang","kind":"소도시","desc":"장한 평원 중심의 수향 도시이자 중국 민물가재(샤오롱샤) 요리의 본고장. 현대 희곡의 거장 조우의 고향이며 반원 생태습지가 조성되어 있다.","known_for":["샤오롱샤(가재) 미식 거리","조우 대극원","반원 국가습지공원","장한 수향"],"lat":30.42,"lng":112.9,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"구이저우","city":"구이양","local":"贵阳 / Guiyang","kind":"대도시","desc":"구이저우성의 성도이자 숲의 도시(임성). 명나라 때 남명강 암반 위에 세워진 갑수루와 야생 원숭이가 노니는 검령산공원, 화려한 야경의 화과원이 유명하다.","known_for":["갑수루","검령산공원(치엔링산)","청암고진","화과원 백궁","창왕몐(내장국수)"],"lat":26.59,"lng":106.71,"sources":["Wikivoyage","Trip.com","네이버 블로그","마펑워"],"note":""},{"country":"중국","region":"구이저우","city":"칭옌","local":"青岩 / Qingyan","kind":"마을","desc":"구이양 남쪽 근교에 위치한 600년 역사의 명·청대 군사 요새 석조 고진. 돌담길과 사원, 교회가 공존하며 전통 족발(청암 노포 족발)이 명물이다.","known_for":["명청 석조 골목","청암 고성벽","자선각","청암 족발","조국주 고거"],"lat":26.33,"lng":106.69,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"구이저우","city":"안순","local":"安顺 / Anshun","kind":"중소도시","desc":"아시아 최대 황과수 폭포의 관문이자 600년 전 명나라 정벌군 한족 후예들의 거주지인 '둔보(屯堡)' 문화의 고향. 용궁 카르스트 수중 동굴이 있다.","known_for":["황과수 폭포 관문","천룡 둔보 마을","용궁 수중 동굴","안순 문묘"],"lat":26.25,"lng":105.94,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"구이저우","city":"황과수","local":"黄果树 / Huangguoshu","kind":"자연지역","desc":"높이 77.8m, 너비 101m에 달하는 아시아 최대 규모의 폭포. 폭포 뒤편 절벽을 관통하는 천연 수렴동(동굴 통로)과 분재원, 천성교 기암 계곡이 이어진다.","known_for":["황과수 대폭포","수렴동","천성교 풍경구","두파당 폭포","카르스트 협곡"],"lat":25.99,"lng":105.67,"sources":["Wikivoyage","Trip.com","네이버 블로그","마펑워"],"note":""},{"country":"중국","region":"구이저우","city":"쭌이","local":"遵义 / Zunyi","kind":"대도시","desc":"1935년 중국 공산당 홍군의 역사적 전환점인 쭌이 회의가 열렸던 붉은 혁명 고도. 유네스코 세계문화유산인 중세 군사 산성 유적 해룡둔의 거점이다.","known_for":["쭌이 회의 회지","홍군 열사릉","해룡둔 요새","봉황산 공원","양고기 쌀국수"],"lat":27.69,"lng":106.92,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"구이저우","city":"하이룽툰","local":"海龙屯 / Hailongtun","kind":"자연지역","desc":"유네스코 세계문화유산으로 등재된 보주 토사의 험준한 산악 석조 요새 유적. 해발 1,300m 절벽 위에 축조된 9개 성문과 36보 계단이 남아 있다.","known_for":["토사 산악 요새","36보 거친 돌계단","비호관 성문","보주 토사 유적"],"lat":27.81,"lng":106.84,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"구이저우","city":"마오타이","local":"茅台 / Maotai","kind":"소도시","desc":"중국을 대표하는 명주 귀주모태주(마오타이주)의 독점 생산지. 적수하(赤水河) 강변을 따라 수백 개의 전통 증류 양조장과 마오타이주 문화박물관이 늘어서 있다.","known_for":["귀주모태주 발원지","마오타이주 박물관","적수하 양조 거리","양천사 고성"],"lat":27.79,"lng":106.39,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"구이저우","city":"츠수이","local":"赤水 / Chishui","kind":"소도시","desc":"유네스코 세계자연유산인 중국 단하 지형의 대표 명소. 거대한 붉은 절벽과 츠수이 대폭포, 수만 그루의 죽순이 우거진 죽해(대나무 숲), 불광암이 비경을 이룬다.","known_for":["츠수이 대폭포","불광암 단하","적수 죽해","연자암 국가삼림공원"],"lat":28.49,"lng":105.91,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"구이저우","city":"카이리","local":"凯里 / Kaili","kind":"중소도시","desc":"첸둥난 묘족·동족 자치주의 주도이자 소수민족 문화 탐방의 관문 도시. 첸둥난 민족박물관과 은세공 거리, 시강 천호묘채로 향하는 교통 요충지다.","known_for":["소수민족 문화 관문","첸둥난 민족박물관","신산 묘족시장","카이리 산탕위(토마토 생선탕)"],"lat":26.65,"lng":107.95,"sources":["Wikivoyage","Trip.com","네이버 블로그"],"note":""},{"country":"중국","region":"구이저우","city":"시강","local":"西江 (千户苗寨) / Xijiang (Qianhu Miaozhai)","kind":"마을","desc":"산비탈을 따라 1,000채가 넘는 전통 목조 조각루 가옥이 빽빽이 들어선 세계 최대의 묘족 마을. 밤이 되면 마을 전체에 켜지는 만가등화 야경과 장탁연으로 유명하다.","known_for":["천호묘채 만가등화 야경","목조 조각루","장탁연(긴 식탁)","묘족 은장식","풍우교"],"lat":26.5,"lng":108.17,"sources":["Wikivoyage","Trip.com","네이버 블로그","마펑워"],"note":""},{"country":"중국","region":"구이저우","city":"랑더","local":"朗德 (上寨) / Langde (Shangzhai)","kind":"마을","desc":"카이리 남쪽에 위치한 소박하고 원형이 잘 보존된 묘족 전통 마을. 마을 입구에서 손님을 맞는 '12도 난문주(술잔 의식)'와 전통 갈탑춤 공연이 펼쳐진다.","known_for":["12도 난문주 환영 의식","로성 갈탑춤","자갈길 고촌","묘족 전통 목조 가옥"],"lat":26.47,"lng":108.06,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"구이저우","city":"자오싱","local":"肇兴 (侗寨) / Zhaoxing (Dongzhai)","kind":"마을","desc":"산간 계곡에 형성된 중국 최대 규모의 동족(侗族) 마을. 못을 쓰지 않고 지은 5대 고루(인의예지신)와 화교(풍우교), 유네스코 무형유산인 동족 대가 합창이 울려 퍼진다.","known_for":["5대 고루","화교(풍우교)","동족 대가 합창","천연 쪽염색 거리","당안 계단식 논 관문"],"lat":25.91,"lng":109.18,"sources":["Wikivoyage","Trip.com","네이버 블로그","마펑워"],"note":""},{"country":"중국","region":"구이저우","city":"탕안","local":"堂安 / Tang'an","kind":"마을","desc":"자오싱동채 위쪽 해발 900m 산비탈에 자리 잡은 동족 생태박물관 마을. 마을을 둘러싼 장대한 탕안 계단식 논과 자오싱까지 이어지는 트레킹 코스로 유명하다.","known_for":["탕안 계단식 논","동족 생태박물관","운해 일출","자오싱-탕안 트레킹"],"lat":25.92,"lng":109.21,"sources":["Trip.com","마펑워"],"note":""},{"country":"중국","region":"구이저우","city":"바사","local":"岜沙 / Basha","kind":"마을","desc":"울창한 대나무 숲속에 위치한 중국에서 유일하게 총기 소지가 허용된 '마지막 총잡이 부족' 묘족 마을. 낫으로 머리를 깎는 성인식과 엽총 발사 환영식이 이색적이다.","known_for":["총잡이 부족","낫 삭발 의식","고목 숭배 신앙","비사 묘족 총기 문화"],"lat":25.72,"lng":108.82,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"구이저우","city":"전위안","local":"镇远 / Zhenyuan","kind":"소도시","desc":"우양하가 S자 곡류를 그리며 마을을 태극 모양으로 감싸 흐르는 2,200년 역사의 수상 고성. 절벽을 따라 지어진 유불도 삼교 복합 사원 청룡동과 축성교 야경이 장관이다.","known_for":["우양하 태극 고성","청룡동 절벽 건축군","축성교 야경","석병산 전망대","고대 골목"],"lat":27.13,"lng":108.45,"sources":["Wikivoyage","Trip.com","네이버 블로그","마펑워"],"note":""},{"country":"중국","region":"구이저우","city":"퉁런","local":"铜仁 / Tongren","kind":"중소도시","desc":"구이저우 동북부의 불교 명산 판징산(범정산)으로 들어가는 관문 도시. 명·청대 상업 거리의 원형을 복원한 중남문 역사문화거리와 비장협곡이 있다.","known_for":["판징산 관문","중남문 고성","대명변성","비장강 수변야경"],"lat":27.95,"lng":108.58,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"구이저우","city":"판징산","local":"梵净山 / Fanjingshan","kind":"자연지역","desc":"유네스코 세계자연유산이자 중국 불교 5대 명산(미륵도량). 해발 2,336m 수직 바위기둥 위에 아찔하게 세워진 홍운금정(붉은구름 금전)과 버섯바위, 운해가 신비롭다.","known_for":["홍운금정 쌍둥이사탑","버섯바위","미륵도량","원숭이 보호구","운해와 불광"],"lat":27.91,"lng":108.69,"sources":["Wikivoyage","Trip.com","네이버 블로그","마펑워"],"note":""},{"country":"중국","region":"구이저우","city":"리보","local":"荔波 / Libo","kind":"소도시","desc":"유네스코 세계자연유산 중국 남방 카르스트의 핵심인 소칠공(小七孔)과 대칠공 풍경구의 도시. 비취색 청류와 백화수 폭포, 청나라 소칠공 고교가 어우러져 있다.","known_for":["소칠공 고교","와룡담 에메랄드 호수","68급 낙차 폭포","대칠공 협곡","포이족 마을"],"lat":25.43,"lng":107.89,"sources":["Wikivoyage","Trip.com","네이버 블로그","마펑워"],"note":""},{"country":"중국","region":"구이저우","city":"류판수이","local":"六盘水 / Liupanshui","kind":"중소도시","desc":"여름 평균 기온이 19도에 불과해 '중국의 여름 휴양 수도(양도)'로 불리는 고원 도시. 오몽산 고원 대초원과 천년 은행나무가 자라는 퉈러촌이 유명하다.","known_for":["양도(서늘한 도시)","우멍산 대초원","퉈러 천년 은행마을","야간 스키장"],"lat":26.6,"lng":104.83,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"구이저우","city":"싱이","local":"兴义 / Xingyi","kind":"중소도시","desc":"첸시난 부이족·묘족 자치주의 주도이자 카르스트 봉우리의 천국. 수만 개의 뾰족한 봉우리와 유채꽃밭이 펼쳐지는 만봉림(万峰林), 깊은 협곡 마령하가 절경이다.","known_for":["만봉림","마령하 협곡 폭포군","만봉호 유람선","부이족 팔음좌창"],"lat":25.09,"lng":104.89,"sources":["Wikivoyage","Trip.com","네이버 블로그","마펑워"],"note":""},{"country":"중국","region":"구이저우","city":"두윈","local":"都匀 / Duyun","kind":"중소도시","desc":"첸난 부이족·묘족 자치주의 주도이자 명차 두윈모젠(모첨차)의 산지. 드라마 진정령 촬영지인 진한성 영상기지와 백자교가 있는 강변 도시.","known_for":["두윈 모첨차","진한성 영화세트장","백자교","녹박치 원시삼림"],"lat":26.19,"lng":107.45,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"구이저우","city":"비제","local":"毕节 / Bijie","kind":"중소도시","desc":"오몽산맥 중심에 위치한 도시로 봄철 수백 평방킬로미터에 걸쳐 원시 진달래가 만개하는 백리두견(百里杜鹃)과 칠성관 고대 유적이 유명하다.","known_for":["백리두견 국립삼림공원","구동천 카르스트 동굴","오몽산 기암","초해 고산습지"],"lat":27.22,"lng":105.22,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"구이저우","city":"즈진","local":"织金 / Zhijin","kind":"소도시","desc":"세계 최고 수준의 초대형 지하 카르스트 석회동굴인 즈진동(织金洞) 국립지질공원의 도시. 웅장한 석순과 종유석 기둥 은우궁(银雨树)이 압도적인 규모를 자랑한다.","known_for":["직금동 국립지질공원","은우수 석순","직금 고성벽","평원 고진"],"lat":26.64,"lng":105.79,"sources":["Trip.com","마펑워"],"note":""},{"country":"중국","region":"구이저우","city":"핑탕","local":"平塘 / Pingtang","kind":"소도시","desc":"세계 최대 크기인 직경 500m 구면 전파망원경 FAST(중국 천안 / 天眼)가 위치한 카르스트 분지 도시. 거대한 싱크홀 천갱군(天坑群)과 천문과학마을이 있다.","known_for":["중국천안(FAST 전파망원경)","천문체험관","평당 천갱군","갑차 폭포"],"lat":25.8,"lng":107.21,"sources":["Trip.com","마펑워"],"note":""},{"country":"중국","region":"구이저우","city":"젠허","local":"剑河 / Jianhe","kind":"소도시","desc":"청수강(清水江) 상류에 위치한 첸둥난의 천연 유황 온천 도시. 묘족의 사랑의 여신 앙아사(仰阿莎)의 거대한 조각상과 호반 온천 리조트가 조성되어 있다.","known_for":["젠허 천연온천","앙아사 여신상","청수강 풍광","묘족 민속촌"],"lat":26.73,"lng":108.59,"sources":["Trip.com","마펑워"],"note":""},{"country":"중국","region":"구이저우","city":"레이산","local":"雷山 / Leishan","kind":"소도시","desc":"묘족의 성산 뇌공산(해발 2,178m) 자락에 위치한 소도시. 시강 천호묘채와 랑더묘채를 관할하며 해마다 묘족 최대 축제인 묘년(苗年) 행사가 열린다.","known_for":["뇌공산 국가자연보호구","묘족 묘년 축제","단강 묘채","은세공 민속"],"lat":26.38,"lng":108.08,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"구이저우","city":"충장","local":"从江 / Congjiang","kind":"소도시","desc":"구이저우와 광시의 경계에 위치한 소수민족 거점 소도시. 고산 능선을 물결치는 가방 계단식 논(加榜梯田)과 바사 묘채로 들어가는 교통 허브다.","known_for":["가방 계단식 논","두류강 수변","바사 묘채 관문","은지 고루촌"],"lat":25.75,"lng":108.73,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"구이저우","city":"룽장","local":"榕江 / Rongjiang","kind":"소도시","desc":"2023년 중국 전역을 뒤흔든 아마추어 축구 열풍 '촌초(村超, 빌리지 슈퍼리그)'의 발원지. 삼보동채와 고대 반얀트리가 자라는 강변 소도시.","known_for":["촌초(마을 축구 리그)","삼보동채","백포 묘채","두류강 래프팅"],"lat":26.09,"lng":108.45,"sources":["Trip.com","마펑워"],"note":""}]