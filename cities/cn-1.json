[{"country":"중국","region":"광둥","city":"광저우","local":"广州 / Guangzhou","kind":"대도시","desc":"광둥성의 성도이자 경제·문화 중심지. 수천 년 역사의 해상 무역항이자 광둥 요리와 딤섬의 본고장이다.","known_for":["광둥 요리·딤섬","천가사","주강 야경","샤몐다오"],"lat":23.13,"lng":113.26,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광둥","city":"선전","local":"深圳 / Shenzhen","kind":"대도시","desc":"홍콩 국경에 위치한 중국 최초의 경제특구이자 첨단 테크 혁신 도시. 현대적인 마천루 경관과 화창베이 전자상가가 유명하다.","known_for":["화창베이 전자상가","롄화산 공원","테크 산업 허브","홍콩 접경"],"lat":22.5467,"lng":114.0544,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광둥","city":"주하이","local":"珠海 / Zhuhai","kind":"중소도시","desc":"마카오와 접한 해변 정원 도시이자 경제특구. 칭뤼로 해안 산책로와 위안밍신위안 등 여유로운 휴양 분위기를 갖추고 있다.","known_for":["마카오 접경","칭뤼로 해안선","위안밍신위안","치아오섬"],"lat":22.27,"lng":113.57,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광둥","city":"포산","local":"佛山 / Foshan","kind":"대도시","desc":"광저우 남서쪽에 인접한 영남 문화와 영춘권·황비홍 등 무술의 발상지. 도자기 공예와 조묘(祖庙) 사당 건축으로 유명하다.","known_for":["포산 조묘","영춘권·무술 발상지","난펑고가마","사자춤"],"lat":23.02,"lng":113.12,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광둥","city":"순더","local":"顺德 / Shunde","kind":"중소도시","desc":"포산 남부의 수향이자 유네스코 미식 창의 도시. 광둥 전통 요리의 진수를 맛볼 수 있는 식도락 여행지다.","known_for":["순더 요리","칭후이위안","이중우유(쌍피나이)","펑젠 수향"],"lat":22.8,"lng":113.29,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"광둥","city":"둥관","local":"东莞 / Dongguan","kind":"대도시","desc":"광저우와 선전 사이에 위치한 세계 제조업의 중심지. 아편전쟁의 시발점인 후먼 포대 유적과 커위안 정원이 있다.","known_for":["후먼 아편 소각지","커위안","제조업 허브","쑹산호"],"lat":23.02,"lng":113.75,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광둥","city":"중산","local":"中山 / Zhongshan","kind":"중소도시","desc":"신해혁명을 이끈 쑨원(손문)의 고향. 서양식 치루 건축이 늘어선 순원시로 보행자 거리와 손문 고거가 있다.","known_for":["쑨원 고향","순원시로 보행가","치루 건축","중산 요리"],"lat":22.5333,"lng":113.35,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광둥","city":"장먼","local":"江门 / Jiangmen","kind":"중소도시","desc":"주강 서쪽에 위치한 화교들의 주요 고향(오읍 문화권). 드라마 '광표(狂飙)' 촬영지로 유명해진 치루 옛 거리와 원림이 있다.","known_for":["화교 고향","33허 옛거리","광표 촬영지","치루 거리"],"lat":22.58,"lng":113.08,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"광둥","city":"카이핑","local":"开平 / Kaiping","kind":"소도시","desc":"동서양 양식이 융합된 독특한 수비형 다층 가옥 '카이핑 댜오러우'로 유명한 유네스코 세계유산 도시. 영화 '양자탄비' 촬영지이자 전원 풍경이 아름답다.","known_for":["카이핑 댜오러우","츠칸 고진","마샹롱 촌락","세계문화유산"],"lat":22.3763,"lng":112.6877,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광둥","city":"타이산","local":"台山 / Taishan","kind":"소도시","desc":"초기 북미 이민자 다수의 고향으로 '중국 제1의 교향(侨乡)'이라 불린다. 서양식 건축의 매가대원(梅家大院)과 온천, 해안선이 특징이다.","known_for":["교향 문화","매가대원","온천","해안 섬"],"lat":22.2486,"lng":112.785,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광둥","city":"후이저우","local":"惠州 / Huizhou","kind":"중소도시","desc":"소동파가 유배 생활을 했던 서호(西湖)와 해안 절경으로 이름난 도시. 뤄푸산(罗浮山) 도교 명산과 솽웨완 해변 리조트가 있다.","known_for":["후이저우 서호","뤄푸산","솽웨완","소동파 유적"],"lat":23.08,"lng":114.41,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광둥","city":"차오저우","local":"潮州 / Chaozhou","kind":"중소도시","desc":"차오산 문화의 핵심 고도로 유서 깊은 성벽과 광제교(广济桥)로 대표된다. 쿵푸차(공부차)와 독창적인 차오저우 요리 문화가 발달했다.","known_for":["광제교","파이팡제","차오저우 요리","공부차"],"lat":23.67,"lng":116.63,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광둥","city":"산터우","local":"汕头 / Shantou","kind":"중소도시","desc":"청말 개항장으로 번성했던 차오산 지역 최대 항구 도시이자 경제특구. 소고기 훠궈의 본고장이자 백년 역사의 샤오궁위안 옛 거리가 있다.","known_for":["소고기 훠궈","샤오궁위안 치루","차오산 미식","개항 문화"],"lat":23.37,"lng":116.68,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광둥","city":"제양","local":"揭阳 / Jieyang","kind":"중소도시","desc":"차오산 서부의 유서 깊은 도시로 옥석(옥기) 거래의 아시아 최대 중심지. 제양 공묘와 진원루 고대 성루가 보존되어 있다.","known_for":["아시아 옥의 수도","제양 공묘","진원루","용호고채"],"lat":23.54,"lng":116.37,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광둥","city":"푸닝","local":"普宁 / Puning","kind":"소도시","desc":"제양 관할의 상업 및 한약재 유통 중심지. 차오산 전통 영가(英歌) 춤의 본고장 중 하나로 활기찬 민속 문화를 자랑한다.","known_for":["영가무(英歌舞)","약재 시장","덕정석묘","민속 문화"],"lat":23.298,"lng":116.166,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광둥","city":"산웨이","local":"汕尾 / Shanwei","kind":"중소도시","desc":"주강삼각주와 차오산 사이에 걸쳐 있는 해안 도시. 저랑 반도(차령 반도)의 백사장과 신선한 해산물, 홍궁·홍루 혁명 유적이 있다.","known_for":["저랑 반도","해산물 미식","홍궁홍루","봉산조모"],"lat":22.7844,"lng":115.3653,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광둥","city":"루펑","local":"陆丰 / Lufeng","kind":"소도시","desc":"산웨이 관할의 해안 도시로 유서 깊은 현무산(玄武山) 원산사 도교 사원과 아름다운 갈미석(碣石) 해안선이 있다.","known_for":["현무산 원산사","갈석위 옛 진지","해안 사원","민속 축제"],"lat":22.9188,"lng":115.6521,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광둥","city":"난아오섬","local":"南澳岛 / Nan'ao Island","kind":"섬","desc":"산터우 앞바다에 위치한 광둥성 유일의 도서현(섬 전체). 칭아오만 해수욕장과 해안 풍력 발전기, 난아오 대교 풍경이 유명하다.","known_for":["청오만 해변","난아오 대교","총병부 유적","해안 풍차"],"lat":23.44,"lng":117.02,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"광둥","city":"메이저우","local":"梅州 / Meizhou","kind":"중소도시","desc":"세계 하카(객가, 客家) 문화의 수도로 불리는 산간 도시. 원형 하카 토루(위룽우)와 객가 전통 요리(염계, 양두부)가 전해진다.","known_for":["하카 객가 문화","위룽우(围龙屋)","옌난페이 차밭","객가 요리"],"lat":24.2998,"lng":116.1191,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광둥","city":"허위안","local":"河源 / Heyuan","kind":"중소도시","desc":"광둥 중북부의 생태 도시로 세계에서 공룡 알 화석이 가장 많이 발견된 곳. 수백 개의 섬이 떠 있는 완뤼호(万绿湖) 청정 호수가 있다.","known_for":["완뤼호","공룡 화석 박물관","객가 고촌락","온천"],"lat":23.73,"lng":114.69,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광둥","city":"사오관","local":"韶关 / Shaoguan","kind":"중소도시","desc":"광둥 최북단의 관문 도시이자 선종 불교의 발상지 난화사(南华寺)가 있는 곳. 야오족 소수민족 문화와 수려한 산악 경관을 품고 있다.","known_for":["난화사(혜능 대사)","풍채루","야오족 문화","북부 산악지대"],"lat":24.8011,"lng":113.5927,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광둥","city":"단샤산","local":"丹霞山 / Danxiashan","kind":"자연지역","desc":"붉은 사암 침식 지형인 '단샤 지형'의 명칭 기원이 된 유네스코 세계자연유산. 기기묘묘한 붉은 봉우리와 진강(锦江) 유람선이 유명하다.","known_for":["세계자연유산","단샤 지형","양원석·음원석","장로봉 일출"],"lat":25.031,"lng":113.744,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광둥","city":"칭위안","local":"清远 / Qingyuan","kind":"중소도시","desc":"광저우 북쪽에 인접한 산수 관광 도시. 급류 래프팅과 천연 온천, 칭위안 닭 요리로 널리 알려져 있다.","known_for":["급류 래프팅","온천 휴양","칭위안 닭","황등협 계곡"],"lat":23.6843,"lng":113.0508,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광둥","city":"잉더","local":"英德 / Yingde","kind":"소도시","desc":"칭위안 관할의 소도시로 '영남 제1의 봉림'이라 불리는 영서봉림(카르스트 봉우리) 경관을 자랑한다. 전통 잉더 홍차 산지이기도 하다.","known_for":["영서봉림(英西峰林)","잉더 홍차","동천선경(동굴)","보둔봉"],"lat":24.18,"lng":113.41,"sources":["Trip.com","마펑워","네이버 블로그"],"note":""},{"country":"중국","region":"광둥","city":"롄저우","local":"连州 / Lianzhou","kind":"소도시","desc":"광둥 북단 후난 국경 부근의 역사 깊은 산간 도시. 거대한 종유석 동굴 속 배를 타는 롄저우 지하하천과 황천삼협 절경이 있다.","known_for":["롄저우 지하하천","황천삼협","롄저우 국제사진축전","카르스트 동굴"],"lat":24.78,"lng":112.38,"sources":["Trip.com","마펑워"],"note":""},{"country":"중국","region":"광둥","city":"롄남","local":"连南 / Liannan","kind":"마을","desc":"광둥 북부 야오족(瑶族) 자치현으로 1,000년 역사를 간직한 천년 요채(千年瑶寨)가 산비탈에 자리 잡고 있다. 독특한 민속 춤과 산지 목조 가옥이 보존되어 있다.","known_for":["천년 요채(千年瑶寨)","야오족 문화","장고춤","계단식 논"],"lat":24.72,"lng":112.28,"sources":["Trip.com","마펑워","네이버 블로그"],"note":""},{"country":"중국","region":"광둥","city":"자오칭","local":"肇庆 / Zhaoqing","kind":"중소도시","desc":"주강 상류 서강(西江) 변의 고도로 칠성암(七星岩) 카르스트 호수와 딩후산(鼎湖山) 국가자연보호구로 유명하다. 중국 4대 벼루 중 으뜸인 단계연의 본고장이다.","known_for":["칠성암","딩후산 자연보호구","단계연(벼루)","자오칭 고성벽"],"lat":23.05,"lng":112.47,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광둥","city":"윈푸","local":"云浮 / Yunfu","kind":"중소도시","desc":"광둥 중서부 산지에 위치한 석재 가공과 대리석 조각의 중심지. 판룽동(蟠龙洞) 카르스트 석회동굴과 국은사(선종 육조 혜능의 열반지)가 있다.","known_for":["석재 조각","국은사","판룽동","카르스트 동굴"],"lat":22.93,"lng":112.04,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광둥","city":"잔장","local":"湛江 / Zhanjiang","kind":"중소도시","desc":"레이저우 반도 동부에 위치한 해군 기지이자 과거 프랑스 조계지(광저우만) 역사를 지닌 항구 도시. 해산물 굴 구이와 프랑스풍 근대 건축물이 보존되어 있다.","known_for":["프랑스 조계지 건축","잔장 생굴구이","후광암 화산호","남해 함대"],"lat":21.1967,"lng":110.4031,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광둥","city":"레이저우","local":"雷州 / Leizhou","kind":"소도시","desc":"레이저우 반도의 역사적 문화 중심지로 석구(돌개, 石狗) 민간 신앙 조각상 문화로 유명하다. 삼원탑과 레이저우 서원 등 유서 깊은 유적이 많다.","known_for":["석구(돌개) 문화","삼원탑","레이저우 서원","민속 신앙"],"lat":20.91,"lng":110.09,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광둥","city":"쉬원","local":"徐闻 / Xuwen","kind":"소도시","desc":"중국 대륙의 최남단 곶에 위치하여 하이난섬으로 향하는 페리가 출발하는 항구 소도시. 광활한 '파인애플의 바다(菠萝的海)' 구릉 밭이 장관을 이룬다.","known_for":["중국 대륙 최남단","파인애플의 바다","하이난 페리 항구","해상 실크로드 출발지"],"lat":20.33,"lng":110.17,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광둥","city":"나오저우섬","local":"硇洲岛 / Naozhou Island","kind":"섬","desc":"잔장 앞바다의 해저 화산 폭발로 형성된 화산섬. 세계에 단 두 곳뿐인 수정 렌즈 등대(나오저우 등대)와 화산 암석 해안이 보존되어 있다.","known_for":["나오저우 등대","화산암 지형","바다거북 보호구역","어촌 풍경"],"lat":20.9,"lng":110.59,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광둥","city":"마오밍","local":"茂名 / Maoming","kind":"중소도시","desc":"광둥 서부 해안 도시로 중국 최대의 여지(리치) 생산지. 낭만해안(浪漫海岸) 리조트와 방천부인(冼夫人) 사당 유적이 있다.","known_for":["리치(여지) 산지","낭만해안","방천부인 유적","어항 미식"],"lat":21.66,"lng":110.92,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광둥","city":"양장","local":"阳江 / Yangjiang","kind":"중소도시","desc":"광둥 남서부 해안 도시로 주방용 칼·가위 제조와 연날리기 전통으로 유명하다. 하이링섬(海陵岛) 휴양지와 송나라 난파선 '남해1호' 박물관이 있다.","known_for":["하이링섬(십리은탄)","남해1호 박물관","전통 연날리기","양장 칼"],"lat":21.86,"lng":111.98,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광둥","city":"하이링섬","local":"海陵岛 / Hailing Island","kind":"섬","desc":"양장에 딸린 유명 섬 휴양지로 '중국에서 가장 아름다운 섬 10곳'에 선정된 바 있다. 십리은탄(十里银滩) 백사장과 해상 실크로드 박물관이 위치한다.","known_for":["십리은탄","대각만 해변","해상 실크로드 박물관","신선한 해산물"],"lat":21.6,"lng":111.88,"sources":["Trip.com","마펑워","네이버 블로그"],"note":""},{"country":"중국","region":"광시","city":"난닝","local":"南宁 / Nanning","kind":"대도시","desc":"광시 좡족 자치구의 수부(성도)이자 베트남으로 향하는 육로 국제 교통의 중심지. 사계절 녹음이 우거진 '녹색 도시'로 칭슈산(청수산)과 중산로 야시장이 유명하다.","known_for":["베트남 국제열차 시발점","청수산 풍경구","중산로 야시장","녹색 도시"],"lat":22.817,"lng":108.367,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광시","city":"구이린","local":"桂林 / Guilin","kind":"중소도시","desc":"'계림산수 갑천하(계림 산수가 천하제일)'로 불리는 세계적인 카르스트 산수 풍경의 중심지. 리강 유람선, 상비산, 양삭으로 이어지는 수려한 봉우리들이 절경을 이룬다.","known_for":["리강 유람","상비산","카르스트 봉우리","구이린 쌀국수(미펀)"],"lat":25.274,"lng":110.29,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광시","city":"양숴","local":"阳朔 / Yangshuo","kind":"소도시","desc":"구이린 남쪽 리강 하류의 카르스트 봉우리로 둘러싸인 세계적인 여행자 타운. 위룽강 뗏목 유람과 서가(西街) 보행자 거리, 암벽등반과 시골 자전거 투어로 유명하다.","known_for":["위룽강 대나무 뗏목","양숴 서가","인상유삼저","자전거·암벽등반"],"lat":24.778,"lng":110.491,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광시","city":"싱핑","local":"兴坪 / Xingping","kind":"마을","desc":"중국 20위안 지폐 뒷면 풍경의 실제 배경이 된 유서 깊은 리강 변의 어촌 마을. 수천 년 역사의 고진 거리와 라오자이산(노채산) 일몰 전망 포인트가 있다.","known_for":["20위안 지폐 배경","노채산 일몰 전망","싱핑 고진","가마우지 낚시"],"lat":24.922,"lng":110.528,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"광시","city":"룽성","local":"龙胜 / Longsheng","kind":"소도시","desc":"구이린 북부 산간의 좡족·요족 자치현으로 세계적으로 유명한 룽지 제전(용척 계단식 논)이 있다. 붉은 옷을 입는 홍요족 여성들의 긴 머리 전통과 산속 온천이 있다.","known_for":["용척 계단식 논","홍요족 긴머리 전통","평안 장족 마을","온천 휴양"],"lat":25.797,"lng":110.007,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광시","city":"류저우","local":"柳州 / Liuzhou","kind":"대도시","desc":"광시 최대의 공업 도시이자 중국 전역을 휩쓴 매콤한 우렁이 쌀국수 '뤄쓰펀(螺蛳粉)'의 본고장. 류강(柳江)이 카르스트 도심을 굽이돌며 밤 분수 쇼와 야경이 화려하다.","known_for":["뤄쓰펀 본고장","류강 야경","마안산 전망대","카르스트 도시공원"],"lat":24.326,"lng":109.428,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광시","city":"싼장","local":"三江 / Sanjiang","kind":"소도시","desc":"류저우 북쪽의 동족(侗族, 둥족) 자치현으로 못을 전혀 쓰지 않고 지은 독특한 목조 고루(鼓楼)와 풍우교로 가득한 전통문화의 보고다.","known_for":["삼강 풍우교","삼강 고루","동족 대가(大歌)","목조 건축"],"lat":25.783,"lng":109.608,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광시","city":"청양","local":"程阳 / Chengyang","kind":"마을","desc":"싼장 인근에 위치한 8개의 동족 마을 '청양 팔채(程阳八寨)'. 세계 4대 역사 명교 중 하나로 꼽히는 청양 영제교(풍우교)와 평화로운 논 풍경이 보존되어 있다.","known_for":["청양 영제교(풍우교)","동족 팔채 촌락","백가연(전통 연회)","물레방아 전원풍경"],"lat":25.906,"lng":109.643,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"광시","city":"이저우","local":"宜州 / Yizhou","kind":"소도시","desc":"허츠 관할로 전설적인 좡족 노래의 여신 '류삼저(刘三姐)'의 고향. 하강(下枧河)을 따라 펼쳐지는 덜 붐비고 목가적인 카르스트 풍경이 아름답다.","known_for":["류삼저 고향","하강 유람","카르스트 봉우리","산가(山歌) 민요"],"lat":24.693,"lng":108.653,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광시","city":"허츠","local":"河池 / Hechi","kind":"중소도시","desc":"광시 서북부의 카르스트 산악 도시이자 백룡동 석회동굴과 홍수하(红水河) 협곡의 거점. 좡족·야오족 등 다양한 소수민족 문화가 어우러져 있다.","known_for":["홍수하 협곡","백룡동 동굴","소수민족 문화","카르스트 산악"],"lat":24.696,"lng":108.037,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광시","city":"바이써","local":"百色 / Baise","kind":"중소도시","desc":"윈난·구이저우와 접경하는 광시 서부의 요충지이자 덩샤오핑의 백색봉기 유적지. 대규모 망고 재배지와 거대한 카르스트 협곡 수계가 분포한다.","known_for":["백색봉기 기념관","망고 산지","징시 거점","운남·귀주 접경"],"lat":23.898,"lng":106.618,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광시","city":"징시","local":"靖西 / Jingxi","kind":"소도시","desc":"베트남 국경 인근에 위치한 청정한 산수 도시. 아천(鹅泉, 아시아 3대 지하 용천)과 통령대협곡(通灵大峡谷)의 원시림 폭포 절경으로 여행자들에게 각광받고 있다.","known_for":["아천(거취안 용천)","통령대협곡","구주 고진(수놓은 비단공)","베트남 접경"],"lat":23.134,"lng":106.419,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"광시","city":"충쭤","local":"崇左 / Chongzuo","kind":"중소도시","desc":"베트남과 긴 국경을 맞닿은 도시로 좌강(左江)을 따라 카르스트 봉우리들이 끝없이 펼쳐진다. 백두엽원숭이 보호구와 명사전원(明仕田园)의 여유로운 시골 풍경이 유명하다.","known_for":["명사전원","백두엽원숭이 보호구","좌강 카르스트","베트남 국경 지대"],"lat":22.374,"lng":107.365,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광시","city":"더톈","local":"德天 / Detian","kind":"자연지역","desc":"중국과 베트남 국경을 가로지르는 아시아 최대의 다단 국경 폭포인 더톈 폭포(베트남명 반족 폭포). 뗏목을 타고 국경 강 위에서 폭포를 감상할 수 있다.","known_for":["더톈 폭포(국경 폭포)","귀춘하 뗏목","국경 비석 마켓","중-베 국경 관광구"],"lat":22.854,"lng":106.723,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광시","city":"닝밍","local":"宁明 / Ningming","kind":"소도시","desc":"좌강 유역의 절벽에 그려진 유네스코 세계문화유산 '좌강 화산 암벽화(花山岩画)'의 출발 기점. 고대 낙월족(좡족 선조)이 남긴 수천 년 전의 붉은 신비로운 암각화가 보존되어 있다.","known_for":["좌강 화산 암벽화(세계문화유산)","낙월족 고대 문화","명강 유람선","카르스트 절벽"],"lat":22.135,"lng":107.073,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광시","city":"룽저우","local":"龙州 / Longzhou","kind":"소도시","desc":"청말 프랑스와의 조약으로 광시 최초로 개항했던 유서 깊은 국경 소도시. 프랑스 영사관 옛 건물과 호찌민의 초기 혁명 활동 거점 유적이 남아 있다.","known_for":["프랑스 영사관 유적","호찌민 혁명 유적","국경 무역 고을","좌강 풍경"],"lat":22.345,"lng":106.854,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광시","city":"핑샹 (광시)","local":"凭祥 / Pingxiang","kind":"소도시","desc":"중국과 베트남을 잇는 가장 중요한 육로 관문 도시. 2천 년 역사의 남방 명관 '우의관(友谊关)'을 통해 베트남 랑선으로 도보 및 차량 국경 통과가 가능하다.","known_for":["우의관(육로 국경)","포태산 유적","중-베 홍목 가구 시장","국경 무역"],"lat":22.096,"lng":106.757,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광시","city":"구이강","local":"贵港 / Guigang","kind":"중소도시","desc":"서강(西江) 수운의 핵심 내륙 항구 도시이자 '연꽃의 도시(하성)'. 남산사의 천년 고찰과 수려한 하천 수운 경관이 있다.","known_for":["내륙 수운 항구","남산사","연꽃 공원","평천고성"],"lat":23.097,"lng":109.602,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광시","city":"구이핑","local":"桂平 / Guiping","kind":"소도시","desc":"태평천국 운동의 시발점인 금전봉기(金田起义) 유적지가 위치한 역사 도시. 불교 성지이자 녹차 산지인 계평 서산(西山)과 룽탄 국립산림공원이 있다.","known_for":["태평천국 금전봉기 유적","계평 서산","서산차","용탄 국립산림공원"],"lat":23.394,"lng":110.081,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광시","city":"라이빈","local":"来宾 / Laibin","kind":"중소도시","desc":"광시 지리적 중심에 위치한 '세계 사탕수수의 수도'. 진샨 협곡과 고대 치린산 유인원 화석지, 야오족 문화가 남아 있다.","known_for":["사탕수수 산지","진샨 협곡","성당산","야오족 자치향"],"lat":23.734,"lng":109.23,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광시","city":"우저우","local":"梧州 / Wuzhou","kind":"중소도시","desc":"광둥성과 인접한 서강 상류의 백년 상업 항구. 영남 지역 최대 규모의 아케이드 건축군인 '치루 성(骑楼城)'과 전통 약선 디저트 '귀령고(龟苓膏)'의 본고장이다.","known_for":["우저우 치루성","귀령고 본고장","종산 공원","영남 수운 고도"],"lat":23.477,"lng":111.317,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광시","city":"멍산","local":"蒙山 / Mengshan","kind":"소도시","desc":"우저우 북부의 유서 깊은 산간 고을이자 신파 무협소설의 거장 양우생(梁羽生)의 고향. 태평천국 초기 왕들이 책봉되었던 영안주성(永安州城) 성벽 유적이 있다.","known_for":["양우생 고향","태평천국 영안주성 유적","서포 고촌","야오족 촌락"],"lat":24.202,"lng":110.522,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광시","city":"허저우","local":"贺州 / Hezhou","kind":"중소도시","desc":"광둥·후난과의 접경에 위치한 다민족 장수 도시. 고산 카르스트 온천과 옥석림(玉石林), 고즈넉한 명청대 전통 촌락들이 잘 보존되어 있다.","known_for":["허저우 옥석림","고산 온천","객가 원형 위루","소수민족 문화"],"lat":24.404,"lng":111.552,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광시","city":"황야오","local":"黄姚 / Huangyao","kind":"마을","desc":"허저우 관할의 천년 역사를 품은 카르스트 고진(수향 마을). 청나라 때 깔린 돌바닥 골목길과 반얀나무(용수), 옛 서원과 개울 징검다리가 영화 촬영지로 사랑받는다.","known_for":["황야오 고진","천년 징검다리","용수 고목","돌바닥 옛골목"],"lat":24.164,"lng":111.312,"sources":["Trip.com","마펑워","네이버 블로그"],"note":""},{"country":"중국","region":"광시","city":"베이하이","local":"北海 / Beihai","kind":"중소도시","desc":"통킹만(북부만) 연안의 대표적인 해안 휴양 도시. 고운 백사장이 수 킬로미터 이어진 '은탄(银滩)'과 19세기 서양 영사관·상점 치루가 늘어선 옛 거리가 있다.","known_for":["베이하이 은탄","백년 옛거리(치루)","통킹만 해산물","해안 휴양"],"lat":21.481,"lng":109.12,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광시","city":"웨이저우섬","local":"涠洲岛 / Weizhou Island","kind":"섬","desc":"중국에서 가장 젊은 화산섬이자 베이하이 앞바다의 화산 국립지질공원. 19세기 프랑스 선교사들이 산호석으로 지은 고딕 양식 성당과 악어산 해식 지형이 유명하다.","known_for":["화산 지질공원(악어산)","산호석 천주교당","일출·일몰 해변","스쿠터 섬 일주"],"lat":21.047,"lng":109.117,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"광시","city":"팡청강","local":"防城港 / Fangchenggang","kind":"중소도시","desc":"베트남과 육지와 바다로 모두 접하는 서남부 최대의 심수항 도시. 백랑탄(白浪滩) 흑모래 해변과 십만대산(十万大山) 원시림 국립공원이 있다.","known_for":["십만대산 국립공원","백랑탄 해변","베트남 해상 관문","신선한 해산물"],"lat":21.687,"lng":108.354,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광시","city":"둥싱","local":"东兴 / Dongxing","kind":"소도시","desc":"북륜하(北仑河)를 사이에 두고 베트남 몽까이(Mong Cai)와 마주 보는 국경 도시. 도보 국경 대교와 중국 유일의 해양 소수민족인 징족(京族, 킨족) 마을, 금탄(金滩) 해변이 있다.","known_for":["중-베 국경 도보 통과","북륜하 국경 대교","징족(경족) 문화","금탄 해변"],"lat":21.543,"lng":107.97,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광시","city":"친저우","local":"钦州 / Qinzhou","kind":"중소도시","desc":"북부만 연안의 유서 깊은 항만 도시로 중국 4대 도자기 중 하나인 니흥도(坭兴陶)의 산지. 삼랑만(三娘湾) 앞바다에서 희귀한 중화백돌고래(분홍돌고래)를 관찰할 수 있다.","known_for":["삼랑만 분홍돌고래","니흥도 도자기","팔채곡","유영복 고거"],"lat":21.96,"lng":108.624,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광시","city":"위린 (광시)","local":"玉林 / Yulin","kind":"중소도시","desc":"광시 동남부의 상업 도시이자 영남 문화의 중심지 중 하나. 거대한 궁전 건축물인 운천궁(云天宫)과 못을 쓰지 않고 지은 명나라 목조 진무각(真武阁)이 보존되어 있다.","known_for":["운천궁","용륵사 진무각","사탕수수·약재 시장","영남 문화"],"lat":22.637,"lng":110.154,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"광시","city":"바마","local":"巴马 / Bama","kind":"소도시","desc":"세계 5대 장수촌 중 하나로 꼽히는 국제 장수 양생 거점. 맑은 천연 암반수와 백마동(百魔洞), 백조암(百鸟岩) 등 기이한 카르스트 수저 동굴이 힐링 여행지로 인기다.","known_for":["세계 장수향(장수촌)","백마동 석회동굴","백조암 수중동굴","반양하 양생"],"lat":24.141,"lng":107.253,"sources":["Trip.com","마펑워","네이버 블로그"],"note":""},{"country":"중국","region":"광시","city":"러예","local":"乐业 / Leye","kind":"소도시","desc":"세계 지질공원으로 지정된 세계 최대 규모의 싱크홀 군락인 '다스웨이 톈컹군(大石围天坑群)'의 소재지. 깎아지른 수직 절벽과 원시 지하림 생태계가 장관이다.","known_for":["다스웨이 톈컹(거대 싱크홀)","세계지질공원","지하 원시림","동굴 탐사"],"lat":24.783,"lng":106.561,"sources":["Trip.com","마펑워"],"note":""},{"country":"중국","region":"하이난","city":"하이커우","local":"海口 / Haikou","kind":"대도시","desc":"하이난성의 성도이자 북부 관문 도시. 백년 역사의 치루 옛거리(기루노가)와 화산구 국립지질공원, 여유로운 로컬 해변이 있다.","known_for":["하이커우 치루 옛거리","화산구 지질공원","완뤼위안","하이난 면요리"],"lat":20.0202,"lng":110.3303,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"하이난","city":"싼야","local":"三亚 / Sanya","kind":"중소도시","desc":"하이난 최남단에 위치한 중국 최고의 열대 해변 휴양 도시. 톈야하이자오(천애해각), 108m 남산해상관음상, 녹회두 공원이 유명하다.","known_for":["천애해각","남산 해상관음","대동해·야룽만","열대 해변 휴양"],"lat":18.2508,"lng":109.5097,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"하이난","city":"완닝","local":"万宁 / Wanning","kind":"중소도시","desc":"하이난 동해안에 위치한 중국 서핑의 성지이자 커피 향기 가득한 도시. 르웨완(일월만)의 국제 서핑 해변과 싱룽 화교 열대 식물원이 유명하다.","known_for":["일월만 서핑","싱룽 커피","신저우 반도 등대","바리촌 화교 문화"],"lat":18.7953,"lng":110.3886,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"하이난","city":"링수이","local":"陵水 / Lingshui","kind":"소도시","desc":"싼야 북동쪽에 인접한 리족 자치현으로 맑은 에메랄드빛 바다가 펼쳐진다. 원숭이들이 자유롭게 서식하는 남만 원숭이섬과 다이빙 명소 분계주도가 있다.","known_for":["남만 원숭이섬","분계주도","청수만 백사장","단가족 수상마을"],"lat":18.508,"lng":110.0345,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"하이난","city":"충하이","local":"琼海 / Qionghai","kind":"중소도시","desc":"완취안강(만천강) 하구에 위치한 전원 풍경 도시. 중국 홍군 여성 부대의 역사를 기리는 붉은 여군 유적지와 하이난 4대 요리 중 하나인 가적오리가 유명하다.","known_for":["만천강 풍경","붉은 여군 기념원","가적오리","옥대탄 하구"],"lat":19.2431,"lng":110.4642,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"하이난","city":"보아오","local":"博鳌 / Bo'ao","kind":"소도시","desc":"충하이 관할의 유명 해변 마을로 매년 보아오 아시아 포럼이 개최되는 곳. 민물 강과 바다를 가르는 세계에서 가장 좁은 모래반도인 '옥대탄(玉带滩)'이 있다.","known_for":["보아오 아시아 포럼 영구회원","옥대탄 모래톱","보아오 옛마을","성선원"],"lat":19.1617,"lng":110.5823,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"하이난","city":"원창","local":"文昌 / Wenchang","kind":"중소도시","desc":"하이난 문화의 요람이자 동남아 화교들의 주요 고향. 중국 유일의 해안 우주발사기지와 동교 야자림, 대표 요리 원창 닭의 발상지다.","known_for":["문창계(원창 닭)","원창 위성발사센터","동교 야자림","동포 서원"],"lat":19.5488,"lng":110.7972,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"하이난","city":"단저우","local":"儋州 / Danzhou","kind":"중소도시","desc":"하이난 서북부의 역사 문화 도시로 북송의 대문호 소동파가 유배 생활을 했던 동파서원(东坡书院)이 있다. 1,200년 역사의 천년고염전에서 옛 소금 제조 방식을 볼 수 있다.","known_for":["동파서원","천년고염전","하이화다오","단저우 산가"],"lat":19.523,"lng":109.577,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"하이난","city":"하이화다오","local":"海花岛 / Ocean Flower Island","kind":"섬","desc":"단저우 북부 해안에 꽃 모양으로 조성된 세계 최대 규모의 인공 섬 복합 리조트. 테마파크, 해양세계, 박물관 군락 및 화려한 야간 조명 쇼가 펼쳐진다.","known_for":["인공섬 복합리조트","해양공원","국제회의센터","야간 조명쇼"],"lat":19.704,"lng":109.183,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"하이난","city":"청마이","local":"澄迈 / Chengmai","kind":"소도시","desc":"세계적으로 공인된 '장수의 고향'으로 풍부한 셀레늄 토양과 깨끗한 자연환경을 지녔다. 푸산(福山) 커피 원산지 문화진과 유서 깊은 홍덕사 석탑이 있다.","known_for":["장수의 고향","푸산 커피 문화","미랑 쌍탑","금산사"],"lat":19.752,"lng":110.016,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"하이난","city":"딩안","local":"定安 / Ding'an","kind":"소도시","desc":"하이커우 남쪽에 위치한 유서 깊은 고을로 명청대 옛 성벽이 남은 딩안 고성이 보존되어 있다. 하이난 도교의 중심 성지인 문필봉(文笔峰) 반고문화원이 있다.","known_for":["문필봉 도교성지","딩안 고성","남려호 풍경구","정안 흑돼지"],"lat":19.698,"lng":110.352,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"하이난","city":"린가오","local":"临高 / Lingao","kind":"소도시","desc":"하이난 서북부의 해안 고을로 국공내전 당시 인민해방군이 하이난에 상륙했던 린가오자오(临高角) 해안 등대가 유명하다. 전통 구운 아기돼지 통구이 요리가 별미다.","known_for":["린가오자오 상륙기념지","린가오 통돼지구이","후호어선 어항","리어 민요"],"lat":19.915,"lng":109.688,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"하이난","city":"둥팡","local":"东方 / Dongfang","kind":"중소도시","desc":"하이난 서부 해안의 햇살 가득한 도시로 서해안 풍력 발전용 풍차 해변과 어롱두(鱼鳞洲) 등대 일몰이 유명하다. 황화리(자단목) 전통 목공예의 본고장이다.","known_for":["어롱두 등대 일몰","해안 풍력발전기","황화리 목공예","대전 슬로로리스 자연보호구"],"lat":19.0973,"lng":108.6484,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"하이난","city":"러둥","local":"乐东 / Ledong","kind":"소도시","desc":"하이난 서남부의 리족 자치현으로 중국 최대의 열대 원시림 국립공원인 젠펑링(尖峰岭)을 품고 있다. 바다와 맞닿은 잉거하이 천일염전의 광활한 소금밭 풍경이 장관이다.","known_for":["젠펑링 열대우림","잉거하이 소금밭","천불포","리족 전통문화"],"lat":18.748,"lng":109.175,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"하이난","city":"창장","local":"昌江 / Changjiang","kind":"소도시","desc":"하이난 서북부 산간의 리족 자치현으로 세계적 희귀종 하이난 흑볏긴팔원숭이의 마지막 서식처인 패왕령이 있다. 봄철 창화강을 붉게 물들이는 목면화 축제가 유명하다.","known_for":["패왕령 긴팔원숭이 보호구","목면화 봄꽃 축제","기자만 해변 바위","창화강 풍경"],"lat":19.261,"lng":109.053,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"하이난","city":"우즈산","local":"五指山 / Wuzhishan","kind":"소도시","desc":"하이난섬의 심장부에 위치한 최고봉(해발 1,867m) 우즈산(오지산)의 거점 도시. 다섯 손가락 모양의 봉우리와 울창한 열대림, 리족·먀오족 민족 박물관이 있다.","known_for":["오지산 최고봉","열대우림 트레킹","리족·묘족 전통박물관","수만 계류 래프팅"],"lat":18.777,"lng":109.5129,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"하이난","city":"바오팅","local":"保亭 / Baoting","kind":"소도시","desc":"싼야 북쪽 산간의 리족·먀오족 자치현으로 칠선령(七仙岭) 천연 온천과 야노다(呀诺达) 열대우림, 빈랑곡(槟榔谷) 무형문화유산 마을이 위치한 힐링 생태 관광지다.","known_for":["칠선령 온천","야노다 열대우림","빈랑곡 민속문화촌","열대 과일 농원"],"lat":18.6379,"lng":109.7024,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"하이난","city":"충중","local":"琼中 / Qiongzhong","kind":"소도시","desc":"하이난섬 정중앙의 울창한 산간에 자리한 생태 녹색 고을. 낙차 수십 미터의 백화령(百花岭) 열대우림 폭포와 청정한 계곡, 리족 전통 직조 문화가 보존되어 있다.","known_for":["백화령 폭포","하이난 지리적 중심","리족 비단(여금)","청정 녹차"],"lat":19.0351,"lng":109.8339,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"하이난","city":"바이샤","local":"白沙 / Baisha","kind":"소도시","desc":"고산 분지 지형의 청정 산간 지대로 유명한 백사 녹차(白沙绿茶)의 산지. 수억 년 전 형성된 백사 운석 충돌구 분지와 고산 숲속 호수인 송도수고가 있다.","known_for":["백사 운무 녹차","운석 충돌구 분지","송도수고 저수지","원시 생태계"],"lat":19.2269,"lng":109.4631,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"하이난","city":"야룽만","local":"亚龙湾 / Yalong Bay","kind":"자연지역","desc":"'천하제일만'이라 불리는 싼야 동부의 7km 초승달 모양 백사장 해변. 잔잔한 파도와 투명한 바다, 열대천당삼림공원의 구름다리 전망대가 있다.","known_for":["야룽만 백사장","열대천당삼림공원","해양 스포츠","영화 비성물요2 촬영지"],"lat":18.213,"lng":109.638,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"하이난","city":"하이탕만","local":"海棠湾 / Haitang Bay","kind":"자연지역","desc":"싼야 북동쪽의 고급 해변 지구로 세계 최대 규모의 싼야 국제면세성(CDF)과 우즈저우섬(오지주도) 다이빙 기지가 위치한다.","known_for":["싼야 국제면세점","우즈저우섬 다이빙","아틀란티스 워터파크","코코넛 로드"],"lat":18.315,"lng":109.736,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"푸젠","city":"푸저우 (푸젠)","local":"福州 / Fuzhou","kind":"대도시","desc":"푸젠성의 성도이자 '용수(榕树)의 도시'. 명·청대 유서 깊은 고택 골목인 삼방칠항(三坊七巷)과 민강, 서호공원과 오랜 온천 문화가 보존되어 있다.","known_for":["삼방칠항","서호공원","우산·우탑","고산 풍경구","푸저우 어환"],"lat":26.0745,"lng":119.2965,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"푸젠","city":"샤먼","local":"厦门 / Xiamen","kind":"대도시","desc":"푸젠성 남부의 대표적인 항구 도시이자 경제특구. 아열대 해안 풍경과 천년고찰 남보타사, 중산로 보행가와 샤먼 대학 캠퍼스가 유명하다.","known_for":["남보타사","중산로 보행가","환도로 해변","샤먼 대학","증조안"],"lat":24.4798,"lng":118.0894,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"푸젠","city":"구랑위","local":"鼓浪屿 / Gulangyu","kind":"섬","desc":"샤먼 남서쪽 앞바다에 자리한 유네스코 세계문화유산 보행자 전용 섬. 19세기 조계지 서양 건축과 일광암, 숙장화원, 피아노 박물관이 있다.","known_for":["일광암","숙장화원","조계지 서양 건축","피아노 박물관","무차량 섬"],"lat":24.4447,"lng":118.0628,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"푸젠","city":"취안저우","local":"泉州 / Quanzhou","kind":"대도시","desc":"송·원대 해상 실크로드의 최대 무역항으로 유네스코 세계문화유산에 등재된 역사 도시. 개원사와 청정사 등 다채로운 종교 유적과 서가(西街) 옛 거리가 보존되어 있다.","known_for":["개원사 동서탑","청정사","서가(시제)","해상 실크로드 유적","낙양교"],"lat":24.8741,"lng":118.6757,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"푸젠","city":"장저우","local":"漳州 / Zhangzhou","kind":"대도시","desc":"샤먼 서남쪽에 인접한 구룡강 하구의 유서 깊은 민남 문화 도시. 명·청대 석패방이 보존된 장저우 고성과 수선화·포멜로(유자) 산지로 알려져 있다.","known_for":["장저우 고성","명청 석패방","남산사","구룡강","수선화"],"lat":24.513,"lng":117.6473,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"푸젠","city":"우이산","local":"武夷山 / Wuyishan","kind":"소도시","desc":"유네스코 세계복합유산(자연·문화)으로 등재된 명산이자 무이암차(대홍포)의 본고장. 붉은 단하 지형과 구곡계 대나무 뗏목 유람, 천유봉 절경이 빼어나다.","known_for":["구곡계 뗏목 유람","대홍포 차나무","천유봉","단하 지형","무이암차"],"lat":27.7554,"lng":118.0367,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"푸젠","city":"난징","local":"南靖 / Nanjing","kind":"소도시","desc":"푸젠 토루(흙 누각)의 핵심 분포지 중 하나. '사채일탕(네 접시와 한 그릇 국)'으로 불리는 전라갱(田螺坑) 토루군과 운수요(云水谣) 고진 수향 마을이 유명하다.","known_for":["전라갱 토루군","운수요 고진","화귀루","회원루","객가 토루"],"lat":24.5158,"lng":117.3683,"sources":["Wikivoyage","Trip.com","마펑워"],"note":"푸젠성 장저우시 산하 남정현(南靖, Nanjing). 장쑤성 남경(南京)이 아닌 토루 명소 남정현임"},{"country":"중국","region":"푸젠","city":"융딩","local":"永定 / Yongding","kind":"소도시","desc":"유네스코 세계유산 푸젠 토루의 대표적인 객가 토루 밀집 지역. '토루의 왕'이라 불리는 웅장한 원형 토루 승계루(承启楼)와 홍갱·초계 토루군이 있다.","known_for":["승계루(토루지왕)","홍갱 토루군","진성루","초계 토루군","객가 민속 문화"],"lat":24.7237,"lng":116.7324,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"푸젠","city":"핑탄","local":"平潭 / Pingtan","kind":"섬","desc":"푸젠성 최대이자 중국 본토에서 대만과 가장 가까운 섬. 밤바다를 푸르게 밝히는 '파란 눈물(남안루)' 야광충 현상과 북항촌 돌집 마을, 해안 풍차가 명소다.","known_for":["파란 눈물(남안루)","북항촌 석조 가옥","해안 풍차 도로","선인정","대만 최근접지"],"lat":25.5036,"lng":119.7912,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"푸젠","city":"둥산","local":"东山 / Dongshan","kind":"섬","desc":"장저우 남부 해상에 위치한 푸젠성 제2의 섬. 바닷가 절벽에 아슬아슬하게 얹힌 풍동석(风动石)과 알록달록한 어촌 골목 남문만(南门湾) 해변이 유명하다.","known_for":["풍동석","남문만 해안 마을","금란만","동문유嶼","해산물 미식"],"lat":23.7011,"lng":117.43,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"푸젠","city":"샤푸","local":"霞浦 / Xiapu","kind":"소도시","desc":"광활한 해안 갯벌(탄투)과 전통 미역·김 양식장이 어우러진 세계적인 갯벌 풍경 사진 촬영지. 북기(北岐) 일출과 소호(小皓) 일몰 경관이 대표적이다.","known_for":["북기 갯벌 일출","소호 해안 일몰","해조류 양식장 격자망","동벽 일몰","어촌 사진 촬영"],"lat":26.8858,"lng":120.0058,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"푸젠","city":"푸톈","local":"莆田 / Putian","kind":"대도시","desc":"푸저우와 취안저우 사이에 자리한 해양 여신 마조(妈祖) 신앙의 발상지. 남조 시대 천년고찰 광화사(广化寺)와 구려호 폭포 풍경구가 위치한다.","known_for":["마조 문화 발상지","광화사 석탑","구려호","목란파 수리유적","포멜로·용안"],"lat":25.454,"lng":119.0076,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"푸젠","city":"메이저우섬","local":"湄洲岛 / Meizhou Island","kind":"섬","desc":"푸톈시 앞바다에 자리한 전 세계 3억 마조 신도의 총본산. 웅장한 마조조묘(妈祖祖庙)와 황금빛 모래사장 구보초 해변이 펼쳐진 순례의 섬이다.","known_for":["마조조묘","마조 순례 성지","구보초 해수욕장","황금 해안선","아마석 기암"],"lat":25.074,"lng":119.1394,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"푸젠","city":"닝더","local":"宁德 / Ningde","kind":"중소도시","desc":"푸젠성 동북부 해안에 위치하며 천혜의 심수항 산도오(三都澳)만을 품은 도시. 세계적인 수상 어민 마을 '해상 부유성'과 백운산 국립공원이 있다.","known_for":["산도오 해상 수상가옥","백운산 빙천 유적","대황어 양식","사족(畲族) 자치문화"],"lat":26.6657,"lng":119.5479,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"푸젠","city":"싼밍","local":"三明 / Sanming","kind":"중소도시","desc":"푸젠성 내륙의 울창한 산간 지대에 위치한 녹색 생태 도시. 중국 전역에 퍼진 분식 브랜드 '사현소식(沙县小吃)'의 발상지이자 기린산 공원이 있다.","known_for":["사현소식 발상지","기린산 공원","옥화동 석회암 동굴","청정 산림 생태"],"lat":26.2634,"lng":117.6387,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"푸젠","city":"타이닝","local":"泰宁 / Taining","kind":"소도시","desc":"유네스코 세계지질공원이자 단하 지형 수변 비경으로 유명한 고을. 웅장한 협곡 호수인 대금호(大金湖)와 강남 최대 명대 관저인 상서제(尚书第)가 잘 보존되어 있다.","known_for":["대금호 단하 협곡","상서제 명대 고택","감로암 절벽 사찰","채하지 단하동굴"],"lat":26.9018,"lng":117.1764,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"푸젠","city":"룽옌","local":"龙岩 / Longyan","kind":"중소도시","desc":"푸젠 서부 산악 지대의 하카(객가) 문화 거점 도시. 명대 전통 누각 용천루와 유서 깊은 고전(古田) 회의 기념관이 자리한다.","known_for":["객가 문화 중심","고전회의 기념지","용천루","연성 관채산 관문"],"lat":25.0751,"lng":117.0179,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"푸젠","city":"창팅","local":"长汀 / Changting","kind":"소도시","desc":"옛 이름 정주(汀州)로 불리는 '객가의 수도'. 정강 강변을 따라 보존된 송·명대 고성벽과 제사문 성문, 점용교 회랑교가 고풍스러운 정취를 간직하고 있다.","known_for":["정주고성","송대 고성벽","제사문","점용교","정강 강변 야경"],"lat":25.8335,"lng":116.3575,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"푸젠","city":"롄청","local":"连城 / Liancheng","kind":"소도시","desc":"기묘한 단하 봉우리 관채산(冠豸山)과 청대 전통 객가 저택 30여 채가 보존된 배전고촌(培田古村)을 품은 유서 깊은 산간 고을이다.","known_for":["관채산 단하 풍경","배전고촌 객가 고택","석문호","구룡호"],"lat":25.7107,"lng":116.7547,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"푸젠","city":"난핑","local":"南平 / Nanping","kind":"중소도시","desc":"민강 상류 세 갈래 강물이 합류하는 수륙 교통 요충지. 울창한 망탕산(茫荡山) 삼림과 주자 성리학 유적, 송대 흑유 도자기인 건잔(建盏)의 산지로 통한다.","known_for":["민강 발원지 수로","망탕산 풍경구","건잔 흑유 도자기","주자 문화"],"lat":26.6437,"lng":118.1777,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"중국","region":"푸젠","city":"푸딩","local":"福鼎 / Fuding","kind":"소도시","desc":"중국 최고의 백차(白茶) 산지이자 '바다 위의 선산'이라 불리는 태무산(太姥山)을 품은 동북부 해안 도시. 화강암 기암괴석 봉우리와 해식 동굴이 장관이다.","known_for":["태무산 국립공원","복정 백차(백호은침)","우란만 해변","화강암 석림"],"lat":27.3243,"lng":120.2166,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"푸젠","city":"충우","local":"崇武 / Chongwu","kind":"소도시","desc":"취안저우 혜안현 해변에 자리한 명대 왜구 방어용 화강암 석조 고성(崇武古城). 고스란히 남은 석성벽과 화려한 복장을 입는 혜안녀(惠安女) 민속 풍습으로 알려져 있다.","known_for":["충주고성 화강암 성벽","혜안녀 민속 문화","석조 조각 예술","동해 해안 절벽"],"lat":24.8778,"lng":118.9324,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"푸젠","city":"더화","local":"德化 / Dehua","kind":"소도시","desc":"'블랑 드 신(Blanc de Chine, 중국의 백색)'으로 서양에 격찬받은 유서 깊은 도자기의 고장. 송·원대 고가마터 유적과 대운산(戴云山) 원시림 자연보호구가 위치한다.","known_for":["더화 백자","굴용궁 고가마터","구선산(九仙山)","대운산 자연보호구"],"lat":25.4925,"lng":118.2414,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"푸젠","city":"진장","local":"晋江 / Jinjiang","kind":"중소도시","desc":"취안저우 남쪽 해안의 화교 고향이자 고대 무역 거점. 송대에 축조된 2km 길이의 안평교(안평석교)와 붉은 벽돌의 오림전통촌락(五店市/梧林)이 잘 보존되어 있다.","known_for":["오림 전통 화교 촌락","오점시 전통거리","안평교(오리교)","초암 마니교 유적"],"lat":24.7813,"lng":118.5519,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"중국","region":"푸젠","city":"류아오","local":"六鳌 / Liu'ao","kind":"자연지역","desc":"장저우 장포현 동남단 반도에 위치한 해안 비경 지대. 풍식으로 붉은빛 화강암이 빚어낸 비취만 비취바위(추상화랑)와 명대 방어 요새 육오고성이 남아 있다.","known_for":["비취만 추상화랑(풍식 바위)","육오고성","해안 풍차 사구","해수욕장"],"lat":23.9317,"lng":117.7551,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""}]