[{"country":"라오스","region":"라오스","city":"비엔티안","local":"ວຽງຈັນ / Vientiane","kind":"대도시","desc":"메콩강을 끼고 태국과 마주보는 라오스의 수도. 프랑스 식민지 시절의 건축 양식과 불교 사원이 공존하는 조용한 강변 도시이다.","known_for":["파탓루앙","빠뚜싸이 독립기념탑","왓 시사켓","메콩강 야시장"],"lat":17.98,"lng":102.63,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"라오스","region":"라오스","city":"루앙프라방","local":"ຫລວງພະບາງ / Luang Prabang","kind":"중소도시","desc":"도시 전체가 유네스코 세계문화유산으로 지정된 옛 왕국의 수도. 새벽 탁발 행렬과 황금빛 사원, 프랑스풍 목조 가옥이 보존되어 있다.","known_for":["왓 시엥통","새벽 탁발","꽝시 폭포","푸시산 일몰"],"lat":19.89,"lng":102.13,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"라오스","region":"라오스","city":"방비엥","local":"ວັງວຽງ / Vang Vieng","kind":"소도시","desc":"카르스트 석회암 봉우리와 남송강이 어우러진 자연 휴양지. 동굴 탐험과 카약, 튜빙, 열기구 체험 등 배낭여행자 액티비티로 유명하다.","known_for":["블루라군","남송강 튜빙·카약","탐짱 동굴","남싸이 전망대"],"lat":18.93,"lng":102.45,"sources":["Wikivoyage","Trip.com","네이버 블로그"],"note":""},{"country":"라오스","region":"라오스","city":"팍세","local":"ປາກເຊ / Pakse","kind":"중소도시","desc":"라오스 남부 참파삭주의 주도로 메콩강과 세돈강이 만나는 교통·상업 요충지. 볼라벤 고원과 시판돈, 왓푸로 향하는 여행 거점이다.","known_for":["왓푸살라오 대불","볼라벤 고원 관문","세돈강 철교","참파삭 역사박물관"],"lat":15.12,"lng":105.78,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"라오스","region":"라오스","city":"사반나켓","local":"ສະຫວັນນະເຂດ / Savannakhet","kind":"중소도시","desc":"태국 묵다한과 제2우정의 다리로 연결된 남부의 대표적인 무역 도시. 프랑스 식민지 시절 지어진 낡은 유럽풍 건물과 성당이 구시가에 남아 있다.","known_for":["프랑스 식민지 구시가","성 테레사 성당","왓 싱하랏 사원","공룡박물관"],"lat":16.55,"lng":104.75,"sources":["Wikivoyage","Trip.com"],"note":"공식 행정명칭은 까이손 폼위한(Kaysone Phomvihane)"},{"country":"라오스","region":"라오스","city":"타켁","local":"ທ່າແຂກ / Thakhek","kind":"소도시","desc":"캄무안주의 주도로 메콩강변에 위치한 소도시. 석회암 동굴과 협곡을 돌아보는 '타켁 루프(Thakhek Loop)' 오토바이 여행의 출발점이다.","known_for":["타켁 루프 오토바이 투어","탐나앙엔 동굴","메콩강변 프랑스풍 광장","제3우정의 다리"],"lat":17.41,"lng":104.83,"sources":["Wikivoyage","Trip.com","네이버 블로그"],"note":""},{"country":"라오스","region":"라오스","city":"폰사반","local":"ໂພນສະຫວັນ / Phonsavan","kind":"소도시","desc":"시앙쾅주의 주도로 고대 석조 거석 유적인 '항아리 평원'의 거점 도시. 인도차이나 전쟁 당시 심각한 폭격을 겪어 불발탄 관련 역사가 짙게 배어 있다.","known_for":["항아리 평원","MAG 지뢰제거센터 전시관","옛 무앙쿠안 유적","불발탄 예술품"],"lat":19.45,"lng":103.18,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"라오스","region":"라오스","city":"농키아우","local":"ໜອງຂຽວ / Nong Khiaw","kind":"마을","desc":"남우강(Nam Ou)을 가로지르는 다리와 깎아지른 석회암 절벽이 병풍처럼 둘러싼 조용한 강변 마을. 협곡 트레킹과 전망대로 유명하다.","known_for":["파댕 전망대","남우강 다리","파톡 동굴","남우강 보트 트립"],"lat":20.57,"lng":102.61,"sources":["Wikivoyage","Trip.com","네이버 블로그"],"note":""},{"country":"라오스","region":"라오스","city":"므앙응오이","local":"ເມືອງງອຍ / Muang Ngoi Neua","kind":"마을","desc":"농키아우에서 남우강 상류로 보트를 타고서만 들어갈 수 있는 오지 마을. 차가 다니지 않는 원시적인 평화로움과 석회암 산악 트레킹으로 배낭여행자에게 인기다.","known_for":["남우강 롱테일보트","파노이 전망대","탐캉 동굴","바나 마을 트레킹"],"lat":20.71,"lng":102.68,"sources":["Wikivoyage","Trip.com","네이버 블로그"],"note":""},{"country":"라오스","region":"라오스","city":"루앙남타","local":"ຫລວງນ້ຳທາ / Luang Namtha","kind":"소도시","desc":"라오스 최북단 남하 국립생태보호구역의 관문 도시. 다양한 소수민족 마을을 방문하는 정글 트레킹과 카약 생태 관광의 중심지이다.","known_for":["남하 생태보호구 트레킹","소수민족 마을 홈스테이","야시장","보텐 국경 도로"],"lat":20.95,"lng":101.4,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"라오스","region":"라오스","city":"후에이사이","local":"ຫ້ວຍຊາຍ / Huay Xai","kind":"소도시","desc":"태국 치앙콩과 메콩강을 사이에 두고 마주하는 보케오주의 주도. 루앙프라방으로 가는 메콩강 1박2일 슬로우보트와 기번 익스피리언스의 거점이다.","known_for":["메콩강 슬로우보트 출발점","기번 익스피리언스(집라인)","포트 카르노 요새","왓 좀카오 마니랏"],"lat":20.28,"lng":100.41,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"라오스","region":"라오스","city":"팍벵","local":"ປາກແບ່ງ / Pakbeng","kind":"마을","desc":"후에이사이에서 루앙프라방으로 내려가는 메콩강 유람선이 하룻밤 묵어가는 중간 기착지 마을. 강변 절벽에 늘어선 게스트하우스와 코끼리 캠프가 있다.","known_for":["메콩강 슬로우보트 기착지","메콩강 일몰 전망","메콩 코끼리 캠프","왓 시폰차이"],"lat":19.89,"lng":101.14,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"라오스","region":"라오스","city":"시판돈","local":"ສີ່ພັນດອນ / Si Phan Don","kind":"섬","desc":"라오스 남부 캄보디아 국경 메콩강에 형성된 '4,000개의 섬' 군도 지역. 돈뎃(Don Det)과 돈콘(Don Khon)을 중심으로 해먹에 누워 쉬어가는 배낭여행의 성지이다.","known_for":["돈뎃 섬 해먹 휴양","돈콘 폭포(솜파밋 폭포)","이라와디 민물돌고래","콘파펭 폭포"],"lat":14.05,"lng":105.84,"sources":["Wikivoyage","Trip.com","네이버 블로그"],"note":"돈뎃(Don Det)·돈콘(Don Khon)·돈콩(Don Khong) 등 군도 일대"},{"country":"라오스","region":"라오스","city":"참파삭","local":"ຈຳປາສັກ / Champasak","kind":"마을","desc":"메콩강 서안에 위치한 옛 왕국의 역사적 마을. 크메르 제국의 유네스코 세계문화유산 힌두교 사원 '왓푸(Wat Phou)'가 있는 유서 깊은 고장이다.","known_for":["왓푸(Wat Phou) 유적","푸까오산(링가파르바타)","메콩강변 식민지풍 가옥","사원 축제"],"lat":14.88,"lng":105.84,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"라오스","region":"라오스","city":"볼라벤 고원","local":"ພູພຽງບໍລະເວນ / Bolaven Plateau","kind":"자연지역","desc":"해발 1,000~1,300m에 이르는 서늘한 남부 고원 지대. 라오스 최고의 커피·차 재배지이자 거대한 쌍둥이 폭포와 협곡으로 유명하다.","known_for":["커피 농장 투어","땃판 폭포(Tad Fane)","땃유앙 폭포(Tad Yuang)","정글 짚라인"],"lat":15.11,"lng":106.44,"sources":["Wikivoyage","Trip.com","네이버 블로그"],"note":""},{"country":"라오스","region":"라오스","city":"팍송","local":"ປາກຊ່ອງ / Paksong","kind":"소도시","desc":"볼라벤 고원의 중심 도시이자 '라오스 커피의 수도'. 연중 서늘한 기후 속에서 아라비카·로부스타 커피 농장과 대형 폭포들의 관문 역할을 한다.","known_for":["커피 로스터리 카페","땃찬 폭포","고원 온대 기후","소수민족 시장"],"lat":15.18,"lng":106.23,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"라오스","region":"라오스","city":"므앙싸이","local":"ເມືອງໄຊ / Muang Xay","kind":"소도시","desc":"우돔싸이주의 주도로 중국-라오스 철도(LCR)의 주요 정차역이 위치한 북부 교통 결절점. 싱사카르트 사원과 촘옹 동굴이 인근에 있다.","known_for":["중국-라오스 철도역","프라탓 싱사카르트 사원","촘옹 카르스트 동굴","북부 교통 환승"],"lat":20.7,"lng":101.82,"sources":["Wikivoyage","Trip.com"],"note":"우돔싸이(Oudomxay)로도 불림"},{"country":"라오스","region":"라오스","city":"므앙싱","local":"ເມືອງສິງ / Muang Sing","kind":"마을","desc":"중국 국경과 가까운 루앙남타주 북동부 분지 마을. 전통 타이루족 고상가옥과 다양한 고산 소수민족의 아침 시장으로 유명하다.","known_for":["소수민족 아침 시장","전통 타이루족 건축","왓 싱하이 사원","국경 트레킹"],"lat":21.18,"lng":101.16,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"라오스","region":"라오스","city":"비엥싸이","local":"ວຽງໄຊ / Vieng Xai","kind":"마을","desc":"베트남 전쟁 시기 파텟라오 공산주의 지도부가 미군의 폭격을 피해 10년간 은신하며 병원·학교·군사령부를 운영했던 100여 개 천연 동굴 도시.","known_for":["파텟라오 혁명 동굴","카이손 폼위한 은신 동굴","전쟁 유적 오디오 투어","석회암 기암괴석"],"lat":20.41,"lng":104.23,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"라오스","region":"라오스","city":"삼느아","local":"ຊຳເໜືອ / Sam Neua","kind":"소도시","desc":"라오스 북동부 후아판주의 산악 주도. 정교한 전통 실크 직물 공예와 비엥싸이 동굴로 가는 교통 관문이다.","known_for":["후아판 전통 실크 직물","독립기념탑 공원","삼느아 중앙시장","비엥싸이 관문"],"lat":20.42,"lng":104.05,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"라오스","region":"라오스","city":"퐁살리","local":"ຜົ້ງສາລີ / Phongsali","kind":"소도시","desc":"해발 1,400m 산정에 자리 잡은 라오스 최북단 퐁살리주의 주도. 400년 된 고차수 차밭과 운해, 중국 윈난풍 흙벽 가옥이 특색이다.","known_for":["400년 고차수 차밭","푸파산 구름바다","중국풍 전통 구시가","소수민족 트레킹"],"lat":21.68,"lng":102.1,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"라오스","region":"라오스","city":"반나힌","local":"ບ້ານນາຫີນ / Ban Nahin","kind":"마을","desc":"7.5km 길이의 거대한 지하 동굴 강을 보트로 통과하는 콩로 동굴(Tham Kong Lor) 탐험의 베이스캠프 마을.","known_for":["콩로 동굴 보트 탐험","푸파만 전망대","카르스트 숲 지형","타켁 루프 코스"],"lat":18.2,"lng":104.53,"sources":["Wikivoyage","Trip.com"],"note":"반쿤캄(Ban Khoun Kham)으로도 불림"},{"country":"라오스","region":"라오스","city":"사야부리","local":"ໄຊຍະບູລີ / Sayabouly","kind":"소도시","desc":"메콩강 서안에 위치한 사야부리주의 주도로 코끼리 보호 센터와 연례 코끼리 축제로 널리 알려진 곳이다.","known_for":["코끼리 보호 센터(ECC)","연례 코끼리 축제","왓 시분흐앙 사원","남푸이 국립보호림"],"lat":19.25,"lng":101.71,"sources":["Wikivoyage","Trip.com"],"note":"사이냐불리(Xayabury)로도 표기"},{"country":"라오스","region":"라오스","city":"팍산","local":"ປາກຊັນ / Paksan","kind":"소도시","desc":"남산강(Nam San)이 메콩강으로 흘러드는 볼리캄사이주의 주도로 비엔티안과 중남부를 잇는 13번 국도 교통 요충지.","known_for":["메콩강 합류 지점","왓 포사이 사원","남캇 생태투어 관문","태국 븡깐 국경 연결"],"lat":18.38,"lng":103.66,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"라오스","region":"라오스","city":"살라완","local":"ສາລະວັນ / Salavan","kind":"소도시","desc":"볼라벤 고원 북동쪽 살라완주의 주도. 땃로(Tad Lo) 폭포 휴양지와 인근 소수민족 마을을 둘러보는 조용한 여행지이다.","known_for":["땃로 폭포 휴양지","땃항 폭포","알락·응게족 소수민족 마을","세돈강 풍경"],"lat":15.72,"lng":106.42,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"라오스","region":"라오스","city":"세콩","local":"ເຊກອງ / Sekong","kind":"소도시","desc":"남동부 숲과 세콩강을 끼고 형성된 세콩주의 주도. 다양한 산악 민족 문화와 폭포들이 보존된 오지 관광지이다.","known_for":["세콩강 보트","땃세파 폭포","소수민족 전통 직물","볼라벤 동부 관문"],"lat":15.34,"lng":106.72,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"라오스","region":"라오스","city":"아타푸","local":"ອັດຕະປື / Attapeu","kind":"소도시","desc":"베트남 국경과 인접한 라오스 남동단 아타푸주의 주도. 동암팜 국립생태보호구역과 호찌민 루트의 역사적 흔적이 남아 있다.","known_for":["동암팜 국립보호구","세콩강 지류","호찌민 루트 잔해","베트남 국경 무역"],"lat":14.81,"lng":106.83,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"라오스","region":"라오스","city":"보텐","local":"ບໍ່ເຕັນ / Boten","kind":"소도시","desc":"중국 윈난성 모한(磨憨)과 국경을 맞댄 최북단 관문 도시. 중국-라오스 국제철도 국경역과 특별경제구역이 들어서 있다.","known_for":["중국-라오스 철도 국경역","보텐 국제경제특구","중국 국경 관문","면세 쇼핑몰"],"lat":21.19,"lng":101.69,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"라오스","region":"라오스","city":"비엥푸카","local":"ວຽງພູຄາ / Vieng Phoukha","kind":"마을","desc":"루앙남타와 후에이사이를 잇는 산악 도로변의 마을. 남하 보호구역 남쪽 자락의 동굴 탐험과 에코 트레킹 거점이다.","known_for":["카오라오 석회암 동굴","남하 남부 에코 트레킹","쿠에족 소수민족 마을","산악 오지 풍경"],"lat":20.69,"lng":101.09,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"라오스","region":"라오스","city":"므앙롱","local":"ເມືອງລອງ / Muang Long","kind":"마을","desc":"루앙남타 서부 메콩강 지류 남마강 변에 위치한 오지 마을. 미얀마 국경과 가까워 전통 아카족 공동체 문화가 짙게 남아 있다.","known_for":["아카족 고산 부락","남마강 풍경","오지 시장","국경 트레킹"],"lat":20.94,"lng":100.82,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"라오스","region":"라오스","city":"므앙응언","local":"ເມືອງເງິນ / Muang Ngeun","kind":"마을","desc":"태국 난(Nan)주 국경과 인접한 사야부리주 북부의 관문 마을. 타이루족 전통 문화와 평화로운 농촌 풍경을 볼 수 있다.","known_for":["태국 후아이꼰 국경 검문소","타이루족 사원","농촌 전원 풍경","사야부리 북부 교통로"],"lat":19.67,"lng":101.1,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"라오스","region":"라오스","city":"항아리 평원","local":"ທົ່ງໄຫຫີນ / Plain of Jars","kind":"자연지역","desc":"수천 개의 거대한 고대 돌항아리가 흩어져 있는 유네스코 세계문화유산 유적지. 기원전 수수께끼의 거석 장례 문화로 알려져 있다.","known_for":["고대 거석 항아리 유적","유네스코 세계유산","사이트 1·2·3","인도차이나 전쟁 참호"],"lat":19.43,"lng":103.15,"sources":["Wikivoyage","Trip.com"],"note":"폰사반 인근 시앙쾅 고원 일대 거석 유적군"},{"country":"캄보디아","region":"캄보디아","city":"프놈펜","local":"ភ្នំពេញ / Phnom Penh","kind":"대도시","desc":"톤레삽강과 메콩강이 합류하는 캄보디아의 수도. 프랑스 식민지풍 건축, 황금빛 왕궁, 크메르루주의 비극을 증언하는 킬링필드가 공존한다.","known_for":["왕궁과 은탑","킬링필드(초응에크)","뚜얼슬렝 학살박물관","중앙시장(프사 트메이)"],"lat":11.56,"lng":104.92,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"캄보디아","region":"캄보디아","city":"씨엠립","local":"ក្រុងសៀមរាប / Siem Reap","kind":"중소도시","desc":"세계적인 불가사의 앙코르 와트의 관문 도시. 활기찬 야시장, 펍스트리트, 전통 압사라 댄스 공연장과 카페가 밀집해 있다.","known_for":["앙코르 와트 관문","펍스트리트","야시장","톤레삽 호수 투어"],"lat":13.36,"lng":103.86,"sources":["Wikivoyage","Trip.com","마펑워"],"note":""},{"country":"캄보디아","region":"캄보디아","city":"바탐방","local":"ក្រុងបាត់ដំបង / Battambang","kind":"중소도시","desc":"상까에강 변에 자리한 캄보디아 제2의 도시. 프랑스 식민지 시절 건축물과 예술가 커뮤니티, 유명한 대나무 기차가 매력이다.","known_for":["대나무 기차(뱀부트레인)","프놈삼포 박쥐 동굴","왓엑프놈","식민지풍 구시가"],"lat":13.1,"lng":103.2,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"캄보디아","region":"캄보디아","city":"시하누크빌","local":"ក្រុងព្រះសីហនុ / Sihanoukville","kind":"중소도시","desc":"태국만에 면한 캄보디아 최고의 심해 항구이자 해변 휴양 도시. 코롱섬과 코롱산렘섬으로 향하는 페리 출도착 중심지이다.","known_for":["오트레스 비치","코롱섬 페리 터미널","황금사자 로터리","해산물 야시장"],"lat":10.63,"lng":103.52,"sources":["Wikivoyage","Trip.com"],"note":"캄퐁솜(Kampong Som)으로도 알려짐"},{"country":"캄보디아","region":"캄보디아","city":"캄폿","local":"ក្រុងកំពត / Kampot","kind":"소도시","desc":"뜨윽추강(Tuek Chhou) 변의 한적한 옛 프랑스 식민지풍 소도시. 세계적인 품질의 캄폿 후추 농장과 강변 일몰 카약 투어가 유명하다.","known_for":["캄폿 후추 농장","강변 프랑스풍 구시가","두리안 로터리","보코르산 국립공원 관문"],"lat":10.61,"lng":104.18,"sources":["Wikivoyage","Trip.com","네이버 블로그"],"note":""},{"country":"캄보디아","region":"캄보디아","city":"켑","local":"ក្រុងកែប / Kep","kind":"소도시","desc":"20세기 초 프랑스 귀족들의 여름 휴양지였던 조용한 해안 마을. 갓 잡은 게를 캄폿 통후추와 볶아 내는 크랩 마켓으로 이름나 있다.","known_for":["켑 크랩 마켓","토끼섬(Koh Tonsay)","켑 국립공원 트레킹","버려진 프랑스 식민지 빌라"],"lat":10.48,"lng":104.32,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"캄보디아","region":"캄보디아","city":"꼬꽁","local":"ក្រុងកោះកុង / Koh Kong","kind":"소도시","desc":"태국 핫렉(Hat Lek) 국경 인근에 위치한 해안 소도시. 동남아 최대 규모의 맹그로브 숲과 카드몸 산맥 정글 생태관광의 기점이다.","known_for":["페암크라솝 맹그로브 보호구","따따이 폭포","카드몸 산맥 관문","태국 국경 통과"],"lat":11.62,"lng":102.98,"sources":["Wikivoyage","Trip.com"],"note":"크메르크메인(Khemara Phoumin)으로도 불림"},{"country":"캄보디아","region":"캄보디아","city":"크라체","local":"ក្រុងក្រចេះ / Kratie","kind":"소도시","desc":"메콩강 상류변의 고즈넉한 강변 소도시. 멸종 위기에 처한 희귀 민물 돌고래인 이라와디 돌고래 관찰 보트 투어의 중심지이다.","known_for":["이라와디 민물돌고래 관찰","코트롱섬(자전거 투어)","메콩강 일몰","프랑스풍 강변 가옥"],"lat":12.49,"lng":106.02,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"캄보디아","region":"캄보디아","city":"반룽","local":"ក្រុងបានលុង / Banlung","kind":"소도시","desc":"붉은 흙탕길과 화산 지형으로 둘러싸인 북동부 라타나키리주의 주도. 완벽한 원형의 화산 분화구 호수 약롬(Yeak Laom)과 소수민족 마을이 있다.","known_for":["약롬 분화구 호수","차웅·카티엥 폭포","보석 광산","비라체이 국립공원 트레킹"],"lat":13.74,"lng":106.99,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"캄보디아","region":"캄보디아","city":"센모노롬","local":"ក្រុងសែនមនោរម្យ / Sen Monorom","kind":"소도시","desc":"해발 800m의 시원한 기후를 자랑하는 몬돌키리주의 주도. 완만한 초원 구릉 지대와 야생 코끼리 생태 보호 프로젝트로 각광받는다.","known_for":["코끼리 생태보호구역(EVP)","부스라 폭포","바다숲 전망대(Sea Forest)","프농족 소수민족 문화"],"lat":12.46,"lng":107.19,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"캄보디아","region":"캄보디아","city":"스퉁트렝","local":"ក្រុងស្ទឹងត្រែង / Stung Treng","kind":"소도시","desc":"메콩강과 세콩강이 합류하는 북동부의 교통 요충지. 라오스 남부 국경 검문소(동크랄로)로 이어지는 주요 환승 거점이다.","known_for":["세콩강·메콩강 합류점","람사르 습지 카약 투어","라오스 국경 관문","메콩강 민물 생선 요리"],"lat":13.53,"lng":105.97,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"캄보디아","region":"캄보디아","city":"캄퐁참","local":"ក្រុងកំពង់ចាម / Kampong Cham","kind":"중소도시","desc":"메콩강변의 번화한 상업 도시. 매년 건기마다 주민들이 직접 설치하는 거대한 코펜 대나무 다리와 11세기 사원 왓노코르가 있다.","known_for":["코펜 대나무 다리","왓노코르 바체이 사원","키즈나 메콩강 대교","프랑스 식민지풍 거리"],"lat":12,"lng":105.46,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"캄보디아","region":"캄보디아","city":"캄퐁톰","local":"ក្រុងកំពង់ធំ / Kampong Thom","kind":"소도시","desc":"프놈펜과 씨엠립 사이의 중간 기착 도시. 앙코르 이전 첸라 왕국의 고도이자 유네스코 세계유산인 삼보르 프레이 쿡의 관문이다.","known_for":["삼보르 프레이 쿡 유적","프놈산툭 불교 사원","센강변 야시장","선앙코르 벽돌 사원군"],"lat":12.71,"lng":104.89,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"캄보디아","region":"캄보디아","city":"캄퐁츠낭","local":"ក្រុងកំពង់ឆ្នាំង / Kampong Chhnang","kind":"소도시","desc":"'토기의 항구'라는 뜻의 도시로 톤레삽 호수 서남단에 위치한다. 붉은 점토로 빚는 전통 도자기 마을과 거대한 수상 가옥촌이 명물이다.","known_for":["전통 토기 도자기 마을","총꼬 수상 마을","톤레삽 호수 풍경","프놈끄랑 사원"],"lat":12.25,"lng":104.67,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"캄보디아","region":"캄보디아","city":"포르삿","local":"ក្រុងពោធិ៍សាត់ / Pursat","kind":"소도시","desc":"포르삿강 변의 도시로 캄보디아 최고의 대리석 조각 공예 산지. 톤레삽 호수 최대의 수상 부락인 캄퐁루엉으로 들어가는 관문이다.","known_for":["대리석 조각 공방","캄퐁루엉 수상 마을","카드몸 산맥 트레킹 관문","바클롱 역사 유적"],"lat":12.53,"lng":103.92,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"캄보디아","region":"캄보디아","city":"시소폰","local":"ក្រុងសិរីសោភ័ណ / Sisophon","kind":"소도시","desc":"반테아이메안체이주의 주도로 태국 국경 포이펫과 씨엠립, 바탐방으로 갈라지는 5번·6번 국도 분기점 교통 요충지.","known_for":["북서부 교통 결절점","프놈스바이 불교 사원","반테아이츠마 관문","반테아이메안체이 박물관"],"lat":13.58,"lng":102.97,"sources":["Wikivoyage","Trip.com"],"note":"공식 명칭은 세레이사오폰(Serei Saophoan)"},{"country":"캄보디아","region":"캄보디아","city":"포이펫","local":"ក្រុងប៉ោយប៉ែត / Poipet","kind":"소도시","desc":"태국 아란야쁘라텟(Aranyaprathet)과 국경을 맞댄 캄보디아 서부 육로 최대의 관문 도시. 대형 카지노 호텔 단지가 밀집해 있다.","known_for":["태국-캄보디아 육로 국경","국경 카지노 호텔가","육로 입국 심사대","철도 국경역"],"lat":13.66,"lng":102.56,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"캄보디아","region":"캄보디아","city":"파일린","local":"ក្រុងប៉ៃលិន / Pailin","kind":"소도시","desc":"카드몸 산맥 북쪽 자락의 산악 도시. 루비와 사파이어 채굴지로 번성했으며, 1990년대 후반까지 크메르루주 지도부가 거점으로 삼았던 역사가 있다.","known_for":["보석 채굴 역사","프놈얏 사원","크메르루주 최후 거점 유적","태국 짠타부리 국경"],"lat":12.85,"lng":102.61,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"캄보디아","region":"캄보디아","city":"우동","local":"ឧដុង្គ / Oudong","kind":"마을","desc":"프놈펜 북쪽 약 40km에 위치한 17~19세기 크메르 왕국의 옛 수도. 프놈우동 능선을 따라 역대 왕들의 거대한 탑(스투파)들이 늘어서 있다.","known_for":["프놈우동 왕실 사리탑","비파사나 명상 센터","은공예 마을","옛 왕도 파노라마 전망"],"lat":11.82,"lng":104.75,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"캄보디아","region":"캄보디아","city":"타케오","local":"ក្រុងដូនកែវ / Takeo","kind":"소도시","desc":"캄보디아 문명의 발상지로 불리는 남부 도시. 1~6세기 부남(푸난) 왕국의 중심지였던 앙코르보레이와 프놈다 유적으로 가는 관문이다.","known_for":["앙코르보레이 박물관","프놈다 5세기 사원","운하 보트 여행","프놈치소 사원"],"lat":10.99,"lng":104.79,"sources":["Wikivoyage","Trip.com"],"note":"주도 도시명은 돈까에우(Doun Kaev)"},{"country":"캄보디아","region":"캄보디아","city":"코롱","local":"កោះរ៉ុង / Koh Rong","kind":"섬","desc":"시하누크빌 서쪽에 위치한 캄보디아 제2의 섬. 고운 백사장과 투명한 바다, 밤바다의 생광성 플랑크톤 관찰과 해변 파티로 배낭여행자에게 인기다.","known_for":["소크산 롱비치","코치 플랑크톤 투어","다이빙 및 스노클링","정글 트레킹"],"lat":10.72,"lng":103.23,"sources":["Wikivoyage","Trip.com","네이버 블로그"],"note":""},{"country":"캄보디아","region":"캄보디아","city":"코롱산렘","local":"កោះរ៉ុងសន្លឹម / Koh Rong Sanloem","kind":"섬","desc":"코롱섬 남쪽에 위치한 조용하고 평화로운 휴양 섬. 반달 모양의 잔잔한 사라센 베이와 모래사장이 아름다운 힐링 목적지이다.","known_for":["사라센 베이 해변 휴양","선셋 비치","야간 플랑크톤 수영","스쿠버 다이빙"],"lat":10.6,"lng":103.29,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"캄보디아","region":"캄보디아","city":"앙코르 유적","local":"ឧទ្យានបុរាណវិទ្យាអង្គរ / Angkor Archaeological Park","kind":"자연지역","desc":"9~15세기 크메르 제국의 수도였던 유네스코 세계문화유산 유적 지구. 앙코르 와트, 바이욘 사원의 사면불, 거대한 나무뿌리가 뒤덮은 타프롬이 있다.","known_for":["앙코르 와트 일출","바이욘 사면불상","타프롬 사원(영화 툼레이더)","반테아이 스레이"],"lat":13.41,"lng":103.87,"sources":["Wikivoyage","Trip.com"],"note":"씨엠립 북쪽 유네스코 고고학 공원 일대"},{"country":"캄보디아","region":"캄보디아","city":"프레아비헤아르","local":"ប្រាសាទព្រះវិហារ / Prasat Preah Vihear","kind":"자연지역","desc":"태국 국경 단그렉 산맥 525m 절벽 정상에 세워진 유네스코 세계문화유산 힌두교 사원. 절벽 아래로 캄보디아 평원이 아득하게 내려다보인다.","known_for":["525m 절벽 위 고대 사원","유네스코 세계문화유산","크메르 힌두 건축의 걸작","태국 국경 파노라마"],"lat":14.39,"lng":104.68,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"캄보디아","region":"캄보디아","city":"코케르","local":"កោះកេរ្តិ៍ / Koh Ker","kind":"자연지역","desc":"10세기 자야바르만 4세 때 잠시 크메르 제국의 수도였던 유네스코 세계문화유산 유적지. 마야 피라미드를 닮은 7단 피라미드 사원 프라삿톰이 웅장하다.","known_for":["프라삿톰 7단 피라미드 사원","유네스코 세계문화유산","정글 속 원시 고대 유적","프라삿프람(나무뿌리 사원)"],"lat":13.78,"lng":104.54,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"캄보디아","region":"캄보디아","city":"반테아이츠마","local":"ប្រាសាទបន្ទាយឆ្មារ / Banteay Chhmar","kind":"자연지역","desc":"북서부 오지 정글 속에 묻혀 있는 자야바르만 7세 시대의 거대한 사원 복합단지. 보존 상태가 뛰어난 천수관음 부조와 고즈넉한 폐허미를 품고 있다.","known_for":["천수관음 부조 벽화","사면불 탑","지역 공동체 홈스테이(CBT)","인적 드문 정글 사원"],"lat":14.07,"lng":102.99,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"캄보디아","region":"캄보디아","city":"안롱벵","local":"អន្លង់វែង / Anlong Veng","kind":"마을","desc":"단그렉 산맥 기슭의 국경 마을로 1998년까지 크메르루주의 마지막 군사 거점이었던 곳. 최고지도자 폴포트의 무덤과 사령관 타목의 저택이 남아 있다.","known_for":["폴포트의 무덤 유적","타목 장군의 호수 저택","크메르루주 마지막 거점","태국 총총 국경 관문"],"lat":14.37,"lng":104.1,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"캄보디아","region":"캄보디아","city":"보코르산","local":"ឧទ្យានជាតិព្រះមុនីវង្ស បូកគោ / Bokor National Park","kind":"자연지역","desc":"캄폿 뒤편 해발 1,079m 고원에 위치한 국립공원. 1920년대 프랑스 식민지 관료들의 힐스테이션이었던 낡은 호텔 폐허와 서늘한 안개가 신비롭다.","known_for":["옛 프랑스 궁전 카지노 호텔","로카 사원(보코르 성당)","포포크빌 폭포","해안 파노라마 조망"],"lat":10.63,"lng":104.02,"sources":["Wikivoyage","Trip.com"],"note":"공식 명칭은 프레아 모니봉 보코르 국립공원"},{"country":"캄보디아","region":"캄보디아","city":"치팟","local":"ជីផាត / Chi Phat","kind":"마을","desc":"카드몸 산맥 남부 정글에 위치한 동남아 최고의 주민 참여형 생태관광(CBET) 마을. 밀렵꾼이었던 현지 주민들이 안내하는 트레킹과 카약 투어가 진행된다.","known_for":["주민 참여형 생태관광(CBET)","카드몸 산맥 정글 트레킹","고대 토기 옹관묘 탐방","피프 강 카약킹"],"lat":11.35,"lng":103.51,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"캄보디아","region":"캄보디아","city":"바벳","local":"ក្រុងបាវិត / Bavet","kind":"소도시","desc":"베트남 목바이(Moc Bai)와 마주보는 스바이리엥주의 국경 관문 도시. 프놈펜과 호찌민시를 잇는 1번 아시안 하이웨이의 주요 통과점이자 카지노 밀집지이다.","known_for":["캄보디아-베트남 1번 국도 국경","국경 카지노 호텔 단지","스바이리엥 경제특구","호찌민 직행 버스 환승"],"lat":11.08,"lng":106.14,"sources":["Wikivoyage","Trip.com"],"note":""},{"country":"말레이시아","region":"말레이시아","city":"쿠알라룸푸르","local":"Kuala Lumpur / 吉隆坡","kind":"대도시","desc":"말레이·중국·인도 문화가 어우러진 말레이시아의 수도. 페트로나스 트윈타워와 바투 동굴, 활기찬 야시장 잘란알로가 유명하다.","known_for":["페트로나스 트윈타워","바투 동굴","잘란알로 야시장","메르데카 광장"],"lat":3.14,"lng":101.69,"sources":["Wikivoyage","Trip.com"],"note":"말레이반도 서해안 수도"},{"country":"말레이시아","region":"말레이시아","city":"조지타운","local":"George Town / 乔治市","kind":"중소도시","desc":"페낭섬에 위치한 유네스코 세계문화유산 도시. 거리 벽화 예술과 동남아 최고의 길거리 음식(하우커 푸드), 페라나칸 문화의 중심지이다.","known_for":["거리 벽화 아트","페낭 힐 전망대","극락사(켁록시)","차콰이테오 길거리음식"],"lat":5.41,"lng":100.33,"sources":["Wikivoyage","Trip.com","마펑워"],"note":"말레이반도 서해안 페낭주 주도"},{"country":"말레이시아","region":"말레이시아","city":"말라카","local":"Melaka / Malacca / 马六甲","kind":"중소도시","desc":"말라카 해협을 낀 유네스코 세계문화유산 역사 도시. 포르투갈·네덜란드·영국 식민지 유적과 존커 스트리트 야시장이 있다.","known_for":["존커 스트리트 야시장","네덜란드 광장(스타더이스)","에이파모사 요새","말라카강 크루즈"],"lat":2.19,"lng":102.25,"sources":["Wikivoyage","Trip.com"],"note":"말레이반도 서해안 말라카주 주도"},{"country":"말레이시아","region":"말레이시아","city":"이포","local":"Ipoh / 怡保","kind":"중소도시","desc":"킨타 계곡 석회암 카르스트 산에 둘러싸인 페락주의 주도. 화이트 커피의 발상지이자 석회암 동굴 사원과 구시가 미식으로 유명하다.","known_for":["이포 화이트 커피","극락동·삼포통 동굴사원","콩헹 골목 구시가","닭고기 콩나물 국수"],"lat":4.6,"lng":101.08,"sources":["Wikivoyage","Trip.com","네이버 블로그"],"note":"말레이반도 서해안 페락주 주도"},{"country":"말레이시아","region":"말레이시아","city":"조호르바루","local":"Johor Bahru / 新山","kind":"대도시","desc":"조호르 해협을 사이에 두고 싱가포르와 코즈웨이로 연결된 말레이시아 남부의 관문 대도시. 레고랜드와 술탄 아부바카르 모스크가 있다.","known_for":["싱가포르 국경 코즈웨이","레고랜드 말레이시아","술탄 아부바카르 모스크","탄히옥니 문화거리"],"lat":1.46,"lng":103.76,"sources":["Wikivoyage","Trip.com"],"note":"말레이반도 남단 조호르주 주도"},{"country":"말레이시아","region":"말레이시아","city":"푸트라자야","local":"Putrajaya / 布城","kind":"중소도시","desc":"쿠알라룸푸르 남쪽에 조성된 말레이시아의 연방 행정수도. 거대한 인공호수와 분홍빛 푸트라 모스크, 현대적인 정부 청사들이 정원 도시를 이룬다.","known_for":["핑크 모스크(푸트라 모스크)","총리관저(페르다나 푸트라)","푸트라자야 호수 크루즈","미래형 조형 다리들"],"lat":2.93,"lng":101.69,"sources":["Wikivoyage","Trip.com"],"note":"말레이반도 서해안 연방직할구"},{"country":"말레이시아","region":"말레이시아","city":"페탈링자야","local":"Petaling Jaya / 八打灵再也","kind":"대도시","desc":"쿠알라룸푸르의 핵심 위성도시로 대형 쇼핑몰과 미식 골목, 선웨이 라군 테마파크가 위치한 번화한 상업 지구.","known_for":["선웨이 라군 테마파크","원우타마 쇼핑센터","SS2 야시장·두리안 거리","쿠알라룸푸르 근교 상업지구"],"lat":3.11,"lng":101.62,"sources":["Wikivoyage","Trip.com"],"note":"말레이반도 서해안 슬랑오르주"},{"country":"말레이시아","region":"말레이시아","city":"샤알람","local":"Shah Alam / 莎阿南","kind":"대도시","desc":"슬랑오르주의 주도로 거대한 푸른 돔을 가진 술탄 살라후딘 압둘 아지즈 샤 모스크(블루 모스크)와 식물원 공원으로 알려진 계획도시.","known_for":["블루 모스크(술탄 살라후딘 모스크)","샤알람 국립식물원","아이시티(i-City) 테마파크","슬랑오르 주립박물관"],"lat":3.07,"lng":101.52,"sources":["Wikivoyage","Trip.com"],"note":"말레이반도 서해안 슬랑오르주 주도"},{"country":"말레이시아","region":"말레이시아","city":"클랑","local":"Klang / 巴生","kind":"중소도시","desc":"말레이시아 대표 보양탕 요리인 '바쿠테(Bak Kut Teh)'의 발상지로 유명한 슬랑오르주의 왕실 도시이자 포트클랑의 배후 도시.","known_for":["원조 바쿠테 골목","술탄 술레이만 왕립 모스크","리틀 인디아 거리","포트클랑 항구"],"lat":3.04,"lng":101.45,"sources":["Wikivoyage","Trip.com"],"note":"말레이반도 서해안 슬랑오르주 왕실 도시"},{"country":"말레이시아","region":"말레이시아","city":"쿠알라셀랑고르","local":"Kuala Selangor / 瓜拉雪兰莪","kind":"소도시","desc":"슬랑오르강 하구의 소도시. 캄풍쿠안탄의 반딧불이 보트 투어, 멜라와티 언덕의 은빛랑구르 원숭이, 사사란 스카이미러(바다 거울)로 유명하다.","known_for":["반딧불이 보트 투어","사사란 스카이미러(거울 호수)","부킷 멜라와티 원숭이 언덕","해산물 노포 마을"],"lat":3.34,"lng":101.25,"sources":["Wikivoyage","Trip.com","네이버 블로그"],"note":"말레이반도 서해안 슬랑오르주"},{"country":"말레이시아","region":"말레이시아","city":"타이핑","local":"Taiping / 太平","kind":"중소도시","desc":"말레이시아에서 비가 가장 자주 내리는 고요한 도시. 100년 넘은 비술나무가 늘어선 아름다운 타이핑 호수 정원과 최초의 동물원이 있다.","known_for":["타이핑 호수 정원","말레이시아 최초 동물원(나이트 사파리)","맥스웰 힐(부킷 라룻)","빅토리아풍 박물관"],"lat":4.85,"lng":100.74,"sources":["Wikivoyage","Trip.com"],"note":"말레이반도 서해안 페락주"},{"country":"말레이시아","region":"말레이시아","city":"쿠알라캉사르","local":"Kuala Kangsar / 江沙","kind":"소도시","desc":"페락강 변에 자리한 페락주의 왕실 도시. 황금빛 돔의 우부디아 모스크와 이스타나 이스칸다리아 왕궁, 말레이시아 최초의 고무나무가 있다.","known_for":["우부디아 모스크","이스타나 케낭안 목조 왕궁","라부 사융 전통 옹기","페락강변 왕실 문화"],"lat":4.77,"lng":100.94,"sources":["Wikivoyage","Trip.com"],"note":"말레이반도 서해안 페락주 왕실 도시"},{"country":"말레이시아","region":"말레이시아","city":"텔룩인탄","local":"Teluk Intan / 安顺","kind":"소도시","desc":"페락강 하류의 역사 도시. 지반 침하로 피사의 사탑처럼 비스듬히 기울어진 25m 높이의 텔룩인탄 시계탑이 명물이다.","known_for":["텔룩인탄 기울어진 사탑","치총판(안순 쌀국수 롤)","페락강 일몰","식민지풍 강변 건물"],"lat":4.02,"lng":101.02,"sources":["Wikivoyage","Trip.com"],"note":"말레이반도 서해안 페락주 (구 안순)"},{"country":"말레이시아","region":"말레이시아","city":"알로르세타르","local":"Alor Setar / 亚罗士打","kind":"중소도시","desc":"말레이시아 쌀 생산의 중심지인 케다주의 주도. 흑백 무어 양식의 자히르 모스크와 165m 알로르세타르 타워가 랜드마크이다.","known_for":["자히르 모스크","알로르세타르 타워","국립 벼농사 박물관","마하티르 총리 생가"],"lat":6.12,"lng":100.37,"sources":["Wikivoyage","Trip.com"],"note":"말레이반도 서해안 케다주 주도"},{"country":"말레이시아","region":"말레이시아","city":"캉가르","local":"Kangar / 加央","kind":"소도시","desc":"말레이시아에서 가장 작은 주이자 태국과 국경을 맞댄 프를리스주의 조용한 주도. 인근 구아켈람 동굴과 왕립공원이 있다.","known_for":["구아켈람 석회암 동굴","프를리스 주립공원","태국 파당베사르 국경 관문","알후세인 수상 모스크"],"lat":6.44,"lng":100.2,"sources":["Wikivoyage","Trip.com"],"note":"말레이반도 북서부 프를리스주 주도"},{"country":"말레이시아","region":"말레이시아","city":"스름반","local":"Seremban / 芙蓉","kind":"중소도시","desc":"수마트라 미낭카바우 이주민의 뾰족한 물소 뿔 모양 지붕 양식이 남아 있는 느그리슴빌란주의 주도. 구운 샤오바오 빵이 유명하다.","known_for":["미낭카바우 전통 건축","스름반 샤오바오 구운 빵","센토사 호수 공원","우루클랑 트레킹 관문"],"lat":2.73,"lng":101.94,"sources":["Wikivoyage","Trip.com"],"note":"말레이반도 서해안 느그리슴빌란주 주도"},{"country":"말레이시아","region":"말레이시아","city":"포트딕슨","local":"Port Dickson / 波德申","kind":"소도시","desc":"쿠알라룸푸르 시민들이 주말에 찾는 18km 백사장의 서해안 대표 해변 휴양지. 케이프 라차도 등대와 해양 레저가 있다.","known_for":["텔룩케망 해변","케이프 라차도 등대","육군 박물관","해양 스포츠 및 리조트"],"lat":2.52,"lng":101.8,"sources":["Wikivoyage","Trip.com"],"note":"말레이반도 서해안 느그리슴빌란주"},{"country":"말레이시아","region":"말레이시아","city":"무아르","local":"Muar / 麻坡","kind":"소도시","desc":"조호르주의 왕실 문화 도시이자 미식의 성지. 매콤한 생선 어묵 구이인 '오탁오탁(Otak-otak)'과 전통 커피숍 탄히옥니로 유명하다.","known_for":["오탁오탁 골목 미식","술탄 이브라힘 모스크","구시가 거리 벽화","무아르강 일몰"],"lat":2.05,"lng":102.57,"sources":["Wikivoyage","Trip.com"],"note":"말레이반도 서해안 조호르주 왕실 도시"},{"country":"말레이시아","region":"말레이시아","city":"바투파핫","local":"Batu Pahat / 峇株巴辖","kind":"소도시","desc":"'끌로 판 돌'이라는 뜻의 조호르주 서해안 소도시. 수많은 중국식 사원과 미냑베쿠 해변의 유서 깊은 우물이 자리한다.","known_for":["미냑베쿠 옛 우물 해변","연꽃 사원(총롱쿵)","전통 페스트리 제과","슬라맛강 어촌 풍경"],"lat":1.85,"lng":102.93,"sources":["Wikivoyage","Trip.com"],"note":"말레이반도 서해안 조호르주"},{"country":"말레이시아","region":"말레이시아","city":"클루앙","local":"Kluang / 居銮","kind":"소도시","desc":"조호르주 내륙의 철도 거점 도시. 기차역 클래식 커피와 카야 토스트, 유기농 농장인 UK 팜과 람박산 트레킹이 유명하다.","known_for":["클루앙 철도역 카야 토스트","UK 팜 양 목장","람박산(Gunung Lambak) 하이킹","수제 커피 로스터리"],"lat":2.03,"lng":103.32,"sources":["Wikivoyage","Trip.com"],"note":"말레이반도 남부 내륙 조호르주"},{"country":"말레이시아","region":"말레이시아","city":"머싱","local":"Mersing / 丰盛港","kind":"소도시","desc":"조호르주 동해안의 항구 도시. 세계적인 다이빙 섬인 티오만섬과 라바스섬 등 남중국해 청정 섬들로 향하는 여객선 관문이다.","known_for":["티오만섬 페리 부두","스리 수브라마니아르 힌두 사원","해산물 식당가","아일랜드 호핑 관문"],"lat":2.43,"lng":103.84,"sources":["Wikivoyage","Trip.com"],"note":"말레이반도 동해안 조호르주 페리 항구"},{"country":"말레이시아","region":"말레이시아","city":"랑카위","local":"Langkawi / 浮罗交怡","kind":"섬","desc":"안다만해에 떠 있는 99개 섬으로 이루어진 유네스코 세계지질공원이자 면세 섬. 해발 708m의 스카이캡과 스카이브리지, 맹그로브 투어가 대표적이다.","known_for":["스카이브리지 케이블카","체낭 비치 휴양","킬림 지질공원 맹그로브 투어","독수리 광장(다타란 랑)"],"lat":6.35,"lng":99.8,"sources":["Wikivoyage","Trip.com"],"note":"말레이반도 북서해안 안다만해 군도"},{"country":"말레이시아","region":"말레이시아","city":"팡코르","local":"Pulau Pangkor / 邦咯岛","kind":"섬","desc":"말라카 해협 페락주 연안의 조용한 휴양 섬. 코뿔새(혼빌)를 가까이서 볼 수 있으며 네덜란드 식민지 요새와 백사장이 펼쳐진다.","known_for":["텔룩니파 비치","야생 혼빌(코뿔새) 먹이주기","네덜란드 요새(코타 벨란다)","건어물 어촌 마을"],"lat":4.22,"lng":100.56,"sources":["Wikivoyage","Trip.com"],"note":"말레이반도 서해안 페락주 연안 섬"},{"country":"말레이시아","region":"말레이시아","city":"케탐섬","local":"Pulau Ketam / 吉胆岛","kind":"섬","desc":"포트클랑 앞바다 맹그로브 습지 위에 기둥을 세워 지은 중국계 어촌 수상 마을. 차가 다니지 않으며 자전거와 전동 스쿠터로 다닌다.","known_for":["맹그로브 수상 가옥촌","신선한 게 요리(칠리크랩)","자전거 섬 일주","다채로운 목조 다리"],"lat":3.02,"lng":101.25,"sources":["Wikivoyage","Trip.com"],"note":"말레이반도 서해안 슬랑오르주 연안 섬"},{"country":"말레이시아","region":"말레이시아","city":"카메론 하이랜드","local":"Cameron Highlands / 金马仑高原","kind":"자연지역","desc":"해발 1,500m 고지에 위치한 서늘한 힐스테이션. 끝없이 펼쳐진 BOH 차 농장, 딸기 농장, 이끼 낀 고대 원시림 '모시 포레스트'가 있다.","known_for":["BOH 차 농장","모시 포레스트(이끼 숲)","딸기 수확 체험","타나라타 배낭여행자 거리"],"lat":4.47,"lng":101.38,"sources":["Wikivoyage","Trip.com","네이버 블로그"],"note":"말레이반도 내륙 파항주 고원"},{"country":"말레이시아","region":"말레이시아","city":"겐팅 하이랜드","local":"Genting Highlands / 云顶高原","kind":"소도시","desc":"해발 1,800m 티티왕사 산맥 정상에 세워진 엔터테인먼트 복합 리조트 도시. 말레이시아 유일의 합법 카지노와 겐팅 스카이월즈 테마파크가 있다.","known_for":["아와나 스카이웨이 케이블카","겐팅 스카이월즈 테마파크","친스위 동굴 사원","카지노 리조트 월드"],"lat":3.42,"lng":101.79,"sources":["Wikivoyage","Trip.com"],"note":"말레이반도 내륙 파항/슬랑오르 경계 고원"},{"country":"말레이시아","region":"말레이시아","city":"프레이저스 힐","local":"Fraser's Hill / 福隆港","kind":"마을","desc":"해발 1,200m에 영국 식민지 관리들이 조성한 고요한 영국식 산악 마을. 모던한 튜더 양식 별장과 연중 선선한 기후, 조류 관찰의 메카이다.","known_for":["튜더 양식 시계탑","국제 조류 관찰(탐조) 대회","헤밍웨이 스타일 트레일","선선한 고산 기후"],"lat":3.71,"lng":101.74,"sources":["Wikivoyage","Trip.com"],"note":"말레이반도 내륙 파항주 산악 힐스테이션"},{"country":"말레이시아","region":"말레이시아","city":"타만네가라","local":"Taman Negara / 国家公园","kind":"자연지역","desc":"1억 3천만 년 동안 이어진 세계 최고(最古) 수준의 원시 열대우림 국립공원. 쿠알라타한을 거점으로 거대한 캐노피 워크웨이와 정글 나이트 사파리가 펼쳐진다.","known_for":["세계 최장 캐노피 워크웨이","오랑아슬리 원주민 마을","라타베르콜 보트 급류타기","정글 나이트 사파리"],"lat":4.38,"lng":102.4,"sources":["Wikivoyage","Trip.com"],"note":"말레이반도 내륙 파항/클란탄/트렝가누 3개 주"},{"country":"말레이시아","region":"말레이시아","city":"벤통","local":"Bentong / 文冬","kind":"소도시","desc":"티티왕사 산맥 자락의 소도시로 최고급 두리안인 '무상킹(Musang King)'의 고향. 차모앙 온천과 전통 생강, 주말 아침 시장으로 인기다.","known_for":["무상킹 두리안 과수원","벤통 생강 및 두부 요리","차모앙 온천","주말 아침 시장 투어"],"lat":3.52,"lng":101.91,"sources":["Wikivoyage","Trip.com"],"note":"말레이반도 내륙 파항주"},{"country":"말레이시아","region":"말레이시아","city":"코타바루","local":"Kota Bharu / 哥打峇鲁","kind":"중소도시","desc":"태국 국경과 가까운 클란탄주의 주도로 보수적이고 깊은 이슬람 말레이 전통 문화의 중심지. 시티 카디자 중앙시장의 돔 아래 상인들이 명물이다.","known_for":["시티 카디자 중앙시장","전통 연날리기(와우) 공방","자항 왕궁 박물관","그림자 인형극(와양 쿨릿)"],"lat":6.13,"lng":102.24,"sources":["Wikivoyage","Trip.com"],"note":"말레이반도 동해안 클란탄주 주도"},{"country":"말레이시아","region":"말레이시아","city":"쿠알라트렝가누","local":"Kuala Terengganu / 瓜拉登嘉楼","kind":"중소도시","desc":"남중국해에 면한 트렝가누주의 주도로 전통 배 건조와 바틱 공예의 중심지. 유리와 강철로 지어진 환상적인 크리스털 모스크가 있다.","known_for":["크리스털 모스크","이슬람 유산 공원","두용섬 전통 목조선 조선소","차이나타운 거리"],"lat":5.33,"lng":103.14,"sources":["Wikivoyage","Trip.com"],"note":"말레이반도 동해안 트렝가누주 주도"},{"country":"말레이시아","region":"말레이시아","city":"쿠안탄","local":"Kuantan / 关丹","kind":"중소도시","desc":"말레이반도 동해안 최대의 도시이자 파항주의 주도. 텔룩 쳄페닥 해변과 파란빛의 술탄 아흐마드 샤 모스크, 강변 산책로가 조성되어 있다.","known_for":["텔룩 쳄페닥 백사장","술탄 아흐마드 1세 모스크","판단 폭포","쿠안탄강 산책로"],"lat":3.81,"lng":103.33,"sources":["Wikivoyage","Trip.com"],"note":"말레이반도 동해안 파항주 주도"},{"country":"말레이시아","region":"말레이시아","city":"체라팅","local":"Cherating / 珍拉丁","kind":"마을","desc":"남중국해의 거친 파도가 밀려오는 말레이시아 최고의 서핑 성지이자 아시아 최초의 클럽메드가 자리한 한적한 해변 마을.","known_for":["몬순 시즌 파도 서핑","체라팅 거북 보호센터","맹그로브 반딧불이 강 크루즈","클럽메드 체라팅 비치"],"lat":4.13,"lng":103.39,"sources":["Wikivoyage","Trip.com"],"note":"말레이반도 동해안 파항주"},{"country":"말레이시아","region":"말레이시아","city":"프렌티안 제도","local":"Pulau Perhentian / 停泊岛","kind":"섬","desc":"남중국해 맑은 에메랄드빛 바다에 떠 있는 배낭여행자의 파라다이스. 바다거북 및 상어와 함께하는 스노클링으로 전 세계 여행자가 찾는다.","known_for":["바다거북 스노클링(터틀 포인트)","샤크 포인트 다이빙","코랄 베이 일몰","롱비치 야간 파이어쇼"],"lat":5.91,"lng":102.74,"sources":["Wikivoyage","Trip.com","네이버 블로그"],"note":"말레이반도 동해안 트렝가누주 (베사르·크칠)"},{"country":"말레이시아","region":"말레이시아","city":"르당섬","local":"Pulau Redang / 热浪岛","kind":"섬","desc":"영화 '하일마마(Summer Holiday)'의 촬영지로 유명한 백사장과 산호초의 섬. 해양공원 보호구역 안에서 최고급 리조트 휴양과 다이빙을 즐길 수 있다.","known_for":["파시르 판장 백사장","르당 해양공원 센터","베이비 상어 스노클링","고급 비치 리조트"],"lat":5.77,"lng":103.01,"sources":["Wikivoyage","Trip.com","마펑워"],"note":"말레이반도 동해안 트렝가누주"},{"country":"말레이시아","region":"말레이시아","city":"티오만섬","local":"Pulau Tioman / 刁曼岛","kind":"섬","desc":"깎아지른 화강암 쌍둥이 봉우리와 열대우림, 산호초가 어우러진 면세 섬. 정글 트레킹과 스쿠버 다이빙으로 명성 높다.","known_for":["살랑·아이르바탕 다이빙 포인트","아사 폭포 트레킹","면세 쇼핑","주아라 거북 부화장"],"lat":2.81,"lng":104.17,"sources":["Wikivoyage","Trip.com"],"note":"말레이반도 남동해안 파항주"},{"country":"말레이시아","region":"말레이시아","city":"카파스섬","local":"Pulau Kapas / 棉花岛","kind":"섬","desc":"마랑(Marang)에서 배로 15분 거리의 작고 고요한 '솜사탕 섬'. 상업화되지 않은 소박한 목조 방갈로와 투명한 바다가 매력적이다.","known_for":["청정 산호초 해변","해변 직결 스노클링","조용한 휴양 방갈로","섬 횡단 정글 하이킹"],"lat":5.22,"lng":103.26,"sources":["Wikivoyage","Trip.com"],"note":"말레이반도 동해안 트렝가누주"},{"country":"말레이시아","region":"말레이시아","city":"코타키나발루","local":"Kota Kinabalu / 亚庇","kind":"대도시","desc":"세계 3대 석양으로 꼽히는 탄중아루 해변과 툰쿠 압둘 라만 해양공원의 섬들이 있는 사바주의 주도이자 동말레이시아 최대 관광 허브.","known_for":["세계 3대 석양 탄중아루 비치","블루 모스크(시립 모스크)","툰쿠 압둘 라만 섬 투어","필리피노 야시장"],"lat":5.98,"lng":116.07,"sources":["Wikivoyage","Trip.com","네이버 블로그"],"note":"보르네오섬(동말레이시아 사바주 주도)"},{"country":"말레이시아","region":"말레이시아","city":"산다칸","local":"Sandakan / 山打根","kind":"중소도시","desc":"술루해에 면한 사바주 제2의 도시. 세계적인 세필록 오랑우탄 재활원과 코주부원숭이 보호구역, 키나바탕안강 정글 크루즈의 거점이다.","known_for":["세필록 오랑우탄 재활센터","라부크베이 코주부원숭이 보호구","키나바탕안강 사파리 크루즈","아그네스 키스 하우스"],"lat":5.84,"lng":118.12,"sources":["Wikivoyage","Trip.com"],"note":"보르네오섬(동말레이시아 사바주)"},{"country":"말레이시아","region":"말레이시아","city":"셈포르나","local":"Semporna / 仙本那","kind":"소도시","desc":"세계 10대 다이빙 포인트로 꼽히는 시파단섬(Sipadan)과 마불섬으로 들어가는 해양 레저의 메카. 바다 집시 바자우족의 수상 가옥이 이채롭다.","known_for":["시파단섬 스쿠버 다이빙","마불·카팔라이 수상 리조트","바자우족 바다 수상 마을","보헤이둘랑 화산섬 전망"],"lat":4.48,"lng":118.61,"sources":["Wikivoyage","Trip.com","마펑워"],"note":"보르네오섬(동말레이시아 사바주)"},{"country":"말레이시아","region":"말레이시아","city":"타와우","local":"Tawau / 斗湖","kind":"중소도시","desc":"인도네시아 칼리만탄 국경과 가까운 사바주 남동부의 항구 도시. 세계에서 가장 키가 큰 열대나무가 자라는 타와우 힐스 국립공원이 있다.","known_for":["타와우 힐스 국립공원(초고목)","중앙 야시장 미식","코코아 생산지 박물관","셈포르나 비행 환승 관문"],"lat":4.24,"lng":117.89,"sources":["Wikivoyage","Trip.com"],"note":"보르네오섬(동말레이시아 사바주)"},{"country":"말레이시아","region":"말레이시아","city":"쿠닷","local":"Kudat / 古达","kind":"소도시","desc":"보르네오섬의 최북단 곶인 '팁 오브 보르네오(Tip of Borneo)'가 있는 도시. 남중국해와 술루해가 만나는 바다 절경과 룽구스족 롱하우스가 있다.","known_for":["팁 오브 보르네오(보르네오 최북단)","룽구스족 전통 롱하우스","전통 징(Gong) 제작 마을","조용한 서핑 해변"],"lat":6.88,"lng":116.85,"sources":["Wikivoyage","Trip.com"],"note":"보르네오섬(동말레이시아 사바주)"},{"country":"말레이시아","region":"말레이시아","city":"키나발루 국립공원","local":"Kinabalu Park / 神山公园","kind":"자연지역","desc":"동남아시아 최고봉인 해발 4,095m 키나발루산이 솟아 있는 유네스코 세계자연유산. 포링 온천과 캐노피 워크웨이, 거대한 라플레시아 꽃이 자생한다.","known_for":["해발 4,095m 키나발루산 등반","포링 유황 온천","세계 최대 꽃 라플레시아","식충식물 네펜데스 정원"],"lat":6.03,"lng":116.54,"sources":["Wikivoyage","Trip.com"],"note":"보르네오섬(동말레이시아 사바주 라나우)"},{"country":"말레이시아","region":"말레이시아","city":"쿠칭","local":"Kuching / 古晋","kind":"대도시","desc":"'고양이의 도시'로 불리는 사라왁주의 주도. 사라왁강 워터프론트, 19세기 백인 브룩 라자 왕조의 역사적 건물과 코주부원숭이가 사는 바코 국립공원이 있다.","known_for":["바코 국립공원 야생 트레킹","사라왁강 워터프론트","사라왁 락사 및 콜로미","고양이 박물관"],"lat":1.55,"lng":110.35,"sources":["Wikivoyage","Trip.com"],"note":"보르네오섬(동말레이시아 사라왁주 주도)"},{"country":"말레이시아","region":"말레이시아","city":"미리","local":"Miri / 美里","kind":"중소도시","desc":"브루나이 국경과 인접한 사라왁주 제2의 도시이자 말레이시아 석유 산업의 발상지. 4만 년 전 인류 화석이 발견된 니아 동굴과 물루 국립공원의 관문이다.","known_for":["니아 국립공원 선사시대 동굴","캐나다 힐 그랜드 올드 레이디","구눙물루 국립공원 항공 관문","브루나이 육로 국경"],"lat":4.4,"lng":114,"sources":["Wikivoyage","Trip.com"],"note":"보르네오섬(동말레이시아 사라왁주)"},{"country":"말레이시아","region":"말레이시아","city":"시부","local":"Sibu / 诗巫","kind":"중소도시","desc":"보르네오 최장의 라장강(Rajang River) 유역에 위치한 상업 도시이자 푸저우(福州) 화교 문화의 중심지. 거대한 중앙시장과 전통 면 캄푸아미가 유명하다.","known_for":["라장강 여객선 터미널","시부 중앙시장(말레이 최대 실내시장)","푸저우 전통 캄푸아미","영안정 백탑(투아펙콩)"],"lat":2.3,"lng":111.82,"sources":["Wikivoyage","Trip.com"],"note":"보르네오섬(동말레이시아 사라왁주)"},{"country":"말레이시아","region":"말레이시아","city":"빈툴루","local":"Bintulu / 民都鲁","kind":"중소도시","desc":"사라왁주 중부 해안의 에너지 산업 도시. 해안 절벽과 붉은 모래사장이 어우러진 시밀라자우 국립공원에서 야생 바다악어를 관찰할 수 있다.","known_for":["시밀라자우 국립공원 해안 트레킹","야생 바다악어 관찰","탄중바투 해변","파사르 타마 중앙시장"],"lat":3.17,"lng":113.03,"sources":["Wikivoyage","Trip.com"],"note":"보르네오섬(동말레이시아 사라왁주)"},{"country":"말레이시아","region":"말레이시아","city":"구눙물루 국립공원","local":"Gunung Mulu National Park / 姆鲁山国家公园","kind":"자연지역","desc":"유네스코 세계자연유산으로 지정된 카르스트 지형의 경이. 세계 최대의 지하 공간인 사라왁 체임버와 사슴 동굴의 수백만 마리 박쥐 엑소더스가 펼쳐진다.","known_for":["디어 케이브 박쥐 엑소더스","세계 최대 사라왁 체임버","카르스트 피나클(Pinnacles) 암봉","헤드헌터 트레일"],"lat":4.13,"lng":114.92,"sources":["Wikivoyage","Trip.com"],"note":"보르네오섬(동말레이시아 사라왁주)"},{"country":"말레이시아","region":"말레이시아","city":"라부안","local":"Labuan / 纳闽","kind":"섬","desc":"브루나이만 입구에 위치한 연방직할 면세 섬이자 국제 역외금융 중심지. 제2차 세계대전 난파선 다이빙과 평화 공원이 유명하다.","known_for":["난파선 스쿠버 다이빙","면세 쇼핑","2차 대전 평화 공원","굴뚝 박물관(The Chimney)"],"lat":5.28,"lng":115.24,"sources":["Wikivoyage","Trip.com"],"note":"보르네오섬 연안 연방직할구 섬"},{"country":"싱가포르","region":"싱가포르","city":"마리나 베이","local":"Marina Bay / 滨海湾","kind":"소도시","desc":"초현대적 스카이라인과 해안 만이 어우러진 싱가포르의 상징적 워터프론트 구역. 마리나 베이 샌즈 호텔과 미래형 식물원 가든스 바이 더 베이가 자리한다.","known_for":["마리나 베이 샌즈","가든스 바이 더 베이","머라이언 파크","싱가포르 플라이어"],"lat":1.28,"lng":103.85,"sources":["Wikivoyage","Trip.com"],"note":"도심 워터프론트 지구"},{"country":"싱가포르","region":"싱가포르","city":"차이나타운","local":"Chinatown / 牛车水","kind":"소도시","desc":"19세기 중국계 이주민 역사가 보존된 전통과 트렌드의 공존 지구. 부처의 치아 사리가 모셔진 불아사와 대규모 호커 센터가 유명하다.","known_for":["불아사 용화원","스리 마리암만 힌두사원","차이나타운 컴플렉스 호커센터","파고다 스트리트 전통 샵하우스"],"lat":1.28,"lng":103.84,"sources":["Wikivoyage","Trip.com","마펑워"],"note":"역사적 중국계 헤리티지 지구"},{"country":"싱가포르","region":"싱가포르","city":"캄퐁 글램","local":"Kampong Glam / 甘榜格南","kind":"소도시","desc":"황금빛 돔의 술탄 모스크를 중심으로 형성된 말레이·아랍 역사 문화 지구. 감각적인 벽화와 독립 부티크가 늘어선 하지 레인이 명소다.","known_for":["술탄 모스크","하지 레인(Haji Lane) 골목","아랍 스트리트 향수·직물점","말레이 헤리티지 센터"],"lat":1.3,"lng":103.86,"sources":["Wikivoyage","Trip.com","네이버 블로그"],"note":"말레이·이슬람 헤리티지 지구"},{"country":"싱가포르","region":"싱가포르","city":"리틀 인디아","local":"Little India / 小印度","kind":"소도시","desc":"화려한 색채와 짙은 향신료 향기가 가득한 인도계 공동체 문화 지구. 정교한 힌두교 사원과 24시간 대형 쇼핑몰 무스타파 센터가 있다.","known_for":["스리 비라마칼리암만 사원","무스타파 센터","테카 센터(인도 요리 호커)","세랑군 로드 전통 골목"],"lat":1.31,"lng":103.85,"sources":["Wikivoyage","Trip.com"],"note":"인도계 헤리티지 지구"},{"country":"싱가포르","region":"싱가포르","city":"카통·주치앗","local":"Katong & Joo Chiat / 加东·如切","kind":"소도시","desc":"중국과 말레이 문화가 융합된 페라나칸(바바뇨냐) 전통이 가장 잘 보존된 동부 지구. 파스텔톤 전통 샵하우스와 원조 카통 락사가 유명하다.","known_for":["페라나칸 파스텔 샵하우스","328 카통 락사","쿠에(전통 떡) 디저트 카페","주치앗 로드 레트로 거리"],"lat":1.3,"lng":103.9,"sources":["Wikivoyage","Trip.com","네이버 블로그"],"note":"페라나칸 헤리티지 지구"},{"country":"싱가포르","region":"싱가포르","city":"오차드 로드","local":"Orchard Road / 乌节路","kind":"소도시","desc":"2.2km 대로를 따라 세계적인 백화점과 럭셔리 쇼핑몰이 늘어선 아시아 최고의 쇼핑 거리. 고풍스러운 에메랄드 힐 샵하우스가 숨어 있다.","known_for":["아이온 오차드(ION)","에메랄드 힐 샵하우스 골목","다카시마야 쇼핑센터","오차드 도서관"],"lat":1.3,"lng":103.83,"sources":["Wikivoyage","Trip.com"],"note":"대표 쇼핑 지구"},{"country":"싱가포르","region":"싱가포르","city":"시빅 디스트릭트","local":"Civic District / 市政区","kind":"소도시","desc":"영국 식민지 시절 행정의 중심지였던 역사 구역. 옛 대법원을 개조한 내셔널 갤러리와 푸른 포트 캐닝 공원의 트리 터널이 유명하다.","known_for":["내셔널 갤러리 싱가포르","포트 캐닝 파크 트리 터널","성 안드레아 성당","빅토리아 극장"],"lat":1.29,"lng":103.85,"sources":["Wikivoyage","Trip.com"],"note":"식민지 역사 및 문화예술 지구"},{"country":"싱가포르","region":"싱가포르","city":"클락 키·로버슨 키","local":"Clarke Quay & Robertson Quay / 克拉码头·罗拔申码头","kind":"소도시","desc":"싱가포르 강변을 따라 늘어선 옛 부두 창고들이 개조된 대표적인 나이트라이프 지구. 리버 크루즈와 칠리크랩 레스토랑이 밀집해 있다.","known_for":["싱가포르 리버 크루즈","점보 시푸드 칠리크랩","강변 펍 및 라이브 클럽","로버슨 키 브런치 카페"],"lat":1.29,"lng":103.84,"sources":["Wikivoyage","Trip.com"],"note":"싱가포르강 나이트라이프 지구"},{"country":"싱가포르","region":"싱가포르","city":"티옹 바루","local":"Tiong Bahru / 中峇鲁","kind":"소도시","desc":"1930년대 지어진 유선형 아르데코 양식 공공주택 단지가 남아 있는 레트로 지구. 개성 넘치는 독립 서점과 카페, 유명 호커 시장이 있다.","known_for":["아르데코 양식 전통 주택","티옹바루 마켓 호커센터","독립 서점(BooksActually)","베이커리 카페 골목"],"lat":1.28,"lng":103.83,"sources":["Wikivoyage","Trip.com","네이버 블로그"],"note":"헤리티지 카페 지구"},{"country":"싱가포르","region":"싱가포르","city":"탄종 파가","local":"Tanjong Pagar / 丹戎巴葛","kind":"소도시","desc":"전통 샵하우스와 현대식 마천루가 맞닿은 금융과 미식의 중심지. 유명한 맥스웰 푸드센터의 치킨라이스와 한식당 골목이 번화하다.","known_for":["맥스웰 푸드센터(티안티안 치킨라이스)","핀클리프 로드 바 거리","피너클@덕스톤 전망대","탄종파가 코리안 타운"],"lat":1.27,"lng":103.84,"sources":["Wikivoyage","Trip.com"],"note":"CBD 인접 미식 지구"},{"country":"싱가포르","region":"싱가포르","city":"부기스","local":"Bugis / 武吉士","kind":"소도시","desc":"다양한 쇼핑 스트리트와 활기찬 로컬 시장이 공존하는 번화가. 저렴한 기념품과 패션이 모인 부기스 스트리트와 관음당 사찰이 있다.","known_for":["부기스 스트리트 시장","부기스 정션 쇼핑몰","관음당 불조사","알버트 센터 호커"],"lat":1.3,"lng":103.85,"sources":["Wikivoyage","Trip.com"],"note":"도심 쇼핑 및 문화 지구"},{"country":"싱가포르","region":"싱가포르","city":"겔랑","local":"Geylang / 芽笼","kind":"소도시","desc":"싱가포르 동부의 독특한 서민 구역으로 밤늦게까지 불이 켜진 미식 골목. 유명한 개구리 죽과 신선한 두리안 노점, 보존된 샵하우스가 특징이다.","known_for":["겔랑 로롱 개구리 죽(Frog Porridge)","두리안 전문 노점 거리","전통 중국식 딤섬집","전통 보존 샵하우스 로롱"],"lat":1.31,"lng":103.88,"sources":["Wikivoyage","Trip.com"],"note":"동부 심야 미식 지구"},{"country":"싱가포르","region":"싱가포르","city":"발레스티에","local":"Balestier / 马里士他","kind":"소도시","desc":"오차드 북쪽에 위치한 역사와 로컬 미식의 거리. 신해혁명 지도자 쑨원의 기념관과 송파·발레스티에 바쿠테 노포, 전통 빵집이 모여 있다.","known_for":["손종산 남양기념관(쑨원 빌라)","원조 발레스티에 바쿠테","전통 로티 빵집","황푸 푸드센터"],"lat":1.32,"lng":103.85,"sources":["Wikivoyage","Trip.com"],"note":"중부 역사 및 바쿠테 미식 지구"},{"country":"싱가포르","region":"싱가포르","city":"센토사","local":"Sentosa / 圣淘沙","kind":"섬","desc":"본섬 남쪽 해상에 위치한 아시아 최고의 복합 레저 휴양 섬. 유니버설 스튜디오 테마파크와 거대 아쿠아리움, 실로소 백사장이 펼쳐진다.","known_for":["유니버설 스튜디오 싱가포르","S.E.A. 아쿠아리움","실로소 비치 휴양","케이블카 및 메가집라인"],"lat":1.25,"lng":103.83,"sources":["Wikivoyage","Trip.com"],"note":"남부 대표 레저 휴양 섬"},{"country":"싱가포르","region":"싱가포르","city":"풀라우 우빈","local":"Pulau Ubin / 乌敏岛","kind":"섬","desc":"창이 포인트에서 범보트로 들어가는 북동부 섬. 싱가포르의 1960년대 원시 캄퐁(시골 마을) 정취와 체크 자와 해안 습지가 원형 그대로 보존되어 있다.","known_for":["체크 자와(Chek Jawa) 갯벌 습지","자전거 섬 일주 트레킹","옛 전통 캄퐁 목조 마을","야생 멧돼지와 원숭이"],"lat":1.41,"lng":103.96,"sources":["Wikivoyage","Trip.com","네이버 블로그"],"note":"북동부 전통 캄퐁 보존 섬"},{"country":"싱가포르","region":"싱가포르","city":"남부 섬들","local":"Southern Islands / 南部群岛","kind":"섬","desc":"세인트존스섬, 라자루스섬, 쿠수섬으로 이루어진 남부 청정 도서 군. 에메랄드빛 초승달 해변과 한적한 피크닉, 고양이 섬으로 힐링 여행자에게 인기다.","known_for":["라자루스 아일랜드 백사장","세인트존스 아일랜드 트레킹","쿠수 아일랜드 거북 사원","아일랜드 호핑 페리"],"lat":1.22,"lng":103.85,"sources":["Wikivoyage","Trip.com"],"note":"세인트존스·라자루스·쿠수 등 남부 군도"},{"country":"싱가포르","region":"싱가포르","city":"만다이","local":"Mandai Wildlife Reserve / 万礼","kind":"자연지역","desc":"세계적 수준의 개방형 야생동물 서식 구역. 싱가포르 동물원, 밤의 야생을 탐험하는 나이트 사파리, 거대 조류 파크 버드 파라다이스가 모여 있다.","known_for":["세계 최초 나이트 사파리","싱가포르 동물원 오랑우탄 아침식사","버드 파라다이스(대형 조류관)","리버 원더스 판다 숲"],"lat":1.4,"lng":103.79,"sources":["Wikivoyage","Trip.com"],"note":"북부 만다이 야생동물 보호구역"},{"country":"싱가포르","region":"싱가포르","city":"부킷 티마","local":"Bukit Timah / 武吉知马","kind":"자연지역","desc":"싱가포르 최고봉인 해발 163m 부킷티마 언덕을 품은 원시 열대우림 보호구역. 옛 철도 회랑(Rail Corridor) 트레일과 희귀 야생동식물이 서식한다.","known_for":["부킷티마 정상 하이킹","원시 1차 열대우림","철도 회랑(Rail Corridor)","힌드히데 채석장 호수"],"lat":1.35,"lng":103.78,"sources":["Wikivoyage","Trip.com"],"note":"중부 원시자연보호구역"},{"country":"싱가포르","region":"싱가포르","city":"숭게이 블로 습지 보호구역","local":"Sungei Buloh Wetland Reserve / 双溪布洛湿地保护区","kind":"자연지역","desc":"말레이시아 조호르를 마주보는 싱가포르 최초의 람사르 습지 보호구역. 맹그로브 숲 보드워크를 따라 야생 바다악어와 철새를 탐조할 수 있다.","known_for":["맹그로브 보드워크 탐방","야생 바다악어 관찰","모니터 도마뱀","국제 철새 도래지 탐조"],"lat":1.45,"lng":103.73,"sources":["Wikivoyage","Trip.com"],"note":"북서부 람사르 맹그로브 습지"},{"country":"싱가포르","region":"싱가포르","city":"이스트 코스트 파크","local":"East Coast Park / 东海岸公园","kind":"자연지역","desc":"남중국해를 따라 15km에 걸쳐 조성된 싱가포르 최대의 해안 공원. 시원한 바닷바람 속 자전거 라이딩과 해변 바비큐, 해산물 라군 호커센터가 유명하다.","known_for":["15km 해안 자전거 전용도로","이스트코스트 라군 푸드빌리지","해변 롤러스케이트 및 피크닉","점보 해산물 센터"],"lat":1.3,"lng":103.91,"sources":["Wikivoyage","Trip.com"],"note":"동남부 해안 레저 공원"},{"country":"싱가포르","region":"싱가포르","city":"주롱","local":"Jurong / 裕廊","kind":"소도시","desc":"서부의 상업 및 혁신 허브이자 주롱 호수를 품은 녹색 정원 도시. 주롱 레이크 가든스와 중국 정원, 싱가포르 과학센터가 위치한다.","known_for":["주롱 레이크 가든스","중국 정원(차이니즈 가든)","싱가포르 사이언스 센터","스노우 시티"],"lat":1.33,"lng":103.74,"sources":["Wikivoyage","Trip.com"],"note":"서부 호수 정원 및 신도시 지구"},{"country":"싱가포르","region":"싱가포르","city":"창이","local":"Changi / 樟宜","kind":"소도시","desc":"세계 최고의 공항으로 꼽히는 창이공항과 주얼 창이가 있는 동부 관문. 해안선 보드워크와 창이 빌리지의 나시레막 호커가 유명하다.","known_for":["주얼 창이 레인 보텍스(실내 폭포)","창이 포인트 코스탈 워크","창이 빌리지 나시레막","창이 감옥 박물관"],"lat":1.36,"lng":103.99,"sources":["Wikivoyage","Trip.com"],"note":"동부 관문 및 해안 마을"},{"country":"싱가포르","region":"싱가포르","city":"템피니스·파시르리스","local":"Tampines & Pasir Ris / 淡滨尼·巴西立","kind":"소도시","desc":"유엔 주거상을 수상한 싱가포르 동부의 대표 주거 허브. 파시르리스 맹그로브 숲 보드워크와 다운타운 이스트 엔터테인먼트 시설이 있다.","known_for":["파시르리스 맹그로브 공원","아워 템피니스 허브(복합 체육문화센터)","다운타운 이스트 와일드와일드웨트","동부 로컬 라이프스타일"],"lat":1.35,"lng":103.94,"sources":["Wikivoyage","Trip.com"],"note":"동부 대형 주거 및 레저 지구"},{"country":"싱가포르","region":"싱가포르","city":"맥리치 저수지","local":"MacRitchie Reservoir / 麦里芝蓄水池","kind":"자연지역","desc":"싱가포르에서 가장 오래된 저수지이자 도심 속 허파. 열대우림 수관 위를 걷는 250m 길이의 현수교 '트리탑 워크'와 둘레길 하이킹 코스가 유명하다.","known_for":["트리탑 워크(공중 현수교)","저수지 원시림 트레킹","카약 및 카누 대여","야생 꼬리감는원숭이 관찰"],"lat":1.34,"lng":103.83,"sources":["Wikivoyage","Trip.com"],"note":"중부 대표 저수지 자연공원"},{"country":"싱가포르","region":"싱가포르","city":"보타닉 가든","local":"Singapore Botanic Gardens / 新加坡植物园","kind":"자연지역","desc":"160년 이상의 역사를 자랑하는 싱가포르 최초의 유네스코 세계문화유산. 1,000종 이상의 희귀 난초가 피어나는 국립 난초 정원과 고목들이 평화롭다.","known_for":["유네스코 세계문화유산 식물원","국립 난초 정원(내셔널 오키드 가든)","심포니 호수 야외 음악당","도심 속 무료 힐링 공원"],"lat":1.31,"lng":103.82,"sources":["Wikivoyage","Trip.com"],"note":"유네스코 세계문화유산 식물원"}]