[{"id": "chiang-mai-wat-phra-that-doi-suthep", "seg": "chiang-mai", "city": "치앙마이", "cat": "종교·사원", "name": "왓 프라탓 도이수텝", "local": "Wat Phra That Doi Suthep / วัดพระธาตุดอยสุเทพราชวรวิหาร", "desc": "1383년 란나 왕국의 쿠나 왕이 해발 1,053m 도이수텝 산 정상 부근에 건립한 치앙마이에서 가장 신성한 불교 사원이다. 부처의 사리를 모신 황금빛 쩨디와 306개 계단의 나가 조각, 치앙마이 시내를 한눈에 내려다보는 탁 트인 전망대를 갖추고 있다.", "tags": ["황금사원", "전망대", "란나양식", "불교사리탑"], "area": "도이수텝 산", "lat": 18.805, "lng": 98.9216, "photo_query": "Wat Phra That Doi Suthep Chiang Mai", "photos": ["packs/spots-chiang-mai-1/0.jpg", "packs/spots-chiang-mai-1/1.jpg", "packs/spots-chiang-mai-1/2.jpg", "packs/spots-chiang-mai-1/3.jpg"], "photo_src": ["https://www.tripsavvy.com/chiang-mai-wat-phra-that-doi-suthep-guide-4152049", "https://www.roughguides.com/articles/chiang-mai-weather-february-travel-tips/", "https://holeinthedonut.com/2018/04/04/wat-phra-that-doi-suthep-chiang-mai-thailand/", "https://blog.bangkokair.com/en/wat-phra-that-doi-suthep-chiang-mai/"], "sources": ["https://en.wikipedia.org/wiki/Wat_Phra_That_Doi_Suthep", "https://en.wikivoyage.org/wiki/Chiang_Mai"], "note": "사진 검색: bing", "fee": {"amount": 30, "currency": "THB", "free": false, "text": "외국인 입장료 30 THB", "krw": 1185}, "transport": {"how": "창푸악 게이트 또는 치앙마이 대학교 정문 앞에서 도이수텝행 붉은 썽태우(합승) 탑승", "cost": {"amount": 60, "currency": "THB"}, "krw": 2370}, "duration_min": 120, "hours": "06:00-20:00", "closed": "연중무휴", "category_std": "temple"}, {"id": "chiang-mai-wat-chedi-luang", "seg": "chiang-mai", "city": "치앙마이", "cat": "건축", "name": "왓 체디루앙", "local": "Wat Chedi Luang / วัดเจดีย์หลวงวรวิหาร", "desc": "14세기에 건립되어 한때 86m 높이로 치앙마이에서 가장 웅장했던 거대한 란나 양식의 벽돌 불탑 유적 사원이다. 1545년 대지진으로 상부가 무너져 지금의 웅장한 반파 형태를 간직하고 있으며, 과거 방콕 왓 프라깨우의 에메랄드 불상이 84년간 봉안되었던 역사적인 장소이다.", "tags": ["벽돌불탑", "14세기유적", "란나건축", "올드시티중심"], "area": "올드시티", "lat": 18.7865, "lng": 98.9867, "photo_query": "Wat Chedi Luang Chiang Mai", "photos": ["packs/spots-chiang-mai-1/4.jpg", "packs/spots-chiang-mai-1/5.jpg", "packs/spots-chiang-mai-1/6.jpg"], "photo_src": ["https://www.arrivalguides.com/en/Travelguide/CHIANGMAI/doandsee/wat-chedi-luang-39016", "https://www.limkimkeong.com/wat-chedi-luang-chiang-mai-thailand/", "https://www.tripsavvy.com/chiang-mai-wat-chedi-luang-guide-4153997"], "sources": ["https://en.wikipedia.org/wiki/Wat_Chedi_Luang", "https://en.wikivoyage.org/wiki/Chiang_Mai"], "note": "사진 검색: bing", "fee": {"amount": 40, "currency": "THB", "free": false, "text": "외국인 성인 입장료 40 THB", "krw": 1580}, "transport": {"how": "올드시티 중심부 프라뽁끌라오 로드에 위치하여 도보 또는 자전거로 이동", "cost": {"amount": 0, "currency": "THB"}, "krw": 0}, "duration_min": 60, "hours": "06:00-18:00", "closed": "연중무휴", "category_std": "sight"}, {"id": "chiang-mai-sunday-walking-street", "seg": "chiang-mai", "city": "치앙마이", "cat": "시장", "name": "선데이 워킹스트리트", "local": "Sunday Walking Street / ถนนคนเดินท่าแพ", "desc": "매주 일요일 오후 타패 게이트부터 왓 프라싱까지 약 1km의 랏차담넌 로드가 보행자 전용 구역으로 바뀌며 열리는 태국 최대 규모의 주말 야시장이다. 북부 전통 수공예품, 목조 조각, 의류, 은세공품과 함께 사원 경내에 마련된 푸드코트에서 다양한 로컬 길거리 음식을 판매한다.", "tags": ["일요야시장", "보행자전용", "수공예품", "길거리음식"], "area": "올드시티 랏차담넌 로드", "lat": 18.7883, "lng": 98.988, "photo_query": "Sunday Walking Street Chiang Mai", "photos": ["packs/spots-chiang-mai-1/7.jpg", "packs/spots-chiang-mai-1/8.jpg", "packs/spots-chiang-mai-1/9.jpg"], "photo_src": ["https://www.cktravels.com/sunday-walking-street-market-chiang-mai-guide/", "https://gotothailand.com/walking-street-chiang-mai/", "https://www.eastinhotelsresidences.com/eastintanchiangmai/attractions/sunday-walking-street-chiang-mai"], "sources": ["https://en.wikipedia.org/wiki/Sunday_Walking_Street", "https://en.wikivoyage.org/wiki/Chiang_Mai"], "note": "사진 검색: bing", "fee": {"free": true}, "transport": {"how": "타패 게이트에서 올드시티 중심부 왓 프라싱까지 이어지는 랏차담넌 로드로 도보 이동", "cost": {"amount": 0, "currency": "THB"}, "krw": 0}, "duration_min": 120, "hours": "일요일 16:00-23:00", "closed": "월~토요일 휴무 (일요일만 운영)", "category_std": "market"}, {"id": "chiang-mai-wat-phra-singh", "seg": "chiang-mai", "city": "치앙마이", "cat": "종교·사원", "na