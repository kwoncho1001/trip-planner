/0.jpg"], "photo_src": ["https://commons.wikimedia.org/wiki/File:B%E1%BA%A3o_t%C3%A0ng_Ph%C3%BA_Y%C3%AAn.jpg"], "sources": ["https://ae.trip.com/travel-guide/attraction/tuy-hoa/ph-yn-museum-143793893/", "https://sovaba.travel/blog/kham-pha-bao-tang-phu-yen", "https://mia.vn/cam-nang-du-lich/bao-tang-phu-yen-noi-luu-giu-truyen-thong-van-hoa-lau-doi-2204"], "fee": {"free": true}, "transport": {"how": "뚜이호아역 또는 시내 중심 쩐푸(Trần Phú) 거리 따라 도보 약 10~15분"}, "duration_min": 60, "hours": "08:00-11:00, 14:00-16:30", "closed": "월요일 휴무"}, {"id": "tuyhoa-t2a-ong-cop-wooden-bridge", "seg": "tuy-hoa", "city": "뚜이호아", "cat": "건축", "name": "옹콥 나무다리", "local": "Cầu gỗ Ông Cọp / Ong Cop Wooden Bridge", "desc": "푸응언 강을 가로지르는 길이 약 800m 규모의 베트남 최장 목조 다리. 나무 널빤지와 대나무로 엮어 주민들이 직접 보수·관리하며, 해 질 무렵 강 위를 건너는 이국적 풍경이 인기다.", "tags": ["목조다리", "베트남최장", "강변일몰", "포토스팟"], "area": "뚜이안(안닌떠이)", "lat": 13.3633, "lng": 109.2415, "photo_query": "Ong Cop bridge", "photos": [], "photo_src": [], "sources": ["https://www.trip.com/moments/detail/phu-yen-2189869-151402127/", "https://www.greensm.com/vn-vi/news/cau-go-ong-cop"], "fee": {"amount": 1000, "currency": "VND", "text": "보행자 약 1,000~2,000 VND (자전거 약 2,000~3,000 VND, 이륜차 약 3,000~5,000 VND)"}, "transport": {"how": "뚜이호아 시내버스 8번 또는 10번 탑승 후 안탁(An Thạch)·빈바강 인근 하차 후 도보 이동(우기 홍수 시 통행 제한 가능)"}, "duration_min": 40, "hours": "주간 상시 통행", "closed": "연중무휴 (홍수 시 임시 폐쇄 가능)"}, {"id": "tuyhoa-t2a-ganh-den-lighthouse", "seg": "tuy-hoa", "city": "뚜이호아", "cat": "야경·전망", "name": "갼덴 등대", "local": "Hải đăng Gành Đèn / Ganh Den Lighthouse", "desc": "겐다디아에서 북쪽으로 약 1.5km 떨어진 연분홍빛 화강암 해안 절벽 위에 서 있는 붉은색·흰색 줄무늬 등대. 2002년 완공되어 쑤언다이 만 항로를 비추며 일출·일몰 해안 전망이 탁월하다.", "tags": ["해안등대", "분홍화강암", "일출일몰", "무료"], "area": "뚜이안(안닌동)", "lat": 13.364, "lng": 109.2939, "photo_query": "Gành Đèn", "photos": ["packs/spots-t2a-tuyhoa-1/1.jpg", "packs/spots-t2a-tuyhoa-1/2.jpg"], "photo_src": ["https://www.flickr.com/photos/68029200@N08/25246966642", "https://www.flickr.com/photos/68029200@N08/24718289643"], "sources": ["https://www.trip.com/moments/detail/tuy-an-district-1540658-140213159", "https://www.traveloka.com/vi-vn/explore/destination/hai-dang-ganh-den-acc/229232", "https://vinpearl.com/vi/hai-dang-ganh-den-phu-yen-dak-lak"], "fee": {"free": true}, "transport": {"how": "뚜이호아 시내버스 10번(해안도로) 탑승 후 안닌동(An Ninh Đông) 하차, 또는 겐다디아에서 해안길 도보 이동"}, "duration_min": 50, "hours": "24시간 개방", "closed": "연중무휴"}, {"id": "tuyhoa-t2a-xom-ro-breakwater", "seg": "tuy-hoa", "city": "뚜이호아", "cat": "기묘·숨은곳", "name": "솜로 이끼 방파제", "local": "Bờ kè Xóm Rớ / Xom Ro Mossy Breakwater", "desc": "해안 침식을 막기 위해 놓은 콘크리트 테트라포드 블록마다 선명한 초록빛 바다 이끼가 자라나는 특이한 해변 방파제. 주로 1~4월 봄철 간조 시간대와 이른 아침 햇살 아래 이끼 풍경이 가장 선명하다.", "tags": ["이끼방파제", "계절풍경", "일출산책", "무료"], "area": "뚜이호아(푸동)", "lat": 13.0717, "lng": 109.3379, "photo_query": "Xom Ro", "photos": [], "photo_src": [], "sources": ["https://us.trip.com/travel-guide/attraction/phu-yen/b-k-xm-r-144568562/", "https://www.trip.com/moments/detail/phu-yen-2186639-134430109/", "https://vinpearl.com/vi/ke-chan-song-xom-ro-phu-yen-dak-lak"], "fee": {"free": true}, "transport": {"how": "뚜이호아 시내에서 훙브엉(Hùng Vương) 다리를 건너 남동쪽 푸동(Phú Đông) 해안까지 도보 또는 자전거 이동"}, "duration_min": 45, "hours": "24시간 개방", "closed": "연중무휴"}, {"id": "tuyhoa-t2a-vung-ro-bay", "seg": "tuy-hoa", "city": "뚜이호아", "cat": "자연", "name": "붕로 만", "local": "Vịnh Vũng Rô / Vung Ro Bay", "desc": "데오까 산맥과 다비아 봉우리가 세 방향을 감싸 안은 수심 깊고 잔잔한 천연 만. 에메랄드빛 만내 어촌 풍경과 함께 베트남 전쟁 시기 '무번선(Tàu Không Số)' 해상 보급로 국가사적지가 자리한다.", "tags": ["천연만", "무번선유적", "데오까산맥", "무료"], "area": "동호아(호아쑤언남)", "lat": 12.8712, "lng": 109.4143, "photo_query": "Vinh Vung Ro Phu Yen", "photos": ["packs/spots-t2a-tuyhoa-1/3.jpg", "packs/spots-t2a-tuyhoa-1/4.jpg", "packs/spots-t2a-tuyhoa-1/5.jpg"], "photo_src": ["https://commons.wikimedia.org/wiki/File:V%E1%BB%8Bnh_V%C5%A9ng_R%C3%B4.jpg", "https://commons.wikimedia.org/wiki/File:V%C5%A9ng_R%C3%B4_1.jpg", "https://commons.wikimedia.org/wiki/File:Vung_Ro_Bay.jpg"], "sources": ["https://qa.trip.com/tra