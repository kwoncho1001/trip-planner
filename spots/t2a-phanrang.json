[{"id": "phanrang-t2a-hang-rai", "seg": "phan-rang-thap-cham", "city": "판랑-탑짬", "cat": "자연", "name": "항라이", "local": "Hang Rái", "desc": "누이쭈아 국립공원 해안에 융기한 고대 화석 산호초 지형으로, 파도가 층상 암반을 덮치며 폭포처럼 흘러내리는 장관이 펼쳐진다. 특히 이른 아침 일출 시간대에 붉은빛과 물보라가 어우러진 풍경을 감상할 수 있다.", "tags": ["산호절벽", "일출명소", "누이쭈아", "해안지형"], "area": "빈하이·누이쭈아", "lat": 11.678, "lng": 109.1825, "photo_query": "Hang Rai Nui Chua Ninh Thuan coral reef sea", "photos": ["packs/spots-t2a-phanrang-1/0.jpg", "packs/spots-t2a-phanrang-1/1.jpg", "packs/spots-t2a-phanrang-1/2.jpg", "packs/spots-t2a-phanrang-1/3.jpg"], "photo_src": ["https://commons.wikimedia.org/wiki/File:Hang_R%C3%A1i_in_Ninh_Thuan_Province,_Vietnam.jpg", "https://commons.wikimedia.org/wiki/File:H%C3%A0ng_R%C3%A1i_(37780900851).jpg", "https://commons.wikimedia.org/wiki/File:H%C3%A0ng_R%C3%A1i_(37071594904).jpg", "https://www.flickr.com/photos/155243725@N03/39633388680", "https://www.flickr.com/photos/46838184@N06/34423729725", "https://www.flickr.com/photos/46838184@N06/34264268192"], "sources": ["https://us.trip.com/travel-guide/attraction/vinh-hai/khu-du-lch-hang-ri-136948867/", "https://blog.vexere.com/hang-rai-ninh-thuan/"], "fee": {"amount": 50000, "currency": "VND", "text": "성인 약 30,000~50,000 VND (시기별 상이, 전동카트 왕복 약 10,000~20,000 VND 별도)"}, "transport": {"how": "판랑 시장에서 FUTA 03번 시내버스(빈히 방면) 탑승 후 항라이 입구 정류장 하차(약 45분, 요금 10,000~30,000 VND)"}, "duration_min": 90, "hours": "06:00-17:30", "closed": "연중무휴"}, {"id": "phanrang-t2a-trung-son-co-tu", "seg": "phan-rang-thap-cham", "city": "판랑-탑짬", "cat": "종교·사원", "name": "쭝선꼬뜨 사원", "local": "Trùng Sơn Cổ Tự", "desc": "다쫑 산 언덕에 자리한 웅장한 북종 불교 사원으로, 푸른 석조 계단과 용 조각상을 따라 오르면 대형 관음보살상이 나온다. 사원 마당에서 닌쯔 해변과 담나이 석호, 판랑 시내 전경을 한눈에 조망할 수 있다.", "tags": ["산상사원", "전망명소", "불교건축", "닌쯔인근"], "area": "닌하이·칸하이", "lat": 11.5934, "lng": 109.0308, "photo_query": "Trùng Sơn Cổ Tự Ninh Thuận", "photos": [], "photo_src": [], "sources": ["https://www.trip.com/travel-guide/attraction/tt-khanh-hai/trung-son-co-tu-48144190"], "fee": {"free": true}, "transport": {"how": "판랑 시내에서 자전거(약 20분) 또는 FUTA 03번 시내버스(닌쯔·치투이 방면) 탑승 후 다쫑 산 입구 하차 후 계단 도보 이동"}, "duration_min": 60, "hours": "07:00-20:00", "closed": "연중무휴"}, {"id": "phanrang-t2a-ninh-thuan-museum", "seg": "phan-rang-thap-cham", "city": "판랑-탑짬", "cat": "박물관", "name": "닌투언 박물관", "local": "Bảo tàng Ninh Thuận", "desc": "참파 사원과 돛 모양에서 영감을 얻은 현대식 삼각형 건물이 돋보이는 도립 박물관이다. 참족과 라글라이족 민속 유물, 고대 참파 석조 조각과 지역 역사 자료를 관람할 수 있다.", "tags": ["참파유물", "라글라이문화", "현대건축", "시내관광"], "area": "미하이·16/4광장", "lat": 11.564, "lng": 108.9994, "photo_query": "Bao tang Ninh Thuan Museum Phan Rang architecture", "photos": ["packs/spots-t2a-phanrang-1/4.jpg", "packs/spots-t2a-phanrang-1/5.jpg"], "photo_src": ["https://commons.wikimedia.org/wiki/File:B%E1%BA%A3o_t%C3%A0ng_Ninh_Thu%E1%BA%ADn,_Qu%E1%BA%A3ng_tr%C6%B0%E1%BB%9Dng_16-4,_Phan_Rang.jpg", "https://commons.wikimedia.org/wiki/File:B%E1%BA%A3o_t%C3%A0ng_t%E1%BB%89nh_Ninh_Thu%E1%BA%ADn.jpg"], "sources": ["https://us.trip.com/travel-guide/attraction/my-hai/ninh-thun-museum-143790444/", "https://en.wikivoyage.org/wiki/Phan_Rang%E2%80%93Th%C3%A1p_Ch%C3%A0m"], "fee": {"free": true}, "transport": {"how": "판랑 중심가(판랑 시장)에서 도보 약 15분 또는 자전거 약 6분(16/4 광장 바로 옆)"}, "duration_min": 60, "hours": "07:30-11:30, 13:30-17:00", "closed": "연중무휴"}, {"id": "phanrang-t2a-binh-son-sea-park", "seg": "phan-rang-thap-cham", "city": "판랑-탑짬", "cat": "명소", "name": "빈선 해양공원", "local": "Công viên Biển Bình Sơn", "desc": "동하이 해안 산책로를 따라 길게 이어진 수변 공원으로, 소나무 숲과 야외 조형물, 깨끗한 모래사장이 어우러져 있다. 해 질 무렵 현지 주민들과 함께 바닷바람을 맞으며 산책하거나 일출을 감상하기 좋다.", "tags": ["해안산책로", "일출일몰", "도심해변", "자유산책"], "area": "동하이", "lat": 11.5649, "lng": 109.0231, "photo_query": "Công viên biển Bình Sơn Ninh Thuận", "photos": ["packs/spots-t2a-phanrang-1/6.jpg"], "photo_src": ["https://commons.wikimedia.org/wiki/File:C%C3%B4ng_vi%C3%AAn_bi%E1%BB%83n_B%C3%ACnh_S%C6%A1n,_Ninh_Thu%E1%BA%ADn.jpg"], "sources": ["https://ph.trip.com/travel-guide/attraction/dong-hai/bnh-sn-sea-park-150118191/", "https://en.wikivoyage.org/wiki/Phan_Rang%E2%80%93Th%C3%A1p_Ch%C3%A0m"], "fee": {"free": true}, "transport": {"how": "판랑 중심가에서 자전거 약 15분 또는 옌닌 해안도로 방면 FUTA 03번 시내버스 이용"}, "duration_min": 60, "hours": "상시 개방", "closed": "연중무휴"}, {"id": "phanrang-t2a-hoa-lai-cham-tower", "seg": "phan-rang-thap-cham", "city": "판랑-탑짬", "cat": "건축", "name": "호아라이 참탑", "local": "Tháp Hòa Lai", "desc": "8세기 후반~9세기 초에 건립된 현존 최고(最古)급 참파 벽돌 유적으로, 호아라이 양식의 원형을 간직하고 있다. 야외 개방형 유적지에서 정교한 붉은 벽돌 부조와 3기 탑터의 고즈넉한 분위기를 살펴볼 수 있다.", "tags": ["참파유적", "벽돌건축", "국가특급유적", "역사탐방"], "area": "투언박·박퐁", "lat": 11.6764, "lng": 109.0361, "photo_query": "Tháp Hòa Lai", "photos": ["packs/spots-t2a-phanrang-1/7.jpg"], "photo_src": ["https://commons.wikimedia.org/wiki/File:Th%C3%A1p_H%C3%B2a_Lai,_Ninh_Thu%E1%BA%ADn.JPG"], "sources": ["https://us.trip.com/travel-guide/attraction/thuan-bac/ha-lai-cham-temple-142919991/"], "fee": {"free": true}, "transport": {"how": "판랑 시내에서 국도 1A(QL1A) 북행 FUTA 02번 시내버스(투언박 방면) 탑승 후 바탑(Ba Tháp) 정류장 하차(약 25~30분)"}, "duration_min": 45, "hours": "상시 개방(주간 방문 권장)", "closed": "연중무휴"}, {"id": "phanrang-t2a-ba-moi-vineyard", "seg": "phan-rang-thap-cham", "city": "판랑-탑짬", "cat": "체험·축제", "name": "바모이 포도 농장", "local": "Vườn nho Ba Mọi", "desc": "판랑 서부에서 최초로 여행객에게 문을 연 생태 포도 농원으로, 그늘진 포도 덩굴 아래를 거닐며 재배 과정을 배울 수 있다. 농장주가 내어주는 신선한 생포도와 수제 포도 시럽·와인 시음 체험을 무료로 즐길 수 있다.", "tags": ["포도농장", "시음체험", "무료개방", "농촌체험"], "area": "프억투언·히엡호아", "lat": 11.5873, "lng": 108.9572, "photo_query": "Vườn nho Ba Mọi", "photos": ["packs/spots-t2a-phanrang-1/8.jpg", "packs/spots-t2a-phanrang-1/9.jpg", "packs/spots-t2a-phanrang-1/10.jpg", "packs/spots-t2a-phanrang-1/11.jpg"], "photo_src": ["https://baolamdong.vn/vuon-nho-ba-moi-tham-quan-mien-phi-xu-so-nho-khanh-hoa-406467.html", "https://vinpearl.com/vi/vuon-nho-ba-moi-ninh-thuan-khanh-hoa", "https://mia.vn/cam-nang-du-lich/kham-pha-vuon-nho-ba-moi-dep-nhu-co-tich-cua-xu-phan-rang-7470", "https://mia.vn/cam-nang-du-lich/kham-pha-vuon-nho-ba-moi-dep-nhu-co-tich-cua-xu-phan-rang-7470", "https://vinpearl.com/vi/vuon-nho-ba-moi-ninh-thuan-khanh-hoa", "https://halotravel.vn/vuon-nho-ba-moi/"], "sources": ["https://vietnamtourism.gov.vn/en/post/9131", "https://baonghean.vn/en/vuon-nho-ba-moi-di-bo-duoi-tan-nho-nem-ruou-thu-cong-10313325.html"], "fee": {"free": true, "text": "입장 및 시음 무료(포도·와인·시럽 구매 시 별도)"}, "transport": {"how": "판랑 중심가에서 서북쪽 프억투언 방면 자전거 약 15~20분(약 4km)"}, "duration_min": 60, "hours": "07:00-17:30", "closed": "연중무휴"}, {"id": "phanrang-t2a-tien-tien-farm-zoo", "seg": "phan-rang-thap-cham", "city": "판랑-탑짬", "cat": "체험·축제", "name": "티엔티엔 팜 앤 주", "local": "Tiên Tiến Farm & Zoo", "desc": "초식동물과 조류·소형 포유류 등 순한 동물들을 가까이서 만지고 먹이를 줄 수 있는 호주 주두(ZooDoo) 스타일의 교감형 동물원이다. 사육사 안내에 따라 팀별로 60~90분간 동물 생태 체험 투어를 진행한다.", "tags": ["가족여행", "동물교감", "먹이체험", "체험농장"], "area": "안하이·뚜언뚜", "lat": 11.5174, "lng": 108.9929, "photo_query": "Tiên Tiến Farm & Zoo Phan Rang", "photos": [], "photo_src": [], "sources": ["https://www.klook.com/activity/76094-zoodoo-phan-rang-ticket/", "https://vn.trip.com/travel-guide/attraction/phuoc-dinh/zoodoo-zoo-and-cafe-141286321/", "https://www.tientienfarmandzoo.com/"], "fee": {"amount": 130000, "currency": "VND", "text": "신장 120cm 이상 130,000 VND, 90~120cm 65,000 VND, 90cm 미만 무료(사육사 가이드 포함)"}, "transport": {"how": "판랑 시장에서 FUTA 04번 또는 06번 시내버스(안하이 방면) 탑승 후 뚜언뚜(Tuấn Tú) 마을 하차 또는 자전거 약 25분(약 6km)"}, "duration_min": 90, "hours": "09:00-16:00", "closed": "연중무휴"}, {"id": "phanrang-t2a-mui-dinh-lighthouse", "seg": "phan-rang-thap-cham", "city": "판랑-탑짬", "cat": "야경·전망", "name": "무이딘 등대", "local": "Hải đăng Mũi Dinh", "desc": "1904년 프랑스 식민 시기에 세워진 화강암 등대로, 모래 언덕 너머 해안 곶 정상에 자리 잡고 있다. 가파른 오르막길을 걸어 등대에 오르면 에메랄드빛 바이짱 해변과 사막 능선, 태평양이 360도로 펼쳐진다.", "tags": ["역사등대", "해안절경", "파노라마전망", "트레킹"], "area": "프억딘·무이딘", "lat": 11.3608, "lng": 109.0142, "photo_query": "Hai dang Mui Dinh lighthouse Ninh Thuan", "photos": ["packs/spots-t2a-phanrang-1/12.jpg", "packs/spots-t2a-phanrang-1/13.jpg", "packs/spots-t2a-phanrang-1/14.jpg"], "photo_src": ["https://www.flickr.com/photos/97930879@N02/9931597403", "https://www.flickr.com/photos/97930879@N02/9931477816", "https://www.flickr.com/photos/97930879@N02/9931501264"], "sources": ["https://www.trip.com/moments/detail/phuoc-dinh-1590142-140187833/", "https://vi.wikipedia.org/wiki/M%C5%A9i_Dinh"], "fee": {"free": true, "text": "등대 입장 무료(모래언덕 횡단 현지 오프로드 셔틀 이용 시 편도·왕복 요금 별도)"}, "transport": {"how": "판랑 시장에서 FUTA 06번 시내버스(선하이·무이딘 방면, 20~30분 간격) 탑승 후 무이딘 종점 부근 하차 뒤 사구·언덕길 도보 약 30~40분"}, "duration_min": 90, "hours": "05:00-17:30", "closed": "연중무휴"}, {"id": "phanrang-t2a-mui-dinh-sand-dunes", "seg": "phan-rang-thap-cham", "city": "판랑-탑짬", "cat": "자연", "name": "무이딘 모래언덕·바이짱 해변", "local": "Đồi cát Mũi Dinh & Bãi Tràng", "desc": "거대한 황금빛 해안 사막과 초승달 모양의 호젓한 바이짱 해변이 맞닿은 남부 대표 경승지이다. 지프·사륜바이크(ATV)를 타고 모래 능선을 넘거나 맨발 사구 트레킹 후 맑은 만에서 수영을 즐길 수 있다.", "tags": ["해안사막", "오프로드지프", "숨은해변", "일출일몰"], "area": "프억딘·무이딘", "lat": 11.3557, "lng": 109.0063, "photo_query": "Mui Dinh sand dunes Bai Trang beach Ninh Thuan", "photos": [], "photo_src": [], "sources": ["https://www.klook.com/activity/162589-phan-rang-private-day-tour-sheep-farm-mui-dinh-sand-dunes-po-klong-garai-temple-nha-trang/", "https://www.trip.com/moments/detail/phuoc-dinh-1590142-156082908/"], "fee": {"free": true, "text": "해변·사구 입장 무료(현지 지프·사륜바이크 왕복 대여 약 300,000~600,000 VND 별도)"}, "transport": {"how": "판랑 시장에서 FUTA 06번 시내버스(프억딘·무이딘 방면) 하차 후 도보 트레킹 또는 현지 모래언덕 셔틀로 해변 진입"}, "duration_min": 120, "hours": "상시 개방(지프·ATV 주간 운영)", "closed": "연중무휴"}, {"id": "phanrang-t2a-my-hoa-lagoon", "seg": "phan-rang-thap-cham", "city": "판랑-탑짬", "cat": "체험·축제", "name": "미호아 카이트서핑 석호", "local": "Đầm Mỹ Hòa", "desc": "외곽 산호초가 파도를 막아 수면이 잔잔하고 11~3월 북동풍이 강하게 불어 동남아 최고 수준의 카이트서핑 성지로 꼽히는 석호다. 현지 서핑 센터에서 강습과 장비 대여를 받거나 수백 개의 연이 뜬 해변을 구경할 수 있다.", "tags": ["카이트서핑", "겨울강풍", "라군해변", "액티비티"], "area": "빈하이·미호아", "lat": 11.6063, "lng": 109.1463, "photo_query": "My Hoa kitesurfing", "photos": [], "photo_src": [], "sources": ["https://vietnam.travel/things-to-do/kitesurfing-phan-rang-rising-destination-adventure-seekers", "https://en.wikivoyage.org/wiki/Phan_Rang%E2%80%93Th%C3%A1p_Ch%C3%A0m"], "fee": {"free": true, "text": "해변 관람 무료(카이트서핑 강습·장비 대여 별도)"}, "transport": {"how": "판랑 시장에서 FUTA 03번 시내버스(빈히 방면) 탑승 후 미호아(Mỹ Hòa) 해변 입구 하차(약 35분)"}, "duration_min": 120, "hours": "상시 개방(카이트서핑 시즌 11~3월)", "closed": "연중무휴(강풍·조수 시간 확인)"}, {"id": "phanrang-t2a-ninh-thuan-stone-park", "seg": "phan-rang-thap-cham", "city": "판랑-탑짬", "cat": "기묘·숨은곳", "name": "닌투언 돌공원", "local": "Công viên Đá Ninh Thuận", "desc": "해풍과 파도에 수만 년간 깎여 나간 기괴한 화강암 바위와 자연 아치가 바다 절벽 위에 군집해 있는 지질 명소다. 숲길을 지나 탁 트인 암반 지대에 서면 푸른 동해와 깎아지른 기암괴석이 한눈에 들어온다.", "tags": ["기암괴석", "해안절벽", "트레킹", "지질명소"], "area": "빈하이·타이안", "lat": 11.6325, "lng": 109.1603, "photo_query": "Công viên Đá Ninh Thuận", "photos": [], "photo_src": [], "sources": ["https://www.trip.com/travel-guide/attraction/vinh-hai/ninh-thuan-stone-park-140150074/", "https://us.trip.com/moments/poi-cng-vin-ninh-thun-144637910/"], "fee": {"amount": 40000, "currency": "VND"}, "transport": {"how": "판랑 시장에서 FUTA 03번 시내버스(빈히 방면) 탑승 후 타이안 구간 하차, 해안 숲길 약 2~3km 도보 진입"}, "duration_min": 90, "hours": "상시 개방(주간 방문 권장)", "closed": "연중무휴"}, {"id": "phanrang-t2a-binh-tien-beach", "seg": "phan-rang-thap-cham", "city": "판랑-탑짬", "cat": "자연", "name": "빈띠엔 해변", "local": "Bãi biển Bình Tiên", "desc": "누이쭈아 산맥의 울창한 숲과 화강암 능선이 삼면을 감싸 안은 청정 반달형 만으로, 물결이 잔잔하고 투명도가 매우 높다. 상업화가 덜 돼 한적하게 해수욕이나 해변 피크닉을 즐기기에 적합하다.", "tags": ["청정해변", "해수욕", "해안드라이브", "숨은비치"], "area": "콩하이·빈띠엔", "lat": 11.8087, "lng": 109.186, "photo_query": "Bãi biển Bình Tiên", "photos": ["packs/spots-t2a-phanrang-1/15.jpg"], "photo_src": ["https://commons.wikimedia.org/wiki/File:B%C3%A3i_bi%E1%BB%83n_B%C3%ACnh_Ti%C3%AAn,_C%C3%B4ng_H%E1%BA%A3i,_Ninh_H%E1%BA%A3i.jpg"], "sources": ["https://www.trip.com/moments/thuan-bac-district-1540743/", "https://www.expedia.com/Binh-Tien-Beach-Khanh-Hoa-Province.d6222122.Vacation-Attraction", "https://www.vietnamtourism.org.vn/attractions/binh-tien-the-most-wonderful-beach-in-central.html"], "fee": {"free": true}, "transport": {"how": "판랑 시내에서 FUTA 02번(콩하이 방면) 또는 판랑–깜란 시외버스 탑승 후 빈띠엔 삼거리 하차 뒤 해안도로(ĐT702) 따라 도보·자전거 이동"}, "duration_min": 120, "hours": "상시 개방", "closed": "연중무휴"}, {"id": "phanrang-t2a-hon-do", "seg": "phan-rang-thap-cham", "city": "판랑-탑짬", "cat": "기묘·숨은곳", "name": "혼도", "local": "Hòn Đỏ Ninh Thuận", "desc": "솔숲 너머 해안에 거대한 고대 산호 화석 덩어리가 붉은 곶을 이루고 있는 야생 해안 지대다. 겨울철(12~3월) 간조 때 바위 위로 초록빛 해조류가 융단처럼 덮여 일출 명소이자 로컬 숨은 출사지로 인기다.", "tags": ["산호화석", "이끼바위", "숨은일출명소", "솔숲해안"], "area": "닌하이·탄하이", "lat": 11.5646, "lng": 109.129, "photo_query": "Hòn Đỏ Ninh Thuận", "photos": [], "photo_src": [], "sources": ["https://vietnamtourism.gov.vn/post/47546"], "fee": {"free": true}, "transport": {"how": "판랑 시장에서 FUTA 03번 시내버스(빈히 방면) 탑승 후 탄하이(Thanh Hải) 미히엡 마을 하차, 해안 솔숲길 도보 약 15분"}, "duration_min": 60, "hours": "상시 개방(일출·간조 추천)", "closed": "연중무휴"}, {"id": "phanrang-t2a-phuoc-binh-national-park", "seg": "phan-rang-thap-cham", "city": "판랑-탑짬", "cat": "근교", "name": "프억빈 국립공원", "local": "Vườn quốc gia Phước Bình", "desc": "해발 고지대 원시림과 다뇽·자뇽 계곡 폭포가 펼쳐진 생태 보호구역으로, 희귀 야생동물인 가우르(들소) 서식지이자 라글라이 소수민족 마을이 자리한다. 관리사무소 안내를 받아 숲 트레킹과 계곡 생태 체험을 할 수 있다.", "tags": ["국립공원", "고산트레킹", "라글라이족", "계곡폭포"], "area": "박아이·프억빈", "lat": 12.0702, "lng": 108.7556, "photo_query": "Vườn quốc gia Phước Bình", "photos": ["packs/spots-t2a-phanrang-1/16.jpg"], "photo_src": ["https://commons.wikimedia.org/wiki/File:Phuoc_Binh_from_National_Parks_office.jpg"], "sources": ["https://vietnamtourism.gov.vn/post/14871"], "fee": {"amount": 40000, "currency": "VND", "text": "약 20,000~40,000 VND (입장료 기준, 국립공원 가이드·장기 트레킹 투어 별도)"}, "transport": {"how": "직통 시내버스 없음. 판랑에서 FUTA 01번(닌선·떤선 방면) 또는 박아이 방면 시외버스 이용 후 국도 27B 따라 현지 셔틀·자전거 등으로 이동(사전 방문 허가 권장)"}, "duration_min": 240, "hours": "07:30-17:00", "closed": "연중무휴(사전 트레킹 허가 필요)"}]